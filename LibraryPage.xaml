<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Komik.LibraryPage"
    x:Name="LibraryRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Komik.Models"
    xmlns:vm="using:Komik.ViewModels"
    xmlns:helpers="using:Komik.Helpers"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="ComicCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style x:Key="FormatBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#CC1F1F1F" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style x:Key="WarningBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#D9A80000" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <MenuFlyout x:Key="ComicContextMenu" Opening="ComicContextMenu_Opening">
            <MenuFlyoutItem Text="Read Comic" Click="ContextRead_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Comic Details..." Click="ContextDetails_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Toggle Favorite" Click="ContextFavorite_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEB52;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Mark as Completed / Unread" Click="ContextToggleCompleted_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Restart Reading" Click="ContextRestart_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE777;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Manage Tags..." Click="ContextAddTag_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ContextConvertToCbzItem" Text="Convert to CBZ..." Click="ContextConvertToCbz_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEB9F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Show in File Explorer" Click="ContextExplorer_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xED25;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Remove from Library" Click="ContextRemove_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="RootLayout" Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. NOTIFICATION INFOBAR ==================== -->
        <InfoBar
            Grid.Row="0"
            x:Name="LibraryNotificationInfoBar"
            IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
            IsClosable="True"
            Margin="0,0,0,12" />

        <!-- ==================== 1. TOP HEADER & TOOLBAR ==================== -->
        <!-- Standard Comics Toolbar -->
        <ScrollViewer
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsSeriesView, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollMode="Disabled"
            Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Library Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image
                        Source="ms-appx:///Assets/Square44x44Logo.png"
                        Width="26"
                        Height="26"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0" />
                    <TextBlock
                        Text="Library"
                        FontSize="24"
                        FontWeight="Bold"
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0" />

                    <Button
                        Command="{x:Bind ViewModel.AddFolderCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="34"
                        Padding="10,0"
                        ToolTipService.ToolTip="Add a root folder from disk to scan and watch">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                            <TextBlock Text="Add Folder" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.AddComicFileCommand}"
                        Height="34"
                        Padding="10,0"
                        ToolTipService.ToolTip="Add a single comic file (.cbz, .cbr, .cb7, .zip, .rar, .7z, .pdf)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                            <TextBlock Text="Add Comic..." FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.RescanLibraryCommand}"
                        Height="34"
                        Padding="8,0"
                        IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                        ToolTipService.ToolTip="Rescan all watched folders for new and missing comics">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Rescan" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <DropDownButton
                        Height="34"
                        Padding="8,0"
                        IsEnabled="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                        ToolTipService.ToolTip="Convert comic files (CBR, CB7, PDF, etc.) or image folders to standard CBZ archives">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xEB9F;" FontSize="12" />
                            <TextBlock Text="Convert..." FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Convert Comic File (CBR, CB7, PDF)..." Click="ConvertStandaloneFile_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Convert Image Folder..." Click="ConvertStandaloneFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Reading Stats Button -->
                    <Button
                        Command="{x:Bind ViewModel.OpenReadingStatsCommand}"
                        Height="34"
                        Padding="8,0"
                        ToolTipService.ToolTip="Reading Statistics, streaks, and Komik Wrapped">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE9D2;" FontSize="12" />
                            <TextBlock Text="Stats" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Duplicates Button with Info Flyout -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.OpenDuplicateManagerCommand}"
                            Height="34"
                            Padding="8,0"
                            ToolTipService.ToolTip="Review and manage duplicate comics">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#F59E0B" />
                                <TextBlock Text="Duplicates" FontSize="12" />
                                <Border
                                    Visibility="{x:Bind ViewModel.HasDuplicates, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    Background="#F59E0B"
                                    CornerRadius="8"
                                    Padding="5,0"
                                    Margin="2,0,0,0">
                                    <TextBlock Text="{x:Bind ViewModel.DuplicateCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Duplicate Detection Info">
                            <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="270" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#F59E0B" />
                                            <TextBlock Text="Duplicate Comics Manager" FontWeight="Bold" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Text="Identifies identical or multi-format copies (e.g. CBZ vs PDF vs CBR) and 95%+ title matches. Easily remove duplicate copies from disk or Keep All to retain both." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Standalone Series & Volumes Button with Info Flyout -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.OpenSeriesViewCommand}"
                            Height="34"
                            Padding="8,0"
                            ToolTipService.ToolTip="Browse and manage comic runs, manga volumes, and custom series">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8B9;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Series &amp; Volumes" FontSize="12" />
                                <Border
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="5,0"
                                    Margin="2,0,0,0">
                                    <TextBlock Text="{x:Bind ViewModel.SeriesGroups.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Series &amp; Volumes Info">
                            <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="270" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="Series &amp; Volume Grouping" FontWeight="Bold" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Text="Discovers and clusters comic runs, multi-issue runs, and manga volumes when titles match 90% or more. You can also create and manage custom series. Click any series card to view issues in order and read next." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Search, Sort & View Mode Toggles -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="170"
                        QueryIcon="Find"
                        PlaceholderText="Search comics..."
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

                    <!-- Sort ComboBox with Info Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <ComboBox
                            Width="140"
                            ItemsSource="{x:Bind ViewModel.SortOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                            DisplayMemberPath="DisplayName"
                            ToolTipService.ToolTip="Sort comics" />
                        <Button
                            Style="{StaticResource InfoButtonStyle}"
                            ToolTipService.ToolTip="Sort collection details">
                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="260" Spacing="6">
                                        <TextBlock Text="Library Sorting" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="Sort your collection by title using natural numeric order (e.g. #2 before #10), date added, recently read, page count, or file size." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- View Layout Switcher (Grid vs List) -->
                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="6"
                        Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button
                                x:Name="GridModeButton"
                                Height="30"
                                Width="32"
                                Padding="0"
                                Click="GridMode_Click"
                                ToolTipService.ToolTip="Cover Cards Grid View">
                                <FontIcon Glyph="&#xE80A;" FontSize="12" />
                            </Button>
                            <Button
                                x:Name="ListModeButton"
                                Height="30"
                                Width="32"
                                Padding="0"
                                Click="ListMode_Click"
                                ToolTipService.ToolTip="Detailed List View (with page counts, file sizes, and formats)">
                                <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Settings Button -->
                    <Button
                        Click="SettingsButton_Click"
                        Height="34"
                        Width="34"
                        Padding="0"
                        CornerRadius="17"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Dedicated Series & Volumes Standalone Toolbar -->
        <Grid
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsSeriesView, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Back to Comics, Title, Badge, New Series, Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Command="{x:Bind ViewModel.CloseSeriesViewCommand}"
                    Height="34"
                    Padding="10,0"
                    ToolTipService.ToolTip="Return to comics library">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="Back to Comics" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" />

                <FontIcon Glyph="&#xE8B9;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Series &amp; Volumes" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" Margin="2,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SeriesGroupsCountDisplay, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="White" />
                </Border>

                <Button
                    Command="{x:Bind ViewModel.OpenCreateSeriesDialogCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Height="34"
                    Padding="10,0"
                    ToolTipService.ToolTip="Create a new manual series or reading order from your library comics">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="New Series" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Series &amp; Volumes Info">
                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="270" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="Series &amp; Volume Grouping" FontWeight="Bold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="Discovers and clusters comic runs, multi-issue runs, and manga volumes when titles match 90% or more. You can also create your own custom manual series. Click any series card to view issues in order and read next." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Right: Series Search, Series Sort, Settings -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <AutoSuggestBox
                    Width="180"
                    QueryIcon="Find"
                    PlaceholderText="Search series..."
                    Text="{x:Bind ViewModel.SeriesSearchText, Mode=TwoWay}" />

                <ComboBox
                    Width="140"
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    ToolTipService.ToolTip="Sort series" />

                <Button
                    Click="SettingsButton_Click"
                    Height="34"
                    Width="34"
                    Padding="0"
                    CornerRadius="17"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 2. FILTER PILLS & CHIPS (COMICS ONLY) ==================== -->
        <ScrollViewer
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.IsSeriesView, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Disabled"
            Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- All Comics Chip -->
                <Button
                    Click="FilterAll_Click"
                    CornerRadius="16"
                    Padding="14,6"
                    Background="{x:Bind FilterAllBackground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="All Comics" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.TotalComicCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- Continue Reading Chip -->
                <Button
                    Click="FilterContinueReading_Click"
                    CornerRadius="16"
                    Padding="14,6"
                    Background="{x:Bind FilterContinueReadingBackground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Continue Reading" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.InProgressCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- Favorites Chip -->
                <Button
                    Click="FilterFavorites_Click"
                    CornerRadius="16"
                    Padding="14,6"
                    Background="{x:Bind FilterFavoritesBackground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB52;" FontSize="11" Foreground="#FF4560" />
                        <TextBlock Text="Favorites" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- Completed Chip -->
                <Button
                    Click="FilterCompleted_Click"
                    CornerRadius="16"
                    Padding="14,6"
                    Background="{x:Bind FilterCompletedBackground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#4CAF50" />
                        <TextBlock Text="Completed" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- Unread Chip -->
                <Button
                    Click="FilterUnread_Click"
                    CornerRadius="16"
                    Padding="14,6"
                    Background="{x:Bind FilterUnreadBackground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE734;" FontSize="11" />
                        <TextBlock Text="Unread" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.UnreadCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />

                <!-- Tags Dropdown / List -->
                <DropDownButton
                    Content="Tags"
                    CornerRadius="16"
                    Padding="12,6"
                    FontSize="12">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="TagsFlyout" Placement="Bottom">
                            <MenuFlyoutItem Text="All Tags" Click="ClearTagFilter_Click" />
                            <MenuFlyoutSeparator />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Manage Tags Button with Info Icon -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        CornerRadius="16"
                        Padding="10,6"
                        FontSize="12"
                        Click="ManageTags_Click"
                        ToolTipService.ToolTip="Create and manage your tags">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EC;" FontSize="11" />
                            <TextBlock Text="Manage Tags" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource InfoButtonStyle}"
                        ToolTipService.ToolTip="Tags allow you to organize comics with custom labels (e.g. Manga, Marvel, DC, Favorites) across different folders. Right-click any comic to manage its tags.">
                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </StackPanel>

                <!-- Active Filter Indicator Badge if filtered -->
                <Border
                    x:Name="ActiveFilterBadge"
                    Visibility="Collapsed"
                    CornerRadius="12"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ActiveFilterText" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                        <Button
                            Click="ClearActiveFilter_Click"
                            Padding="2"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 3. PROGRESS INDICATORS ==================== -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,12">
            <!-- Scan Progress Strip -->
            <Border
                x:Name="ScanProgressStrip"
                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="{x:Bind ViewModel.ScanStatusMessage, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Conversion Progress Strip -->
            <Border
                x:Name="ConversionProgressStrip"
                Visibility="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="{x:Bind ViewModel.ConversionStatusMessage, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ProgressBar
                        Grid.Column="1"
                        Width="150"
                        Value="{x:Bind ViewModel.ConversionProgressPercentage, Mode=OneWay}"
                        Maximum="100"
                        IsIndeterminate="{x:Bind ViewModel.IsConversionIndeterminate, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Margin="14,0" />

                    <Button
                        Grid.Column="2"
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelConversionCommand}"
                        Height="28"
                        Padding="10,0" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ==================== 4. MAIN CONTENT AREA ==================== -->
        <!-- EMPTY STATE (when library has 0 comics total) -->
        <Grid
            Grid.Row="4"
            x:Name="EmptyLibraryContainer"
            Canvas.ZIndex="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowEmptyLibrary, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Border
                Width="520"
                Padding="36,40"
                CornerRadius="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="22" HorizontalAlignment="Center">
                    <Image
                        Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center" />

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock
                            Text="Your Library is Empty"
                            FontSize="26"
                            FontWeight="Bold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Add folders containing your comics (.cbz, .cbr, .cb7, .zip, .rar, .7z, .pdf, or image directories) to automatically index and organize them."
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.AddFolderCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="42"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F4;" FontSize="15" />
                                <TextBlock Text="Add Folder..." FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{x:Bind ViewModel.AddComicFileCommand}"
                            Height="42"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="15" />
                                <TextBlock Text="Add Comic File..." FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- EMPTY FILTER / SEARCH RESULTS (when filter or search returns 0 matching comics) -->
        <Grid
            Grid.Row="4"
            x:Name="EmptyFilterContainer"
            Canvas.ZIndex="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowEmptyFilter, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Border
                Width="480"
                Padding="36,36"
                CornerRadius="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="18" HorizontalAlignment="Center">
                    <Border
                        Width="72"
                        Height="72"
                        CornerRadius="36"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                        <FontIcon Glyph="{x:Bind ViewModel.EmptyFilterGlyph, Mode=OneWay}" FontSize="30" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyFilterTitle, Mode=OneWay}"
                            FontSize="22"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyFilterSubtitle, Mode=OneWay}"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            MaxWidth="400" />
                    </StackPanel>

                    <Button
                        Click="ShowAllComics_Click"
                        Height="38"
                        Padding="20,0"
                        HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71C;" FontSize="13" />
                            <TextBlock Text="Show All Comics" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SERIES GRID VIEW -->
        <GridView
            Grid.Row="4"
            x:Name="SeriesGridView"
            ItemsSource="{x:Bind ViewModel.SeriesGroups, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemClick="SeriesCard_Click"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowSeriesGrid, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Padding="0,0,0,24">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ComicSeriesGroup">
                    <Border
                        Style="{StaticResource ComicCardStyle}"
                        Width="220"
                        Height="320"
                        Margin="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Series Cover -->
                            <Grid Grid.Row="0" CornerRadius="6">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image
                                    Source="{x:Bind CoverThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                    Stretch="UniformToFill"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                                <!-- Issue Count Pill (Top Left) -->
                                <Border
                                    Style="{StaticResource FormatBadgeStyle}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="6">
                                    <TextBlock Text="{x:Bind IssueCountDisplay}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>

                                <!-- Formats Pill (Top Right) -->
                                <Border
                                    Style="{StaticResource FormatBadgeStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="6">
                                    <TextBlock Text="{x:Bind FormatsDisplay}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>

                                <!-- Overall Progress Bar (Bottom) -->
                                <ProgressBar
                                    Value="{x:Bind OverallProgress, Mode=OneWay}"
                                    Maximum="1"
                                    Height="4"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>

                            <!-- Series Info & Quick Read Next -->
                            <Grid Grid.Row="1" Margin="2,8,2,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind SeriesName}"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind SeriesName}" />
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock
                                            Text="{x:Bind IssueCountDisplay}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ProgressPercentDisplay, Mode=OneWay}"
                                            FontSize="11"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Button
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    Height="28"
                                    Padding="0"
                                    Margin="0,4,0,0"
                                    Click="PlaySeriesNext_Click"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Read next unread issue">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                                        <TextBlock Text="Read Next" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- COMICS GRID VIEW -->
        <GridView
            Grid.Row="4"
            x:Name="ComicsGridView"
            ItemsSource="{x:Bind ViewModel.Comics, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemClick="ComicGrid_ItemClick"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowComicsGrid, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Padding="0,0,0,24">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ComicEntity">
                    <Border
                        Style="{StaticResource ComicCardStyle}"
                        Width="180"
                        Height="290"
                        Margin="6"
                        ContextFlyout="{StaticResource ComicContextMenu}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="210" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Cover Image Container -->
                            <Grid Grid.Row="0" CornerRadius="6">
                                <!-- Placeholder Background -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                                    <FontIcon Glyph="&#xE82D;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Real Thumbnail Image -->
                                <Image
                                    Source="{x:Bind ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                    Stretch="UniformToFill"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                                <!-- Format Badge (Top Left) -->
                                <Border
                                    Style="{StaticResource FormatBadgeStyle}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="6">
                                    <TextBlock Text="{x:Bind FormatBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>

                                <!-- Favorite Button (Top Right) -->
                                <Button
                                    Click="FavoriteButton_Click"
                                    Tag="{x:Bind}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="4"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="15"
                                    Background="#B3000000"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="{x:Bind FavoriteToolTip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="13" Foreground="#FF4560" />
                                </Button>

                                <!-- Info / Details Button (Top Right, below Favorite) -->
                                <Button
                                    Click="InfoButton_Click"
                                    Tag="{x:Bind}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,38,4,0"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="15"
                                    Background="#B3000000"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Comic Details"
                                    helpers:InstantToolTipHelper.IsInstant="True">
                                    <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="White" />
                                </Button>

                                <!-- Missing / Offline Warning Badge (Bottom Left) -->
                                <Border
                                    Style="{StaticResource WarningBadgeStyle}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="6"
                                    Visibility="{x:Bind IsMissing, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    ToolTipService.ToolTip="File not found at original location">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="White" />
                                        <TextBlock Text="Offline" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Border>

                                <!-- Completed Badge (Bottom Right) -->
                                <Border
                                    CornerRadius="4"
                                    Background="#D9107C41"
                                    Padding="6,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="6"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    ToolTipService.ToolTip="Completed">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White" />
                                        <TextBlock Text="Done" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Border>

                                <!-- Subtle Progress Bar (Bottom) -->
                                <ProgressBar
                                    Value="{x:Bind ProgressBarValue, Mode=OneWay}"
                                    Maximum="100"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>

                            <!-- Comic Information (Title & Subtitle) -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,6,2,0">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{x:Bind Title}" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock
                                        Text="{x:Bind PageCountFormatted}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Left" />
                                    <TextBlock
                                        Text="{x:Bind ProgressPillText, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- COMICS LIST VIEW -->
        <ListView
            Grid.Row="4"
            x:Name="ComicsListView"
            ItemsSource="{x:Bind ViewModel.Comics, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemClick="ComicList_ItemClick"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowComicsList, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Padding="0,0,0,24">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ComicEntity">
                    <Grid
                        Padding="8,6"
                        CornerRadius="6"
                        ContextFlyout="{StaticResource ComicContextMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" CornerRadius="4" Width="40" Height="56" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image Source="{x:Bind ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                        </Border>

                        <!-- Title & Folder -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                                <Border
                                    Visibility="{x:Bind IsMissing, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    Style="{StaticResource WarningBadgeStyle}">
                                    <TextBlock Text="Offline" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ParentFolder}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Format -->
                        <Border Grid.Column="2" Style="{StaticResource FormatBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>

                        <!-- Page Count -->
                        <TextBlock Grid.Column="3" Text="{x:Bind PageCountFormatted}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                        <!-- Reading Progress -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="3" Margin="4,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#107C41"
                                          Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ProgressBar
                                Value="{x:Bind ProgressBarValue, Mode=OneWay}"
                                Maximum="100"
                                Height="3"
                                Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </StackPanel>

                        <!-- File Size -->
                        <TextBlock Grid.Column="5" Text="{x:Bind FileSizeFormatted}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                        <!-- Date Added -->
                        <TextBlock Grid.Column="6" Text="{x:Bind DateAddedFormatted}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                        <!-- Actions (Favorite & Details) -->
                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button
                                Click="FavoriteButton_Click"
                                Tag="{x:Bind}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Toggle Favorite">
                                <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="14" Foreground="#FF4560" />
                            </Button>
                            <Button
                                Click="InfoButton_Click"
                                Tag="{x:Bind}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Comic Details"
                                helpers:InstantToolTipHelper.IsInstant="True">
                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ==================== SERIES DETAIL OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="100"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsSeriesDetailOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Border
                MaxWidth="900"
                MaxHeight="700"
                Margin="32"
                Padding="24"
                CornerRadius="16"
                Background="{ThemeResource ModalCardBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1.5">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button
                                Command="{x:Bind ViewModel.CloseSeriesDetailCommand}"
                                Height="34" Width="34" Padding="0" CornerRadius="17"
                                ToolTipService.ToolTip="Back to Series">
                                <FontIcon Glyph="&#xE72B;" FontSize="13" />
                            </Button>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.SeriesName, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                    <Border
                                        Visibility="{x:Bind ViewModel.SelectedSeriesGroup.IsManual, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                        Background="#33F59E0B"
                                        CornerRadius="4"
                                        Padding="6,2">
                                        <TextBlock Text="Manual Series" FontSize="10" Foreground="#F59E0B" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.IssueCountDisplay, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button
                                Command="{x:Bind ViewModel.OpenAddComicsToExistingSeriesCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Add comics from library to this series">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add Comics" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button
                                Visibility="{x:Bind ViewModel.SelectedSeriesGroup.IsManual, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                Command="{x:Bind ViewModel.DeleteManualSeriesCommand}"
                                CommandParameter="{x:Bind ViewModel.SelectedSeriesGroup, Mode=OneWay}"
                                Background="#33FF4560"
                                BorderBrush="#FF4560"
                                ToolTipService.ToolTip="Delete this custom manual series">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF4560" />
                                    <TextBlock Text="Delete Series" FontSize="12" Foreground="#FF4560" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button
                                Height="34" Width="34" Padding="0" CornerRadius="17"
                                Command="{x:Bind ViewModel.CloseSeriesDetailCommand}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <GridView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.SelectedSeriesGroup.Issues, Mode=OneWay}"
                        IsItemClickEnabled="True"
                        ItemClick="SeriesIssue_Click"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:ComicEntity">
                                <Border Style="{StaticResource ComicCardStyle}" Width="160" Height="260" Margin="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="180" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" CornerRadius="6">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                                                <FontIcon Glyph="&#xE82D;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{x:Bind ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            <Border Style="{StaticResource FormatBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
                                                <TextBlock Text="{x:Bind FormatBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <Button
                                                Visibility="{Binding Path=ViewModel.SelectedSeriesGroup.IsManual, ElementName=LibraryRoot, Converter={StaticResource BoolToVisConverter}}"
                                                Click="RemoveComicFromSeries_Click"
                                                Tag="{x:Bind}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                CornerRadius="13"
                                                Background="#CC000000"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="Remove from this manual series">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#FF4560" />
                                            </Button>
                                            <ProgressBar Value="{x:Bind ProgressBarValue, Mode=OneWay}" Maximum="100" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,4,2,0">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind PageCountFormatted}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== DUPLICATE COMIC MANAGER OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="110"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsDuplicateManagerOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Border
                MaxWidth="960"
                MaxHeight="720"
                Margin="32"
                Padding="24"
                CornerRadius="16"
                Background="{ThemeResource ModalCardBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1.5">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#F59E0B" />
                                <TextBlock Text="Duplicate Comics Manager" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="Comics flagged as duplicates across same or different formats (e.g. CBZ vs PDF). Remove extra copies from disk or remove the flag to keep both." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button
                                Command="{x:Bind ViewModel.ScanDuplicatesCommand}"
                                IsEnabled="{x:Bind ViewModel.IsScanningDuplicates, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                                ToolTipService.ToolTip="Rescan entire library for duplicates">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Rescan" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button
                                Height="34" Width="34" Padding="0" CornerRadius="17"
                                Command="{x:Bind ViewModel.CloseDuplicateManagerCommand}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Empty duplicates state -->
                            <Border
                                Visibility="{x:Bind ViewModel.HasDuplicates, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}"
                                Padding="40"
                                HorizontalAlignment="Center">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="42" Foreground="#107C41" HorizontalAlignment="Center" />
                                    <TextBlock Text="No Duplicates Found" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Your comic library is clean! No cross-format or duplicate comics detected." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Duplicate Groups List -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DuplicateComicGroup">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            Margin="0,0,0,14">
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Group Header -->
                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind GroupTitle}" FontSize="14" FontWeight="Bold" />
                                                        <Border Background="#33F59E0B" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{x:Bind MatchReason}" FontSize="10" Foreground="#F59E0B" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Button
                                                        HorizontalAlignment="Right"
                                                        Click="DismissDuplicate_Click"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Keep all copies in library and remove duplicate flag">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="11" />
                                                            <TextBlock Text="Keep All" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- Copies List -->
                                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Copies}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ComicEntity">
                                                            <Grid Padding="10,8" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" CornerRadius="4" Width="36" Height="48" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                                    <Image Source="{x:Bind ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Border>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind FilePath}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,14,0">
                                                                    <Border Style="{StaticResource FormatBadgeStyle}">
                                                                        <TextBlock Text="{x:Bind FormatBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                                    </Border>
                                                                    <TextBlock Text="{x:Bind PageCountFormatted}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    <TextBlock Text="{x:Bind FileSizeFormatted}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>

                                                                <Button
                                                                    Grid.Column="3"
                                                                    Click="DeleteDuplicate_Click"
                                                                    Tag="{x:Bind}"
                                                                    Background="#33FF4560"
                                                                    BorderBrush="#FF4560"
                                                                    ToolTipService.ToolTip="Delete this copy from disk and library">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#FF4560" />
                                                                        <TextBlock Text="Delete Copy" FontSize="11" Foreground="#FF4560" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== READING STATISTICS & KOMIK WRAPPED OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="120"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsStatsDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Border
                MaxWidth="900"
                MaxHeight="700"
                Margin="32"
                Padding="26"
                CornerRadius="18"
                Background="{ThemeResource ModalCardBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1.5">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Reading Insights &amp; Statistics" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="Your reading habits, daily streaks, time immersed, and top comics." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Height="34" Width="34" Padding="0" CornerRadius="17"
                            Command="{x:Bind ViewModel.CloseReadingStatsCommand}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- 4 KPI Stat Tiles -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Time Spent -->
                                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsSummary.FormattedTotalTime, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                                        <TextBlock Text="Total Time Read" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Pages Read -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xE82D;" FontSize="16" Foreground="#3B82F6" HorizontalAlignment="Left" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsSummary.TotalPagesRead, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                                        <TextBlock Text="Pages Read" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Daily Streak -->
                                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xEB52;" FontSize="16" Foreground="#FF4560" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.CurrentDailyStreak, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                            <TextBlock Text="days" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="Current Streak" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Comics Finished -->
                                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#107C41" HorizontalAlignment="Left" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsSummary.ComicsCompleted, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                                        <TextBlock Text="Comics Finished" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- KOMIK WRAPPED YEARLY HERO CARD -->
                            <Border
                                CornerRadius="14"
                                Padding="20"
                                Background="{ThemeResource WrappedCardBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1.5">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="#6366F1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="KOMIK WRAPPED" FontSize="9" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="Reading Highlights" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource WrappedCardTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.StatsSummary.TopSeriesName, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#EAB308" />
                                        <TextBlock Text="Your most read title in Komik." FontSize="12" Foreground="{ThemeResource WrappedCardSubtextBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource WrappedPillBrush}" CornerRadius="8" Padding="12,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource WrappedCardTextBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.StatsSummary.TotalSessionsCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource WrappedCardTextBrush}" />
                                                <TextBlock Text="sessions" FontSize="11" Foreground="{ThemeResource WrappedCardSubtextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{ThemeResource WrappedPillBrush}" CornerRadius="8" Padding="12,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xEB52;" FontSize="11" Foreground="#FF4560" />
                                                <TextBlock Text="Best Streak:" FontSize="11" Foreground="{ThemeResource WrappedCardSubtextBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.StatsSummary.LongestDailyStreak, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource WrappedCardTextBrush}" />
                                                <TextBlock Text="days" FontSize="11" Foreground="{ThemeResource WrappedCardSubtextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- TOP SERIES & COMICS LIST (TOP 20) -->
                            <Grid Margin="14,10,14,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Top Comics &amp; Series (Top 20)" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="READ PROGRESS" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="2" Text="TIME SPENT" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <ListView ItemsSource="{x:Bind ViewModel.StatsSummary.TopSeries, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SeriesReadingStat">
                                        <Grid Padding="14,10" Margin="0,3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind SeriesName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FormattedIssues}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedPagesRead}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedDuration}" FontSize="11" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== CREATE MANUAL SERIES OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="130"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsCreateSeriesDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Border
                MaxWidth="860"
                MaxHeight="680"
                Margin="32"
                Padding="24"
                CornerRadius="16"
                Background="{ThemeResource ModalCardBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1.5">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B9;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Create New Series" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="Group any comics into a custom series or reading order from your library." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Height="34" Width="34" Padding="0" CornerRadius="17"
                            Command="{x:Bind ViewModel.CloseCreateSeriesDialogCommand}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Series Name & Search / Selection Controls -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="Enter series name (e.g. Batman: Long Halloween)..."
                            Text="{x:Bind ViewModel.NewSeriesName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <AutoSuggestBox
                            Grid.Column="1"
                            QueryIcon="Find"
                            PlaceholderText="Filter comics..."
                            Text="{x:Bind ViewModel.ManualSeriesSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- Comics Selection Grid with Thumbnails -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Selection Summary & Quick Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SelectedCandidateCount, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />
                                <TextBlock Text="comics selected" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button
                                    Content="Select All"
                                    FontSize="11"
                                    Padding="10,4"
                                    Command="{x:Bind ViewModel.SelectAllCandidatesCommand}" />
                                <Button
                                    Content="Clear Selection"
                                    FontSize="11"
                                    Padding="10,4"
                                    Command="{x:Bind ViewModel.ClearCandidateSelectionCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Candidates Scroll / ItemsControl -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ManualSeriesCandidates, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="148" ItemHeight="224" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ManualSeriesComicItem">
                                        <Border
                                            Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                            Width="140"
                                            Height="216"
                                            Margin="4"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Button
                                                Click="CandidateCard_Click"
                                                Tag="{x:Bind}"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="156" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Cover -->
                                                    <Grid Grid.Row="0">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8,8,0,0">
                                                            <FontIcon Glyph="&#xE82D;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{x:Bind Comic.ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                                        <!-- Selection Checkbox / Indicator (Top Right) -->
                                                        <Border
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="6"
                                                            Width="24"
                                                            Height="24"
                                                            CornerRadius="12"
                                                            Background="#CC000000"
                                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                            BorderThickness="1.5">
                                                            <FontIcon
                                                                Glyph="&#xE73E;"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Title -->
                                                    <StackPanel Grid.Row="1" Padding="6,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Comic.Title}" FontWeight="SemiBold" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!-- Selected Highlight Border Overlay -->
                                                    <Border
                                                        Grid.RowSpan="2"
                                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="8"
                                                        IsHitTestVisible="False"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="3">
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CloseCreateSeriesDialogCommand}"
                            HorizontalAlignment="Left" />
                        <Button
                            Content="Create Series"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveManualSeriesCommand}"
                            HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ADD COMICS TO EXISTING SERIES OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="135"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsAddComicsToSeriesDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Border
                MaxWidth="860"
                MaxHeight="680"
                Margin="32"
                Padding="24"
                CornerRadius="16"
                Background="{ThemeResource ModalCardBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1.5">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Add Comics to Series" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.SeriesName, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Height="34" Width="34" Padding="0" CornerRadius="17"
                            Command="{x:Bind ViewModel.CloseAddComicsToSeriesDialogCommand}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Search / Filter Box -->
                    <Grid Grid.Row="1">
                        <AutoSuggestBox
                            QueryIcon="Find"
                            PlaceholderText="Filter comics to add..."
                            Text="{x:Bind ViewModel.ManualSeriesSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- Comics Selection Grid with Thumbnails -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Selection Summary & Quick Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SelectedCandidateCount, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />
                                <TextBlock Text="comics selected to add" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button
                                    Content="Select All"
                                    FontSize="11"
                                    Padding="10,4"
                                    Command="{x:Bind ViewModel.SelectAllCandidatesCommand}" />
                                <Button
                                    Content="Clear Selection"
                                    FontSize="11"
                                    Padding="10,4"
                                    Command="{x:Bind ViewModel.ClearCandidateSelectionCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Candidates Scroll / ItemsControl -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ManualSeriesCandidates, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="148" ItemHeight="224" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ManualSeriesComicItem">
                                        <Border
                                            Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                            Width="140"
                                            Height="216"
                                            Margin="4"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Button
                                                Click="CandidateCard_Click"
                                                Tag="{x:Bind}"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="156" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Cover -->
                                                    <Grid Grid.Row="0">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8,8,0,0">
                                                            <FontIcon Glyph="&#xE82D;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{x:Bind Comic.ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                                        <!-- Selection Checkbox / Indicator (Top Right) -->
                                                        <Border
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="6"
                                                            Width="24"
                                                            Height="24"
                                                            CornerRadius="12"
                                                            Background="#CC000000"
                                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                            BorderThickness="1.5">
                                                            <FontIcon
                                                                Glyph="&#xE73E;"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Title -->
                                                    <StackPanel Grid.Row="1" Padding="6,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Comic.Title}" FontWeight="SemiBold" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!-- Selected Highlight Border Overlay -->
                                                    <Border
                                                        Grid.RowSpan="2"
                                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="8"
                                                        IsHitTestVisible="False"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="3">
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CloseAddComicsToSeriesDialogCommand}"
                            HorizontalAlignment="Left" />
                        <Button
                            Content="Add to Series"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveComicsToExistingSeriesCommand}"
                            HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
