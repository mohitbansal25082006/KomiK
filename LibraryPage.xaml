<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Komik.LibraryPage"
    x:Name="LibraryRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Komik.Models"
    xmlns:vm="using:Komik.ViewModels"
    xmlns:helpers="using:Komik.Helpers"
    xmlns:controls="using:Komik.Controls"
    mc:Ignorable="d"
    KeyDown="LibraryPage_KeyDown"
    SizeChanged="LibraryPage_SizeChanged"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Cards animate themselves on hover; hide the default grid item hover/press plates behind them -->
        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemRevealBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemRevealBackgroundPressed" Color="Transparent" />

        <Style x:Key="ComicCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource KomikPanelBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource KomikPanelStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="helpers:MotionHelper.HoverLift" Value="True" />
        </Style>

        <TransitionCollection x:Key="KomikGridItemTransitions">
            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="36" />
            <RepositionThemeTransition />
        </TransitionCollection>

        <Style x:Key="FormatBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#E60B0B12" />
            <Setter Property="BorderBrush" Value="#59FFD700" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style x:Key="WarningBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#D9A80000" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <!-- Filter chips built on a horizontal ListView: the picked chip turns yellow -->
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFD700" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFE24D" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#F5C800" />
        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#0B0B12" />
        <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#0B0B12" />
        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>

        <Style x:Key="ComicChipBarStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Padding" Value="14,0" />
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="BorderThickness" Value="2,2,3,3" />
                        <Setter Property="BorderBrush" Value="{ThemeResource KomikInkStrokeBrush}" />
                        <Setter Property="Background" Value="{ThemeResource KomikPanelSunkenBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One comic in the create / add pickers -->
        <DataTemplate x:Key="CandidateCardTemplate" x:DataType="models:ManualSeriesComicItem">
            <Grid Width="150" Height="246" Margin="4" helpers:MotionHelper.HoverLift="True" ToolTipService.ToolTip="{x:Bind Comic.Title}">
                <Border Margin="5,5,0,0" CornerRadius="11" Background="{ThemeResource KomikShadowBrush}" Opacity="0.55" />
                <Border Margin="0,0,5,5" CornerRadius="11" Background="{ThemeResource KomikPanelBrush}" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2" Padding="5">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="170" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid CornerRadius="7" Background="{ThemeResource KomikPanelSunkenBrush}">
                            <FontIcon Glyph="&#xE82D;" FontSize="24" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                            <Image Source="{x:Bind Comic.ThumbnailPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" helpers:MotionHelper.HoverRole="Zoom" />
                            <Border Background="#8CFFD700" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,1,10,0" CornerRadius="6" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="2.5,2.5,4,4" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-8" />
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#0B0B12" />
                                    <TextBlock Text="PICKED" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" CharacterSpacing="40" Foreground="#0B0B12" />
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" CornerRadius="4" Background="#E60B0B12" Padding="5,0">
                                <TextBlock Text="{x:Bind Comic.FormatBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Width="22" Height="22" CornerRadius="11" Background="#E60B0B12" BorderBrush="#FFD700" BorderThickness="1.5">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#FFD700" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="1" VerticalAlignment="Center" Padding="2,0">
                            <TextBlock Text="{x:Bind Comic.Title}" FontWeight="SemiBold" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Caption}" FontSize="10" Foreground="{ThemeResource KomikSubtleTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <MenuFlyout x:Key="ComicContextMenu" Opening="ComicContextMenu_Opening" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
            <MenuFlyoutItem Text="Read Comic" Click="ContextRead_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="ContextSetCoverItem" Text="Use as Series Cover" Click="ContextSetCover_Click" Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEB9F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="ContextRemoveFromSeriesItem" Text="Remove from This Series" Click="ContextRemoveFromSeries_Click" Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE738;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Comic Details..." Click="ContextDetails_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Toggle Favorite" Click="ContextFavorite_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEB52;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Mark as Completed / Unread" Click="ContextToggleCompleted_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Restart Reading" Click="ContextRestart_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE777;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Manage Tags..." Click="ContextAddTag_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ContextConvertToCbzItem" Text="Convert to CBZ..." Click="ContextConvertToCbz_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEB9F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Show in File Explorer" Click="ContextExplorer_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xED25;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Remove from Library" Click="ContextRemove_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="RootLayout" Padding="24,6,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. FLOATING NOTIFICATION (overlays, auto-hides) ==================== -->
        <controls:ComicToast
            Grid.Row="0"
            Grid.RowSpan="5"
            x:Name="LibraryToast"
            IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}" />

        <!-- ==================== 1. HERO BANNER + TOOLBARS ==================== -->
        <StackPanel x:Name="TopBarStack" Grid.Row="1">
        <Grid
            x:Name="LibraryHero"
            Height="40"
            Margin="0,4,8,4">
            <Border CornerRadius="12" Background="{ThemeResource KomikHeroBrush}" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2,2,3,3" />
            <Border CornerRadius="12" Background="{StaticResource KomikSpeedLinesBrush}" Opacity="0.06" />
            <Border CornerRadius="12" Background="{StaticResource KomikHalftoneBrush}" Opacity="0.16" />

            <Grid Padding="12,0,5,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="KOMIK" Style="{StaticResource ComicDisplayTextStyle}" FontSize="26" LineHeight="28" Foreground="{ThemeResource KomikWordmarkShadowBrush}" Margin="2,2,0,0" />
                        <TextBlock Text="KOMIK" Style="{StaticResource ComicDisplayTextStyle}" FontSize="26" LineHeight="28" Foreground="{ThemeResource KomikWordmarkBrush}" />
                    </Grid>
                    <Border Style="{StaticResource ComicStickerStyle}" VerticalAlignment="Center" Background="#FF1F6D" BorderBrush="#0B0B12" Padding="6,0" BorderThickness="1.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="-6" />
                        </Border.RenderTransform>
                        <TextBlock Text="v1.1.0" Style="{StaticResource ComicStickerTextStyle}" Foreground="White" FontSize="11" />
                    </Border>
                    <TextBlock x:Name="HeroTagline" Text="YOUR OFFLINE COMIC UNIVERSE" FontSize="9" FontWeight="Bold" CharacterSpacing="200" Foreground="{ThemeResource KomikHeroTaglineBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border
                        x:Name="HeroChipComics"
                        Height="30"
                        CornerRadius="9"
                        Background="#FFD700"
                        BorderBrush="#0B0B12"
                        BorderThickness="2,2,3,3"
                        Padding="8,0,10,0"
                        ToolTipService.ToolTip="Show every comic"
                        Tapped="HeroChipComics_Tapped"
                        helpers:MotionHelper.HoverLift="True"
                        helpers:MotionHelper.HoverTilt="-3">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TotalComicCount, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="19" LineHeight="20" Foreground="#0B0B12" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeroChipComicsLabel" Text="COMICS" FontSize="9" FontWeight="Black" CharacterSpacing="100" Foreground="#0B0B12" VerticalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="HeroChipReading"
                        Height="30"
                        CornerRadius="9"
                        Background="#00C2FF"
                        BorderBrush="#0B0B12"
                        BorderThickness="2,2,3,3"
                        Padding="8,0,10,0"
                        ToolTipService.ToolTip="Show comics you are reading"
                        Tapped="HeroChipReading_Tapped"
                        helpers:MotionHelper.HoverLift="True"
                        helpers:MotionHelper.HoverTilt="2">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.InProgressCount, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="19" LineHeight="20" Foreground="#0B0B12" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeroChipReadingLabel" Text="READING" FontSize="9" FontWeight="Black" CharacterSpacing="100" Foreground="#0B0B12" VerticalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="HeroChipFinished"
                        Height="30"
                        CornerRadius="9"
                        Background="#FF1F6D"
                        BorderBrush="#0B0B12"
                        BorderThickness="2,2,3,3"
                        Padding="8,0,10,0"
                        ToolTipService.ToolTip="Show finished comics"
                        Tapped="HeroChipFinished_Tapped"
                        helpers:MotionHelper.HoverLift="True"
                        helpers:MotionHelper.HoverTilt="-2">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="19" LineHeight="20" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeroChipFinishedLabel" Text="FINISHED" FontSize="9" FontWeight="Black" CharacterSpacing="100" Foreground="White" VerticalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="HeroChipSeries"
                        Height="30"
                        CornerRadius="9"
                        Background="#2EE59D"
                        BorderBrush="#0B0B12"
                        BorderThickness="2,2,3,3"
                        Padding="8,0,10,0"
                        ToolTipService.ToolTip="Open series and creators"
                        Tapped="HeroChipSeries_Tapped"
                        helpers:MotionHelper.HoverLift="True"
                        helpers:MotionHelper.HoverTilt="3">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.StorySeriesCount, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="19" LineHeight="20" Foreground="#0B0B12" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeroChipSeriesLabel" Text="SERIES" FontSize="9" FontWeight="Black" CharacterSpacing="100" Foreground="#0B0B12" VerticalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Standard Comics Toolbar -->
        <ScrollViewer
            x:Name="ToolbarScrollViewer"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsSeriesView, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled"
            PointerWheelChanged="HorizontalScrollViewer_PointerWheelChanged"
            Margin="0,0,0,10">
            <Grid MinWidth="{x:Bind ToolbarScrollViewer.ActualWidth, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Library Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">


                    <!-- Combined ADD DropDown Button -->
                    <DropDownButton
                        Height="34"
                        Padding="10,0"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        ToolTipService.ToolTip="Add comics or folders to library">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="ADD" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
                                <MenuFlyoutItem Text="Add Folder..." Command="{x:Bind ViewModel.AddFolderCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Add Comic..." Command="{x:Bind ViewModel.AddComicFileCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button
                        Command="{x:Bind ViewModel.RescanLibraryCommand}"
                        Height="34"
                        Padding="8,0"
                        IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                        ToolTipService.ToolTip="Rescan all watched folders for new and missing comics">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Rescan" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <DropDownButton
                        Height="34"
                        Padding="8,0"
                        IsEnabled="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                        ToolTipService.ToolTip="Convert comic files (CBR, CB7, PDF, etc.) or image folders to standard CBZ archives">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xEB9F;" FontSize="12" />
                            <TextBlock Text="Convert..." FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
                                <MenuFlyoutItem Text="Convert Comic File (CBR, CB7, PDF)..." Click="ConvertStandaloneFile_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Convert Image Folder..." Click="ConvertStandaloneFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Reading Stats Button -->
                    <Button
                        Command="{x:Bind ViewModel.OpenReadingStatsCommand}"
                        Height="34"
                        Padding="8,0"
                        ToolTipService.ToolTip="Reading Statistics, streaks, and Komik Wrapped">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE9D2;" FontSize="12" />
                            <TextBlock Text="Stats" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Duplicates Button with Info Flyout -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.OpenDuplicateManagerCommand}"
                            Height="34"
                            Padding="8,0"
                            ToolTipService.ToolTip="Review and manage duplicate comics">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#F59E0B" />
                                <TextBlock Text="Duplicates" FontSize="12" />
                                <Border
                                    Visibility="{x:Bind ViewModel.HasDuplicates, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    Background="#F59E0B"
                                    CornerRadius="8"
                                    Padding="5,0"
                                    Margin="2,0,0,0">
                                    <TextBlock Text="{x:Bind ViewModel.DuplicateCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Duplicate Detection Info">
                            <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
                                    <StackPanel Width="270" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#F59E0B" />
                                            <TextBlock Text="Duplicate Comics Manager" FontWeight="Bold" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Text="Identifies identical or multi-format copies (e.g. CBZ vs PDF vs CBR) and 95%+ title matches. Easily remove duplicate copies from disk or Keep All to retain both." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Standalone Series & Volumes Button with Info Flyout -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.OpenSeriesViewCommand}"
                            Height="34"
                            Padding="8,0"
                            ToolTipService.ToolTip="Browse and manage comic runs, manga volumes, and custom series">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8B9;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Series &amp; Volumes" FontSize="12" />
                                <Border
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="5,0"
                                    Margin="2,0,0,0">
                                    <TextBlock Text="{x:Bind ViewModel.StorySeriesCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Series &amp; Volumes Info">
                            <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
                                    <StackPanel Width="270" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="Series &amp; Volume Grouping" FontWeight="Bold" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Text="Scans your whole library for stories that continue across books and for everything by the same author or artist. Click any card to see the books in reading order and continue where you left off." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Search, Sort & View Mode Toggles -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="150"
                        QueryIcon="Find"
                        PlaceholderText="Search comics..."
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

                    <!-- Sort ComboBox with Info Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <ComboBox
                            Width="130"
                            ItemsSource="{x:Bind ViewModel.SortOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                            DisplayMemberPath="DisplayName"
                            ToolTipService.ToolTip="Sort comics" />
                        <Button
                            Style="{StaticResource InfoButtonStyle}"
                            ToolTipService.ToolTip="Sort collection details">
                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
                                    <StackPanel Width="260" Spacing="6">
                                        <TextBlock Text="Library Sorting" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="Sort your collection by title using natural numeric order (e.g. #2 before #10), date added, recently read, page count, or file size." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- View Layout Switcher (Grid vs List) -->
                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="6"
                        Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button
                                x:Name="GridModeButton"
                                AutomationProperties.Name="Grid view"
                                Height="30"
                                Width="32"
                                Padding="0"
                                Click="GridMode_Click"
                                ToolTipService.ToolTip="Cover Cards Grid View">
                                <FontIcon Glyph="&#xE80A;" FontSize="12" />
                            </Button>
                            <Button
                                x:Name="ListModeButton"
                                AutomationProperties.Name="List view"
                                Height="30"
                                Width="32"
                                Padding="0"
                                Click="ListMode_Click"
                                ToolTipService.ToolTip="Detailed List View (with page counts, file sizes, and formats)">
                                <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Settings Button -->
                    <Button
                        Click="SettingsButton_Click"
                        Height="34"
                        Width="34"
                        Padding="0"
                        CornerRadius="17"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Dedicated Series & Volumes Standalone Toolbar -->
        <ScrollViewer
            x:Name="SeriesToolbarScrollViewer"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsSeriesView, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled"
            PointerWheelChanged="HorizontalScrollViewer_PointerWheelChanged"
            Margin="0,0,0,10">
            <Grid MinWidth="{x:Bind SeriesToolbarScrollViewer.ActualWidth, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Back to Comics, Title, Badge, New Series, Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Command="{x:Bind ViewModel.CloseSeriesViewCommand}"
                        Height="34"
                        Padding="10,0"
                        ToolTipService.ToolTip="Return to comics library">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                            <TextBlock Text="Back to Comics" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" />

                    <FontIcon Glyph="&#xE8B9;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="SERIES" Style="{StaticResource ComicSectionTitleStyle}" FontSize="26" Margin="0,0,6,0" />

                    <!-- Section switcher: story continuations vs. creators -->
                    <Border CornerRadius="19" BorderBrush="#000000" BorderThickness="2,2,3,3" Background="{ThemeResource KomikPanelSunkenBrush}" Padding="3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <ToggleButton
                                x:Name="StorySectionToggle"
                                IsChecked="{x:Bind ViewModel.IsStorySection, Mode=OneWay}"
                                Click="StorySection_Click"
                                CornerRadius="15"
                                Height="30"
                                Padding="12,0"
                                AutomationProperties.Name="Continuation Series"
                                ToolTipService.ToolTip="Stories that continue across books: numbered issues, volumes, chapters, parts and sequels">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                                    <TextBlock Text="CONTINUATION SERIES" FontFamily="{StaticResource KomikDisplayFont}" FontSize="15" CharacterSpacing="40" VerticalAlignment="Center" />
                                    <Border CornerRadius="8" Background="#FFD700" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.StorySeriesCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="CreatorSectionToggle"
                                IsChecked="{x:Bind ViewModel.IsCreatorSection, Mode=OneWay}"
                                Click="CreatorSection_Click"
                                CornerRadius="15"
                                Height="30"
                                Padding="12,0"
                                AutomationProperties.Name="By Creator"
                                ToolTipService.ToolTip="Everything by the same author, artist or circle, across your whole library">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE77B;" FontSize="12" />
                                    <TextBlock Text="BY CREATOR" FontFamily="{StaticResource KomikDisplayFont}" FontSize="15" CharacterSpacing="40" VerticalAlignment="Center" />
                                    <Border CornerRadius="8" Background="#FF1F6D" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CreatorGroupCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <Button
                        Command="{x:Bind ViewModel.OpenCreateSeriesDialogCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="34"
                        Padding="10,0"
                        ToolTipService.ToolTip="Create a new manual series or reading order from your library comics">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.NewGroupButtonText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Series &amp; Volumes Info">
                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
                                <StackPanel Width="270" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Series &amp; Volume Grouping" FontWeight="Bold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Text="Scans your whole library. Continuation Series joins books that continue one story (numbered issues, volumes, chapters, parts, sequels and first books without a number), even when their titles differ slightly. By Creator gathers everything from the same author, artist or circle. You can also build your own manual series." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Right: Series Search, Series Sort, Settings -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <AutoSuggestBox
                        Width="160"
                        QueryIcon="Find"
                        PlaceholderText="Search series or creators..."
                        Text="{x:Bind ViewModel.SeriesSearchText, Mode=TwoWay}" />

                    <ComboBox
                        Width="130"
                        ItemsSource="{x:Bind ViewModel.SeriesStatusFilters}"
                        SelectedItem="{x:Bind ViewModel.SelectedSeriesStatusFilter, Mode=TwoWay}"
                        ToolTipService.ToolTip="Show series by reading status or missing issues" />

                    <ComboBox
                        Width="130"
                        ItemsSource="{x:Bind ViewModel.SortOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        ToolTipService.ToolTip="Sort series" />

                    <Button
                        Command="{x:Bind ViewModel.RestoreHiddenSeriesCommand}"
                        Visibility="{x:Bind ViewModel.HasHiddenSeries, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                        Height="34"
                        Padding="10,0"
                        ToolTipService.ToolTip="Bring back series you marked as 'Not a Series'">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.HiddenSeriesDisplay, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="SettingsButton_Click"
                        Height="34"
                        Width="34"
                        Padding="0"
                        CornerRadius="17"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        </StackPanel>

        <!-- ==================== 2. FILTER PILLS & CHIPS (COMICS ONLY) ==================== -->
        <ScrollViewer
            x:Name="FilterPillsScrollViewer"
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.IsSeriesView, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled"
            PointerWheelChanged="HorizontalScrollViewer_PointerWheelChanged"
            Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- All Comics Chip -->
                <Button
                    Click="FilterAll_Click"
                    CornerRadius="16"
                    BorderBrush="{ThemeResource KomikPanelStrokeBrush}"
                    BorderThickness="1.5,1.5,3,3"
                    helpers:MotionHelper.HoverLift="True"
                    Padding="14,6"
                    Background="{x:Bind FilterAllBackground}"
                    Foreground="{x:Bind FilterAllForeground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="All Comics" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.TotalComicCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- Continue Reading Chip -->
                <Button
                    Click="FilterContinueReading_Click"
                    CornerRadius="16"
                    BorderBrush="{ThemeResource KomikPanelStrokeBrush}"
                    BorderThickness="1.5,1.5,3,3"
                    helpers:MotionHelper.HoverLift="True"
                    Padding="14,6"
                    Background="{x:Bind FilterContinueReadingBackground}"
                    Foreground="{x:Bind FilterContinueReadingForeground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Continue Reading" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.InProgressCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- Favorites Chip -->
                <Button
                    Click="FilterFavorites_Click"
                    CornerRadius="16"
                    BorderBrush="{ThemeResource KomikPanelStrokeBrush}"
                    BorderThickness="1.5,1.5,3,3"
                    helpers:MotionHelper.HoverLift="True"
                    Padding="14,6"
                    Background="{x:Bind FilterFavoritesBackground}"
                    Foreground="{x:Bind FilterFavoritesForeground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB52;" FontSize="11" Foreground="#FF4560" />
                        <TextBlock Text="Favorites" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- Completed Chip -->
                <Button
                    Click="FilterCompleted_Click"
                    CornerRadius="16"
                    BorderBrush="{ThemeResource KomikPanelStrokeBrush}"
                    BorderThickness="1.5,1.5,3,3"
                    helpers:MotionHelper.HoverLift="True"
                    Padding="14,6"
                    Background="{x:Bind FilterCompletedBackground}"
                    Foreground="{x:Bind FilterCompletedForeground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#4CAF50" />
                        <TextBlock Text="Completed" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- Unread Chip -->
                <Button
                    Click="FilterUnread_Click"
                    CornerRadius="16"
                    BorderBrush="{ThemeResource KomikPanelStrokeBrush}"
                    BorderThickness="1.5,1.5,3,3"
                    helpers:MotionHelper.HoverLift="True"
                    Padding="14,6"
                    Background="{x:Bind FilterUnreadBackground}"
                    Foreground="{x:Bind FilterUnreadForeground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE734;" FontSize="11" />
                        <TextBlock Text="Unread" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.UnreadCount, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />

                <!-- Tags Dropdown / List -->
                <DropDownButton
                    x:Name="TagsDropDown"
                    CornerRadius="16"
                    Padding="12,6"
                    FontSize="12"
                    AutomationProperties.Name="Tags"
                    ToolTipService.ToolTip="Filter the library by a tag">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="{ThemeResource KomikMagentaBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TagFilterButtonText, Mode=OneWay}" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout x:Name="TagFilterFlyout" Placement="BottomEdgeAlignedLeft" Opened="TagFilterFlyout_Opened" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
                            <Grid Width="320" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="FILTER BY TAG" Style="{StaticResource ComicSectionTitleStyle}" FontSize="20" />
                                        <TextBlock Text="{x:Bind ViewModel.TagSummaryDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Padding="10,5" Click="ManageTags_Click" ToolTipService.ToolTip="Create, rename and delete tags">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE713;" FontSize="11" />
                                            <TextBlock Text="Manage" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <AutoSuggestBox
                                    x:Name="TagFilterSearchBox"
                                    Grid.Row="1"
                                    QueryIcon="Find"
                                    PlaceholderText="Search tags..."
                                    Text="{x:Bind ViewModel.TagFilterSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Click="ClearTagFilter_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71C;" FontSize="12" />
                                        <TextBlock Text="All comics (no tag filter)" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Grid Grid.Row="3">
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.TagFilterItems, Mode=OneWay}"
                                        MaxHeight="340"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ItemClick="TagFilterItem_Click"
                                        Visibility="{x:Bind ViewModel.HasTagFilterResults, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="6,0" />
                                                <Setter Property="MinHeight" Value="38" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChipItem">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="1.5" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE8EC;" FontSize="10" Foreground="#0B0B12" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                    <Border Grid.Column="2" Style="{StaticResource ComicPillStyle}" Padding="8,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.TagFilterEmptyText, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasTagFilterResults, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}"
                                        FontSize="12"
                                        Foreground="{ThemeResource KomikSubtleTextBrush}"
                                        TextWrapping="Wrap"
                                        Margin="4,8" />
                                </Grid>
                            </Grid>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Manage Tags Button with Info Icon -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        CornerRadius="16"
                        Padding="10,6"
                        FontSize="12"
                        Click="ManageTags_Click"
                        ToolTipService.ToolTip="Create and manage your tags">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EC;" FontSize="11" />
                            <TextBlock Text="Manage Tags" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource InfoButtonStyle}"
                        ToolTipService.ToolTip="Tags allow you to organize comics with custom labels (e.g. Manga, Marvel, DC, Favorites) across different folders. Right-click any comic to manage its tags.">
                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </StackPanel>

                <!-- Active filter sticker: what is filtered, how many comics match, and a quick clear -->
                <Border
                    x:Name="ActiveFilterBadge"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    CornerRadius="17"
                    Background="#FFD700"
                    BorderBrush="#0B0B12"
                    BorderThickness="2,2,3,3"
                    Padding="4,3"
                    helpers:MotionHelper.RevealOnShow="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="24" Height="24" CornerRadius="12" Background="#0B0B12" VerticalAlignment="Center">
                            <FontIcon x:Name="ActiveFilterGlyph" Glyph="&#xE71C;" FontSize="11" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="ActiveFilterKind" FontFamily="{StaticResource KomikDisplayFont}" FontSize="15" CharacterSpacing="50" Foreground="#0B0B12" VerticalAlignment="Center" />
                        <TextBlock x:Name="ActiveFilterText" FontSize="12" FontWeight="Bold" Foreground="#0B0B12" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        <Border CornerRadius="9" Background="#0B0B12" Padding="7,1" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveFilterCount" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <Button
                            Click="ClearActiveFilter_Click"
                            Width="24"
                            Height="24"
                            Padding="0"
                            CornerRadius="12"
                            Background="#FFFDF6"
                            BorderBrush="#0B0B12"
                            BorderThickness="1.5"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Clear filter"
                            ToolTipService.ToolTip="Clear this filter">
                            <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="#0B0B12" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 3. PROGRESS INDICATORS ==================== -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,12">
            <!-- Scan Progress Strip -->
            <Border
                x:Name="ScanProgressStrip"
                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="{x:Bind ViewModel.ScanStatusMessage, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Conversion Progress Strip -->
            <Border
                x:Name="ConversionProgressStrip"
                Visibility="{x:Bind ViewModel.IsConverting, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="{x:Bind ViewModel.ConversionStatusMessage, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ProgressBar
                        Grid.Column="1"
                        Width="150"
                        Value="{x:Bind ViewModel.ConversionProgressPercentage, Mode=OneWay}"
                        Maximum="100"
                        IsIndeterminate="{x:Bind ViewModel.IsConversionIndeterminate, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Margin="14,0" />

                    <Button
                        Grid.Column="2"
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelConversionCommand}"
                        Height="28"
                        Padding="10,0" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ==================== 4. MAIN CONTENT AREA ==================== -->
        <!-- EMPTY STATE (when library has 0 comics total) -->
        <Grid
            Grid.Row="4"
            x:Name="EmptyLibraryContainer"
            Canvas.ZIndex="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowEmptyLibrary, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Border
                Width="520"
                Padding="36,40"
                CornerRadius="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="22" HorizontalAlignment="Center">
                    <Image
                        Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center" />

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock
                            Text="Your Library is Empty"
                            FontSize="26"
                            FontWeight="Bold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Add folders containing your comics (.cbz, .cbr, .cb7, .zip, .rar, .7z, .pdf, or image directories) to automatically index and organize them."
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.AddFolderCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="42"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F4;" FontSize="15" />
                                <TextBlock Text="Add Folder..." FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{x:Bind ViewModel.AddComicFileCommand}"
                            Height="42"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="15" />
                                <TextBlock Text="Add Comic File..." FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- EMPTY FILTER / SEARCH RESULTS (a filter, tag, search or series view with nothing to show) -->
        <Grid
            Grid.Row="4"
            x:Name="EmptyFilterContainer"
            Canvas.ZIndex="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="16"
            Visibility="{x:Bind ViewModel.ShowEmptyFilter, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            helpers:MotionHelper.RevealOnShow="True">
            <Border Margin="9,9,0,0" CornerRadius="22" Background="{ThemeResource KomikShadowBrush}" />
            <Border Margin="0,0,9,9" CornerRadius="22" Background="{ThemeResource KomikPanelBrush}" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="3" MaxWidth="580">
                <Grid>
                    <Border CornerRadius="19" Background="{StaticResource KomikSpeedLinesBrush}" Opacity="0.05" IsHitTestVisible="False" />
                    <Border CornerRadius="19" Background="{StaticResource KomikHalftoneBrush}" Opacity="0.08" IsHitTestVisible="False" />
                    <StackPanel Spacing="14" Padding="36,26,36,30" HorizontalAlignment="Center">
                        <Grid Width="180" Height="150" HorizontalAlignment="Center">
                            <Grid x:Name="EmptyBurst" Width="140" Height="140" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="EmptyBurstRotate" Angle="0" />
                                </Grid.RenderTransform>
                                <Polygon Points="70.0,4.0 81.1,21.3 98.6,10.5 101.2,30.9 121.6,28.8 115.0,48.3 134.3,55.3 120.0,70.0 134.3,84.7 115.0,91.7 121.6,111.2 101.2,109.1 98.6,129.5 81.1,118.7 70.0,136.0 58.9,118.7 41.4,129.5 38.8,109.1 18.4,111.2 25.0,91.7 5.7,84.7 20.0,70.0 5.7,55.3 25.0,48.3 18.4,28.8 38.8,30.9 41.4,10.5 58.9,21.3" Fill="#0B0B12" Margin="6,6,-6,-6" Opacity="0.85" />
                                <Polygon Points="70.0,4.0 81.1,21.3 98.6,10.5 101.2,30.9 121.6,28.8 115.0,48.3 134.3,55.3 120.0,70.0 134.3,84.7 115.0,91.7 121.6,111.2 101.2,109.1 98.6,129.5 81.1,118.7 70.0,136.0 58.9,118.7 41.4,129.5 38.8,109.1 18.4,111.2 25.0,91.7 5.7,84.7 20.0,70.0 5.7,55.3 25.0,48.3 18.4,28.8 38.8,30.9 41.4,10.5 58.9,21.3" Fill="{x:Bind ViewModel.EmptyFilterAccent, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" Stroke="#0B0B12" StrokeThickness="3" StrokeLineJoin="Round" />
                            </Grid>
                            <Border Width="74" Height="74" CornerRadius="37" Background="#FFFDF6" BorderBrush="#0B0B12" BorderThickness="3,3,5,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ViewModel.EmptyFilterGlyph, Mode=OneWay}" FontSize="32" Foreground="#0B0B12" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,-18,0" Background="#FF1F6D" BorderBrush="#0B0B12" BorderThickness="2,2,3,3" CornerRadius="6" Padding="8,1">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="8" />
                                </Border.RenderTransform>
                                <TextBlock Text="{x:Bind ViewModel.EmptyFilterSticker, Mode=OneWay}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="15" CharacterSpacing="50" Foreground="White" />
                            </Border>
                        </Grid>

                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyFilterTitle, Mode=OneWay}"
                            Style="{StaticResource ComicDisplayTextStyle}"
                            FontSize="34"
                            LineHeight="38"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="480" />
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyFilterSubtitle, Mode=OneWay}"
                            FontSize="13"
                            Foreground="{ThemeResource KomikSubtleTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            MaxWidth="440" />

                        <helpers:WrapPanel HorizontalAlignment="Center" HorizontalSpacing="10" VerticalSpacing="8" Margin="0,6,0,0">
                            <Button Style="{StaticResource ComicPrimaryButtonStyle}" Click="ShowAllComics_Click" AutomationProperties.Name="{x:Bind ViewModel.EmptyFilterPrimaryText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71C;" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.EmptyFilterPrimaryText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ComicGhostButtonStyle}" Click="EmptyFilterAction_Click" Visibility="{x:Bind ViewModel.HasEmptyFilterAction, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.Name="{x:Bind ViewModel.EmptyFilterActionText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind ViewModel.EmptyFilterActionGlyph, Mode=OneWay}" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.EmptyFilterActionText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </helpers:WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- SERIES GRID VIEW -->
        <GridView
            Grid.Row="4"
            x:Name="SeriesGridView"
            ItemsSource="{x:Bind ViewModel.SeriesGroups, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemClick="SeriesCard_Click"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowSeriesGrid, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Padding="0,0,0,24">

            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="36" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ComicSeriesGroup">
                    <Grid Width="236" Height="372" Margin="8,12,8,8" helpers:MotionHelper.HoverLift="True" helpers:MotionHelper.HoverTilt="-1.2">
                        <!-- Stacked issues peeking out behind the cover -->
                        <Border Margin="18,4,0,40" CornerRadius="10" Background="#00C2FF" BorderBrush="#000000" BorderThickness="2" helpers:MotionHelper.HoverRole="FanRight">
                            <Border.RenderTransform>
                                <RotateTransform Angle="5" CenterX="110" CenterY="170" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Margin="8,2,8,30" CornerRadius="10" Background="#FF1F6D" BorderBrush="#000000" BorderThickness="2" helpers:MotionHelper.HoverRole="FanLeft">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-3" CenterX="110" CenterY="170" />
                            </Border.RenderTransform>
                        </Border>

                        <ContentControl Style="{StaticResource ComicPanelStyle}" Padding="8" CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="222" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" CornerRadius="8">
                                    <Border Background="{ThemeResource KomikPanelSunkenBrush}">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{x:Bind CoverThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" helpers:MotionHelper.HoverRole="Zoom" />
                                    <Border Background="{StaticResource KomikCoverFadeBrush}" />
                                    <Rectangle helpers:MotionHelper.HoverRole="Shine" IsHitTestVisible="False" Width="90" HorizontalAlignment="Left">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Border helpers:MotionHelper.HoverRole="Reveal" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFD700" BorderBrush="#000000" BorderThickness="3,3,5,5" CornerRadius="10" Padding="14,2,14,0">
                                        <TextBlock Text="OPEN!" FontFamily="{StaticResource KomikDisplayFont}" FontSize="30" CharacterSpacing="40" Foreground="#0B0B12" />
                                    </Border>

                                    <!-- Count sticker -->
                                    <Border Style="{StaticResource ComicStickerStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,1" helpers:MotionHelper.HoverRole="Spin">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-4" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="{x:Bind IssueCountDisplay, Mode=OneWay}" Style="{StaticResource ComicStickerTextStyle}" FontSize="15" />
                                    </Border>

                                    <!-- Status -->
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Spacing="4">
                                        <Border HorizontalAlignment="Right" CornerRadius="10" Padding="8,2" Background="#E60B0B12" BorderBrush="#40FFFFFF" BorderThickness="1">
                                            <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <Border HorizontalAlignment="Right" CornerRadius="6" Padding="6,0" Background="#FFFFFF" BorderBrush="#0B0B12" BorderThickness="1.5" ToolTipService.ToolTip="{x:Bind ModeToolTip, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ModeDisplay, Mode=OneWay}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="12" CharacterSpacing="40" Foreground="#0B0B12" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Source + gaps + formats -->
                                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,12" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border CornerRadius="9" Padding="7,2" Background="#CC0B0B12" ToolTipService.ToolTip="{x:Bind SourceDisplay}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="{x:Bind SourceGlyph}" FontSize="10" Foreground="#00C2FF" />
                                                    <TextBlock Text="{x:Bind FormatsDisplay, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                CornerRadius="9"
                                                Padding="7,2"
                                                Background="#FF1F6D"
                                                Visibility="{x:Bind HasMissingIssues, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                                ToolTipService.ToolTip="{x:Bind MissingIssuesDisplay, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind MissingBadgeText, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <Grid Height="6" CornerRadius="3" Background="#59FFFFFF">
                                            <ProgressBar Value="{x:Bind OverallProgress, Mode=OneWay}" Maximum="1" MinHeight="6" Height="6" CornerRadius="3" Background="Transparent" Foreground="#FFD700" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="2,10,2,0" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{x:Bind SeriesName}"
                                        FontFamily="{StaticResource KomikDisplayFont}"
                                        CharacterSpacing="20"
                                        FontSize="19"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind SeriesName}" />
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="{x:Bind CardSubtitle, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" Margin="0,0,40,0" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind CardSubtitle, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ProgressPercentDisplay, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource KomikCyanBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Button
                                        Grid.Row="2"
                                        Style="{StaticResource ComicPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        MinHeight="34"
                                        Padding="8,4"
                                        Click="PlaySeriesNext_Click"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Pick up exactly where you left off">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                                            <TextBlock Text="{x:Bind NextIssueDisplay, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- COMICS GRID VIEW -->
        <GridView
            Grid.Row="4"
            x:Name="ComicsGridView"
            ItemsSource="{x:Bind ViewModel.Comics, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemClick="ComicGrid_ItemClick"
            ItemContainerTransitions="{StaticResource KomikGridItemTransitions}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowComicsGrid, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Padding="0,0,0,24">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ComicEntity">
                    <Grid
                        Width="186"
                        Height="306"
                        Margin="8,10,8,8"
                        helpers:MotionHelper.HoverLift="True"
                        helpers:MotionHelper.HoverTilt="-1"
                        ContextFlyout="{StaticResource ComicContextMenu}">

                        <!-- Hard ink shadow that deepens as the card lifts -->
                        <Border Margin="7,7,0,0" CornerRadius="12" Background="{ThemeResource KomikShadowBrush}" helpers:MotionHelper.HoverRole="Sink" />

                        <Border Margin="0,0,7,7" CornerRadius="12" Background="{ThemeResource KomikPanelBrush}" BorderBrush="#000000" BorderThickness="2" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="216" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Cover -->
                                <Grid Grid.Row="0" CornerRadius="8" Background="{ThemeResource KomikPanelSunkenBrush}">
                                    <FontIcon Glyph="&#xE82D;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image
                                        Source="{x:Bind ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                        Stretch="UniformToFill"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        helpers:MotionHelper.HoverRole="Zoom" />
                                    <Rectangle helpers:MotionHelper.HoverRole="Shine" IsHitTestVisible="False" Width="90" HorizontalAlignment="Left">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Border helpers:MotionHelper.HoverRole="Reveal" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFD700" BorderBrush="#000000" BorderThickness="3,3,5,5" CornerRadius="10" Padding="14,2,14,0">
                                        <TextBlock Text="READ!" FontFamily="{StaticResource KomikDisplayFont}" FontSize="30" CharacterSpacing="40" Foreground="#0B0B12" />
                                    </Border>

                                    <!-- Format sticker -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" CornerRadius="4" Background="#FFD700" BorderBrush="#000000" BorderThickness="1.5,1.5,2.5,2.5" Padding="6,1" helpers:MotionHelper.HoverRole="Spin">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-5" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="{x:Bind FormatBadge}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="13" CharacterSpacing="40" Foreground="#0B0B12" />
                                    </Border>

                                    <!-- Favorite -->
                                    <Button
                                        Click="FavoriteButton_Click"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="4"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="15"
                                        Background="#CC0B0B12"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="{x:Bind FavoriteToolTip, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="13" Foreground="#FF4560" />
                                    </Button>

                                    <!-- Details -->
                                    <Button
                                        Click="InfoButton_Click"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,38,4,0"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="15"
                                        Background="#CC0B0B12"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Comic Details"
                                        helpers:InstantToolTipHelper.IsInstant="True">
                                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="White" />
                                    </Button>

                                    <!-- Offline -->
                                    <Border
                                        Style="{StaticResource WarningBadgeStyle}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="6,6,6,10"
                                        Visibility="{x:Bind IsMissing, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                        ToolTipService.ToolTip="File not found at original location">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="White" />
                                            <TextBlock Text="Offline" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Done sticker -->
                                    <Border
                                        CornerRadius="4"
                                        Background="#2EE59D"
                                        BorderBrush="#000000"
                                        BorderThickness="1.5,1.5,2.5,2.5"
                                        Padding="6,1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="6,6,6,10"
                                        Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                        ToolTipService.ToolTip="Completed">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="4" />
                                        </Border.RenderTransform>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#0B0B12" />
                                            <TextBlock Text="DONE" FontFamily="{StaticResource KomikDisplayFont}" FontSize="13" CharacterSpacing="40" Foreground="#0B0B12" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Progress -->
                                    <Grid
                                        Height="5"
                                        VerticalAlignment="Bottom"
                                        Background="#8C000000"
                                        Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                        <ProgressBar
                                            Value="{x:Bind ProgressBarValue, Mode=OneWay}"
                                            Maximum="100"
                                            MinHeight="5"
                                            Height="5"
                                            Background="Transparent"
                                            Foreground="#FFD700"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <!-- Title & meta -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,6,2,0" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="{x:Bind Title}" />
                                    <Grid>
                                        <TextBlock
                                            Text="{x:Bind PageCountFormatted}"
                                            FontSize="11"
                                            Foreground="{ThemeResource KomikSubtleTextBrush}"
                                            HorizontalAlignment="Left" />
                                        <Border
                                            HorizontalAlignment="Right"
                                            CornerRadius="7"
                                            Padding="6,0"
                                            Background="#3300C2FF"
                                            Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock
                                                Text="{x:Bind ProgressPillText, Mode=OneWay}"
                                                FontSize="10"
                                                Foreground="{ThemeResource KomikCyanBrush}"
                                                FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- COMICS LIST VIEW -->
        <ListView
            Grid.Row="4"
            x:Name="ComicsListView"
            ItemsSource="{x:Bind ViewModel.Comics, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemClick="ComicList_ItemClick"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowComicsList, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Padding="0,0,0,24">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ComicEntity">
                    <Grid
                        Padding="8,6"
                        CornerRadius="6"
                        ContextFlyout="{StaticResource ComicContextMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" CornerRadius="4" Width="40" Height="56" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image Source="{x:Bind ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                        </Border>

                        <!-- Title & Folder -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                                <Border
                                    Visibility="{x:Bind IsMissing, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    Style="{StaticResource WarningBadgeStyle}">
                                    <TextBlock Text="Offline" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ParentFolder}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Format -->
                        <Border Grid.Column="2" Style="{StaticResource FormatBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>

                        <!-- Page Count -->
                        <TextBlock Grid.Column="3" Text="{x:Bind PageCountFormatted}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                        <!-- Reading Progress -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="3" Margin="4,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#107C41"
                                          Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ProgressBar
                                Value="{x:Bind ProgressBarValue, Mode=OneWay}"
                                Maximum="100"
                                Height="3"
                                Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </StackPanel>

                        <!-- File Size -->
                        <TextBlock Grid.Column="5" Text="{x:Bind FileSizeFormatted}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                        <!-- Date Added -->
                        <TextBlock Grid.Column="6" Text="{x:Bind DateAddedFormatted}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                        <!-- Actions (Favorite & Details) -->
                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button
                                Click="FavoriteButton_Click"
                                Tag="{x:Bind}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Toggle Favorite">
                                <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="14" Foreground="#FF4560" />
                            </Button>
                            <Button
                                Click="InfoButton_Click"
                                Tag="{x:Bind}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Comic Details"
                                helpers:InstantToolTipHelper.IsInstant="True">
                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ==================== SERIES DETAIL OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="100"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsSeriesDetailOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ContentControl Style="{StaticResource ComicModalPanelStyle}" MaxWidth="1080" MaxHeight="780" Margin="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Banner -->
                    <Grid Grid.Row="0" CornerRadius="16,16,0,0" MinHeight="262">
                        <!-- Painted as a background so a large cover can never stretch the banner -->
                        <Border Opacity="0.5">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind ViewModel.SelectedSeriesGroup.CoverThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" AlignmentY="Center" />
                            </Border.Background>
                        </Border>
                        <Border Background="{StaticResource KomikSeriesBannerFadeBrush}" />
                        <Border Background="{StaticResource KomikHalftoneBrush}" Opacity="0.12" />

                        <Grid Padding="28,24,24,22" ColumnSpacing="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="0" Style="{StaticResource ComicPanelStyle}" Padding="0" Width="138" Height="196" VerticalAlignment="Top" BorderBrush="#000000">
                                <Grid CornerRadius="10">
                                    <Border Background="#1F1F2A">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="34" Foreground="#8888AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{x:Bind ViewModel.SelectedSeriesGroup.CoverThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                </Grid>
                            </ContentControl>

                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Style="{StaticResource ComicStickerStyle}" Padding="8,1">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{x:Bind ViewModel.SelectedSeriesGroup.SourceGlyph, Mode=OneWay}" FontSize="11" Foreground="#0B0B12" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.SourceDisplay, Mode=OneWay}" Style="{StaticResource ComicStickerTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="11" Padding="10,3" Background="#3300C2FF" BorderBrush="#00C2FF" BorderThickness="1">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.StatusDisplay, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#7FE0FF" />
                                    </Border>
                                    <Border CornerRadius="6" Padding="8,1" Background="#FFFFFF" BorderBrush="#0B0B12" BorderThickness="2" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedSeriesGroup.ModeToolTip, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.ModeDisplay, Mode=OneWay}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="14" CharacterSpacing="40" Foreground="#0B0B12" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedSeriesGroup.SeriesName, Mode=OneWay}"
                                    Style="{StaticResource ComicDisplayTextStyle}"
                                    FontSize="44"
                                    LineHeight="46"
                                    Foreground="White"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.DetailSubtitle, Mode=OneWay}" FontSize="13" Foreground="#D6D6E6" TextWrapping="Wrap" />

                                <Grid ColumnSpacing="12" MaxWidth="560" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Height="10" CornerRadius="5" Background="#40FFFFFF" VerticalAlignment="Center" MinWidth="320">
                                        <ProgressBar Value="{x:Bind ViewModel.SelectedSeriesGroup.OverallProgress, Mode=OneWay}" Maximum="1" MinHeight="10" Height="10" CornerRadius="5" Background="Transparent" Foreground="#FFD700" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedSeriesGroup.ProgressPercentDisplay, Mode=OneWay}" Style="{StaticResource ComicSectionTitleStyle}" FontSize="22" Foreground="#FFD700" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.SelectedSeriesGroup.ShowGapInfo, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#FF6B9A" Visibility="{x:Bind ViewModel.SelectedSeriesGroup.HasMissingIssues, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#2EE59D" Visibility="{x:Bind ViewModel.SelectedSeriesGroup.HasMissingIssues, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.MissingIssuesDisplay, Mode=OneWay}" FontSize="12" Foreground="#E6E6F0" TextWrapping="Wrap" />
                                </StackPanel>

                                <helpers:WrapPanel HorizontalSpacing="10" VerticalSpacing="8" Margin="0,6,0,0">
                                    <Button Style="{StaticResource ComicPrimaryButtonStyle}" Click="PlaySeriesNext_Click" Tag="{x:Bind ViewModel.SelectedSeriesGroup, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.NextIssueDisplay, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Style="{StaticResource ComicGhostButtonStyle}"
                                        Visibility="{x:Bind ViewModel.SelectedSeriesGroup.CanSaveAsManual, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                        Command="{x:Bind ViewModel.SaveSeriesAsManualCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedSeriesGroup, Mode=OneWay}"
                                        ToolTipService.ToolTip="Keep this grouping and order as a manual series you can edit">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                            <TextBlock Text="Save as Manual" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Style="{StaticResource ComicGhostButtonStyle}"
                                        Visibility="{x:Bind ViewModel.SelectedSeriesGroup.IsAutoDetected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                        Command="{x:Bind ViewModel.HideSeriesCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedSeriesGroup, Mode=OneWay}"
                                        ToolTipService.ToolTip="Wrong grouping? Hide it (you can restore it from the Series toolbar)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xED1A;" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.HideActionText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton
                                        x:Name="DetailAutoUpdateToggle"
                                        Visibility="{x:Bind ViewModel.SelectedSeriesGroup.IsManual, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                        IsChecked="{x:Bind ViewModel.SelectedSeriesGroup.IsAutoUpdate, Mode=OneWay}"
                                        Click="DetailAutoUpdate_Click"
                                        MinHeight="36"
                                        Padding="12,6"
                                        CornerRadius="8"
                                        ToolTipService.ToolTip="On: new comics that belong here are added automatically. Off: only the comics you choose.">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE895;" FontSize="12" />
                                            <TextBlock Text="Auto-update" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button
                                        Style="{StaticResource ComicGhostButtonStyle}"
                                        Visibility="{x:Bind ViewModel.SelectedSeriesGroup.IsManual, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                        Command="{x:Bind ViewModel.MakeSeriesAutomaticCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedSeriesGroup, Mode=OneWay}"
                                        ToolTipService.ToolTip="Stop managing it by hand and let Komik group these comics automatically again">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE945;" FontSize="12" />
                                            <TextBlock Text="Make Automatic" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Style="{StaticResource ComicGhostButtonStyle}"
                                        Command="{x:Bind ViewModel.OpenEditSeriesCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedSeriesGroup, Mode=OneWay}"
                                        AutomationProperties.Name="Edit Series"
                                        ToolTipService.ToolTip="Rename, change section, cover and reading order">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            <TextBlock Text="Edit" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ChangeCoverButton"
                                        Style="{StaticResource ComicGhostButtonStyle}"
                                        AutomationProperties.Name="Change Cover"
                                        ToolTipService.ToolTip="Use the cover of any comic in this series">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xEB9F;" FontSize="12" />
                                            <TextBlock Text="Cover" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout x:Name="CoverPickerFlyout" Placement="Bottom" Opened="CoverPickerFlyout_Opened" ShouldConstrainToRootBounds="True" AreOpenCloseAnimationsEnabled="True">
                                                <Grid Width="560" RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="PICK A COVER" Style="{StaticResource ComicSectionTitleStyle}" FontSize="22" />
                                                            <TextBlock Text="Click any comic to use its cover for this series." FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Padding="10,5" Command="{x:Bind ViewModel.ResetSeriesCoverCommand}" CommandParameter="{x:Bind ViewModel.SelectedSeriesGroup, Mode=OneWay}" Click="CoverReset_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE777;" FontSize="11" />
                                                                <TextBlock Text="Automatic" FontSize="12" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                    <GridView
                                                        x:Name="CoverPickerGrid"
                                                        Grid.Row="1"
                                                        MaxHeight="440"
                                                        SelectionMode="None"
                                                        IsItemClickEnabled="True"
                                                        ItemClick="CoverPickerItem_Click"
                                                        ItemsSource="{x:Bind ViewModel.SelectedSeriesGroup.IssueItems, Mode=OneWay}">
                                                        <GridView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:SeriesIssueItem">
                                                                <Grid Width="116" Height="196" RowSpacing="4">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="160" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid CornerRadius="8" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2" Background="{ThemeResource KomikPanelSunkenBrush}">
                                                                        <FontIcon Glyph="&#xE82D;" FontSize="22" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                                        <Image Source="{x:Bind ThumbnailPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                    </Grid>
                                                                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="11" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </GridView.ItemTemplate>
                                                    </GridView>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button
                                        Style="{StaticResource ComicAccentButtonStyle}"
                                        Command="{x:Bind ViewModel.OpenAddComicsToExistingSeriesCommand}"
                                        AutomationProperties.Name="Add Comics"
                                        ToolTipService.ToolTip="Add comics from your library to this series">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock Text="Add Comics" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Style="{StaticResource ComicDangerButtonStyle}"
                                        Visibility="{x:Bind ViewModel.SelectedSeriesGroup.IsManual, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                        Command="{x:Bind ViewModel.DeleteManualSeriesCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedSeriesGroup, Mode=OneWay}"
                                        ToolTipService.ToolTip="Delete this manual series (your comics stay in the library)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            <TextBlock Text="Delete" />
                                        </StackPanel>
                                    </Button>
                                </helpers:WrapPanel>
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                Style="{StaticResource ComicIconButtonStyle}"
                                VerticalAlignment="Top"
                                Command="{x:Bind ViewModel.CloseSeriesDetailCommand}"
                                ToolTipService.ToolTip="Close" AutomationProperties.Name="Close dialog">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Issues -->
                    <GridView
                        Grid.Row="1"
                        Padding="22,18,22,22"
                        ItemsSource="{x:Bind ViewModel.SelectedSeriesGroup.IssueItems, Mode=OneWay}"
                        IsItemClickEnabled="True"
                        ItemClick="SeriesIssue_Click"
                        SelectionMode="None">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="30" />
                            </TransitionCollection>
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SeriesIssueItem">
                                <Border Style="{StaticResource ComicCardStyle}" Width="158" Height="276" Margin="5" ContextFlyout="{StaticResource ComicContextMenu}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="196" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" CornerRadius="6">
                                            <Border Background="{ThemeResource KomikPanelSunkenBrush}">
                                                <FontIcon Glyph="&#xE82D;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{x:Bind ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" helpers:MotionHelper.HoverRole="Zoom" />
                                            <Border helpers:MotionHelper.HoverRole="Reveal" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFD700" BorderBrush="#000000" BorderThickness="3,3,5,5" CornerRadius="10" Padding="12,2,12,0">
                                                <TextBlock Text="READ!" FontFamily="{StaticResource KomikDisplayFont}" FontSize="24" CharacterSpacing="40" Foreground="#0B0B12" />
                                            </Border>

                                            <Border Style="{StaticResource ComicStickerStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,0" helpers:MotionHelper.HoverRole="Spin" Visibility="{x:Bind HasNumberLabel, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{x:Bind NumberLabel}" Style="{StaticResource ComicStickerTextStyle}" FontSize="16" />
                                            </Border>

                                            <Border
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                Height="24"
                                                Background="#00C2FF"
                                                Visibility="{x:Bind IsNextUp, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="#0B0B12" />
                                                    <TextBlock Text="UP NEXT" FontFamily="{StaticResource KomikDisplayFont}" FontSize="14" CharacterSpacing="80" Foreground="#0B0B12" />
                                                </StackPanel>
                                            </Border>

                                            <Button
                                                Visibility="{Binding Path=ViewModel.SelectedSeriesGroup.IsManual, ElementName=LibraryRoot, Converter={StaticResource BoolToVisConverter}}"
                                                Click="RemoveComicFromSeries_Click"
                                                Tag="{x:Bind Comic}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                CornerRadius="13"
                                                Background="#CC000000"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="Remove from this manual series">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#FF4D8D" />
                                            </Button>
                                            <ProgressBar Value="{x:Bind ProgressBarValue}" Maximum="100" Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Foreground="#FFD700" Visibility="{x:Bind IsInProgress, Converter={StaticResource BoolToVisConverter}}" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="2,8,2,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind Title}" />
                                            <Grid Grid.Row="1">
                                                <TextBlock Text="{x:Bind PageCountFormatted}" FontSize="10" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource KomikCyanBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ==================== DUPLICATE COMIC MANAGER OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="110"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsDuplicateManagerOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ContentControl Style="{StaticResource ComicModalPanelStyle}" MaxWidth="1100" MaxHeight="800" Margin="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" CornerRadius="16,16,0,0">
                        <Border Background="{ThemeResource KomikHeroBrush}" />
                        <Border Background="{StaticResource KomikHalftoneBrush}" Opacity="0.14" />
                        <Grid Padding="28,22,22,20" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource ComicStickerStyle}" Background="#FF9F1C" BorderBrush="#000000">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-4" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="CASE FILE" Style="{StaticResource ComicStickerTextStyle}" Foreground="#0B0B12" />
                                    </Border>
                                    <TextBlock Text="DUPLICATE DETECTIVE" Style="{StaticResource ComicDisplayTextStyle}" FontSize="38" LineHeight="40" Foreground="{ThemeResource KomikWordmarkBrush}" />
                                </StackPanel>
                                <TextBlock
                                    Text="Matches identical files, the same issue across formats (series + volume + number from names or metadata) and near-identical titles. Numbered issues never match a different number, and every group suggests the best copy to keep."
                                    FontSize="12"
                                    Foreground="{ThemeResource KomikHeroTextBrush}"
                                    Opacity="0.8"
                                    TextWrapping="Wrap"
                                    MaxWidth="760"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ComicIconButtonStyle}" VerticalAlignment="Top" Command="{x:Bind ViewModel.CloseDuplicateManagerCommand}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close dialog">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Toolbar -->
                    <Grid Grid.Row="1" Padding="26,14,26,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsScanningDuplicates, Mode=OneWay}" Width="18" Height="18" />
                            <TextBlock Text="{x:Bind ViewModel.DuplicateSummaryDisplay, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button
                                Style="{StaticResource ComicGhostButtonStyle}"
                                Command="{x:Bind ViewModel.ScanDuplicatesCommand}"
                                IsEnabled="{x:Bind ViewModel.IsScanningDuplicates, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                                ToolTipService.ToolTip="Scan the whole library again">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Rescan" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource ComicPrimaryButtonStyle}"
                                Click="ResolveAllDuplicates_Click"
                                IsEnabled="{x:Bind ViewModel.HasDuplicates, Mode=OneWay}"
                                ToolTipService.ToolTip="Keep the best copy in every group">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="12" />
                                    <TextBlock Text="Clean Up All" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="26,8,20,24">
                        <StackPanel Spacing="4">
                            <!-- Clean state -->
                            <StackPanel
                                Visibility="{x:Bind ViewModel.HasDuplicates, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}"
                                Padding="40"
                                Spacing="12"
                                HorizontalAlignment="Center">
                                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                                    <Ellipse Fill="#2EE59D" Stroke="#000000" StrokeThickness="3" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="54" Foreground="#0B0B12" />
                                </Grid>
                                <TextBlock Text="CASE CLOSED!" Style="{StaticResource ComicDisplayTextStyle}" FontSize="36" HorizontalAlignment="Center" />
                                <TextBlock Text="No duplicate copies anywhere in your library." FontSize="13" Foreground="{ThemeResource KomikSubtleTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}">
                                <ItemsControl.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="30" />
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </ItemsControl.ItemContainerTransitions>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DuplicateComicGroup">
                                        <ContentControl Style="{StaticResource ComicPanelStyle}" Margin="0,0,0,18" Padding="18">
                                            <Grid RowSpacing="14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="5">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border CornerRadius="6" Padding="8,2" Background="#2EE59D" BorderBrush="#000000" BorderThickness="1.5" Visibility="{x:Bind IsHighConfidence, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                                                <TextBlock Text="{x:Bind ConfidenceLabel, Mode=OneWay}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="14" CharacterSpacing="60" Foreground="#0B0B12" />
                                                            </Border>
                                                            <Border CornerRadius="6" Padding="8,2" Background="#FF9F1C" BorderBrush="#000000" BorderThickness="1.5" Visibility="{x:Bind IsHighConfidence, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}">
                                                                <TextBlock Text="{x:Bind ConfidenceLabel, Mode=OneWay}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="14" CharacterSpacing="60" Foreground="#0B0B12" />
                                                            </Border>
                                                            <Border Style="{StaticResource ComicPillStyle}">
                                                                <TextBlock Text="{x:Bind CopyCountDisplay, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Style="{StaticResource ComicPillStyle}" ToolTipService.ToolTip="Space freed by keeping only the best copy">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <FontIcon Glyph="&#xEDA2;" FontSize="10" Foreground="{ThemeResource KomikGreenBrush}" />
                                                                    <TextBlock Text="{x:Bind ReclaimableDisplay, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind GroupTitle}" Style="{StaticResource ComicSectionTitleStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind MatchReason}" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource ComicGhostButtonStyle}" Click="DismissDuplicate_Click" Tag="{x:Bind}" ToolTipService.ToolTip="These aren't duplicates. Keep every copy and stop flagging them">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE8FB;" FontSize="12" />
                                                                <TextBlock Text="Keep All" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ComicPrimaryButtonStyle}" Click="ResolveDuplicateGroup_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Keep the best copy (reading progress carries over) and remove the rest">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE734;" FontSize="12" />
                                                                <TextBlock Text="Keep Best" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind CopyItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DuplicateCopyItem">
                                                            <Grid Padding="10" Margin="0,0,0,8" CornerRadius="10" Background="{ThemeResource KomikPanelSunkenBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1" ColumnSpacing="14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid Width="58" Height="84" CornerRadius="6">
                                                                    <Border Background="{ThemeResource KomikPanelRaisedBrush}" />
                                                                    <Image Source="{x:Bind ThumbnailPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Grid>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border CornerRadius="5" Padding="7,1" Background="#FFD700" BorderBrush="#000000" BorderThickness="1.5" Visibility="{x:Bind KeepBadgeVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                <FontIcon Glyph="&#xE734;" FontSize="10" Foreground="#0B0B12" />
                                                                                <TextBlock Text="BEST COPY" FontFamily="{StaticResource KomikDisplayFont}" FontSize="13" CharacterSpacing="60" Foreground="#0B0B12" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{x:Bind FolderDisplay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FilePath}" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <Border Style="{StaticResource FormatBadgeStyle}">
                                                                            <TextBlock Text="{x:Bind FormatBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource ComicPillStyle}" Padding="7,1">
                                                                            <TextBlock Text="{x:Bind PageCountFormatted}" FontSize="10" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource ComicPillStyle}" Padding="7,1">
                                                                            <TextBlock Text="{x:Bind FileSizeFormatted}" FontSize="10" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource ComicPillStyle}" Padding="7,1">
                                                                            <TextBlock Text="{x:Bind ProgressText}" FontSize="10" />
                                                                        </Border>
                                                                        <TextBlock Text="{x:Bind Highlights, Mode=OneWay}" FontSize="11" FontStyle="Italic" Foreground="{ThemeResource KomikCyanBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource ComicIconButtonStyle}" Click="ReadDuplicateCopy_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Open this copy">
                                                                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                                    </Button>
                                                                    <Button Style="{StaticResource ComicIconButtonStyle}" Click="ShowDuplicateCopy_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Show in File Explorer">
                                                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                                                    </Button>
                                                                    <Button Style="{StaticResource ComicIconButtonStyle}" Click="RemoveDuplicateCopy_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Remove this copy">
                                                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource KomikMagentaBrush}" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ==================== READING STATISTICS & KOMIK WRAPPED OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="120"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsStatsDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ContentControl Style="{StaticResource ComicModalPanelStyle}" MaxWidth="1140" MaxHeight="820" Margin="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="28,22,22,14" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource ComicStickerStyle}">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-4" />
                                    </Border.RenderTransform>
                                    <TextBlock Text="STATS" Style="{StaticResource ComicStickerTextStyle}" FontSize="16" />
                                </Border>
                                <TextBlock Text="READING INSIGHTS" Style="{StaticResource ComicDisplayTextStyle}" FontSize="38" LineHeight="40" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource KomikGreenBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.StatsSummary.UpdatedDisplay, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="· tracks active reading time and the pages you actually view, saved every 45 seconds" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsStatsLoading, Mode=OneWay}" Width="18" Height="18" />
                            <Button Style="{StaticResource ComicIconButtonStyle}" Command="{x:Bind ViewModel.RefreshReadingStatsCommand}" ToolTipService.ToolTip="Refresh now" AutomationProperties.Name="Refresh stats">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource ComicIconButtonStyle}" Command="{x:Bind ViewModel.CloseReadingStatsCommand}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close dialog">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,22,28">
                        <StackPanel Spacing="18">
                            <!-- Empty state -->
                            <ContentControl Style="{StaticResource ComicPanelStyle}" Padding="26" Visibility="{x:Bind ViewModel.StatsSummary.HasNoReadingData, Mode=OneWay, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <FontIcon Glyph="&#xE736;" FontSize="40" Foreground="{ThemeResource KomikCyanBrush}" />
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="YOUR STORY STARTS ON PAGE ONE" Style="{StaticResource ComicSectionTitleStyle}" />
                                        <TextBlock Text="Open any comic and start reading. Time, pages, streaks and favorite series appear here live, with no estimates and nothing made up." FontSize="13" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ContentControl>

                            <!-- Komik Wrapped hero -->
                            <Grid MinHeight="190" CornerRadius="16">
                                <Border Background="{StaticResource KomikWrappedBrush}" CornerRadius="16" BorderBrush="#000000" BorderThickness="2" />
                                <Border Background="{StaticResource KomikSpeedLinesBrush}" CornerRadius="16" Opacity="0.06" />
                                <Border Background="{StaticResource KomikHalftoneBrush}" CornerRadius="16" Opacity="0.18" />
                                <Grid Padding="30,24" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8" VerticalAlignment="Center">
                                        <Border Style="{StaticResource ComicStickerStyle}" Background="#FF1F6D" BorderBrush="#000000" HorizontalAlignment="Left">
                                            <TextBlock Text="KOMIK WRAPPED" Style="{StaticResource ComicStickerTextStyle}" Foreground="White" />
                                        </Border>
                                        <Grid>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.YearHeadline, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="46" LineHeight="48" Foreground="#000000" Margin="3,3,0,0" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.YearHeadline, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="46" LineHeight="48" Foreground="#FFD700" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Background="#26FFFFFF" CornerRadius="10" Padding="12,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE82D;" FontSize="12" Foreground="#00C2FF" />
                                                    <TextBlock Text="{x:Bind ViewModel.StatsSummary.YearPagesDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="White" />
                                                    <TextBlock Text="pages" Foreground="#C9C3E6" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#26FFFFFF" CornerRadius="10" Padding="12,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="#FFD700" />
                                                    <TextBlock Text="{x:Bind ViewModel.StatsSummary.FormattedYearTime, Mode=OneWay}" FontWeight="Bold" Foreground="White" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#26FFFFFF" CornerRadius="10" Padding="12,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#2EE59D" />
                                                    <TextBlock Text="{x:Bind ViewModel.StatsSummary.YearComicsFinished, Mode=OneWay}" FontWeight="Bold" Foreground="White" />
                                                    <TextBlock Text="finished" Foreground="#C9C3E6" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Most-read series:" Foreground="#C9C3E6" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.YearTopSeriesName, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="· Busiest day:" Foreground="#C9C3E6" FontSize="13" Margin="6,0,0,0" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.BusiestDayLabel, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Streak burst -->
                                    <Grid Grid.Column="1" Width="150" Height="150" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="-8" CenterX="75" CenterY="75" />
                                        </Grid.RenderTransform>
                                        <Ellipse Fill="#000000" Margin="6,6,-6,-6" />
                                        <Ellipse Fill="#FFD700" Stroke="#000000" StrokeThickness="3" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.CurrentDailyStreak, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="62" LineHeight="60" Foreground="#0B0B12" HorizontalAlignment="Center" />
                                            <TextBlock Text="DAY STREAK" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" CharacterSpacing="80" Foreground="#0B0B12" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- KPI tiles -->
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentControl Grid.Column="0" Grid.Row="0" Style="{StaticResource ComicPanelStyle}" Padding="0" helpers:MotionHelper.HoverLift="True">
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#FFD700" CornerRadius="10,10,0,0" />
                                        <StackPanel Padding="16,16,14,14" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="#FFD700" />
                                                <TextBlock Text="TIME READING" Style="{StaticResource ComicCaptionTextStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.FormattedTotalTime, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="34" LineHeight="38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.SessionsDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Grid.Column="1" Grid.Row="0" Style="{StaticResource ComicPanelStyle}" Padding="0" helpers:MotionHelper.HoverLift="True">
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#00C2FF" CornerRadius="10,10,0,0" />
                                        <StackPanel Padding="16,16,14,14" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE82D;" FontSize="14" Foreground="#00C2FF" />
                                                <TextBlock Text="PAGES READ" Style="{StaticResource ComicCaptionTextStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.TotalPagesDisplay, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="34" LineHeight="38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.PagesPerHourDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Grid.Column="2" Grid.Row="0" Style="{StaticResource ComicPanelStyle}" Padding="0" helpers:MotionHelper.HoverLift="True">
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#2EE59D" CornerRadius="10,10,0,0" />
                                        <StackPanel Padding="16,16,14,14" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#2EE59D" />
                                                <TextBlock Text="COMICS FINISHED" Style="{StaticResource ComicCaptionTextStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.ComicsCompletedDisplay, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="34" LineHeight="38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.DistinctComicsDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Grid.Column="3" Grid.Row="0" Style="{StaticResource ComicPanelStyle}" Padding="0" helpers:MotionHelper.HoverLift="True">
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#FF1F6D" CornerRadius="10,10,0,0" />
                                        <StackPanel Padding="16,16,14,14" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE945;" FontSize="14" Foreground="#FF1F6D" />
                                                <TextBlock Text="BEST STREAK" Style="{StaticResource ComicCaptionTextStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.LongestStreakDisplay, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="34" LineHeight="38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.ActiveDaysDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Grid.Column="0" Grid.Row="1" Style="{StaticResource ComicPanelStyle}" Padding="0" helpers:MotionHelper.HoverLift="True">
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#FF9F1C" CornerRadius="10,10,0,0" />
                                        <StackPanel Padding="16,16,14,14" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="#FF9F1C" />
                                                <TextBlock Text="PAGES TODAY" Style="{StaticResource ComicCaptionTextStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.TodayPagesDisplay, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="34" LineHeight="38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.FormattedTodayTime, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Grid.Column="1" Grid.Row="1" Style="{StaticResource ComicPanelStyle}" Padding="0" helpers:MotionHelper.HoverLift="True">
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#FF9F1C" CornerRadius="10,10,0,0" />
                                        <StackPanel Padding="16,16,14,14" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8BF;" FontSize="14" Foreground="#FF9F1C" />
                                                <TextBlock Text="THIS WEEK" Style="{StaticResource ComicCaptionTextStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.WeekPagesDisplay, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="34" LineHeight="38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.FormattedWeekTime, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Grid.Column="2" Grid.Row="1" Style="{StaticResource ComicPanelStyle}" Padding="0" helpers:MotionHelper.HoverLift="True">
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#FF9F1C" CornerRadius="10,10,0,0" />
                                        <StackPanel Padding="16,16,14,14" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="#FF9F1C" />
                                                <TextBlock Text="THIS MONTH" Style="{StaticResource ComicCaptionTextStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.MonthPagesDisplay, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="34" LineHeight="38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.FormattedMonthTime, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Grid.Column="3" Grid.Row="1" Style="{StaticResource ComicPanelStyle}" Padding="0" helpers:MotionHelper.HoverLift="True">
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#FF9F1C" CornerRadius="10,10,0,0" />
                                        <StackPanel Padding="16,16,14,14" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="#FF9F1C" />
                                                <TextBlock Text="AVG. SESSION" Style="{StaticResource ComicCaptionTextStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.AverageSessionDisplay, Mode=OneWay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="34" LineHeight="38" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.FavoriteTimeOfDay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                            </Grid>

                            <!-- Charts -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Style="{StaticResource ComicPanelStyle}" Padding="20">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="LAST 30 DAYS" Style="{StaticResource ComicSectionTitleStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.StatsSummary.Last30DaysPagesDisplay, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.StatsSummary.Last30Days, Mode=OneWay}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DailyReadingActivity">
                                                    <Grid Width="16" Height="122" ToolTipService.ToolTip="{x:Bind ToolTipText}" Background="Transparent">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="104" />
                                                            <RowDefinition Height="18" />
                                                        </Grid.RowDefinitions>
                                                        <Rectangle RadiusX="4" RadiusY="4" Fill="{ThemeResource KomikChartTrackBrush}" />
                                                        <Rectangle Height="{x:Bind BarHeight}" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4" Fill="{ThemeResource KomikCyanBrush}" />
                                                        <Rectangle Height="{x:Bind BarHeight}" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4" Fill="{ThemeResource KomikYellowBrush}" Visibility="{x:Bind IsToday, Converter={StaticResource BoolToVisConverter}}" />
                                                        <TextBlock Grid.Row="1" Text="{x:Bind DayLabel}" FontSize="9" Foreground="{ThemeResource KomikSubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Grid.Column="1" Style="{StaticResource ComicPanelStyle}" Padding="20">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="READING HABITS" Style="{StaticResource ComicSectionTitleStyle}" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.StatsSummary.HourlyActivity, Mode=OneWay}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:HourlyReadingActivity">
                                                    <Grid Width="8" Height="76" ToolTipService.ToolTip="{x:Bind ToolTipText}" Background="Transparent">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="60" />
                                                            <RowDefinition Height="16" />
                                                        </Grid.RowDefinitions>
                                                        <Rectangle RadiusX="3" RadiusY="3" Fill="{ThemeResource KomikChartTrackBrush}" />
                                                        <Rectangle Height="{x:Bind BarHeight}" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3" Fill="{ThemeResource KomikMagentaBrush}" />
                                                        <TextBlock Grid.Row="1" Text="{x:Bind Label}" FontSize="8" Foreground="{ThemeResource KomikSubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="NoWrap" Margin="-12,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid RowSpacing="8" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Favorite day" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatsSummary.FavoriteWeekday, Mode=OneWay}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Text="Reader type" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.StatsSummary.FavoriteTimeOfDay, Mode=OneWay}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="2" Text="Library finished" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.StatsSummary.LibraryCompletionDisplay, Mode=OneWay}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind ViewModel.StatsSummary.LibraryCompletion, Mode=OneWay}" Maximum="1" Height="6" CornerRadius="3" Foreground="{ThemeResource KomikGreenBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsSummary.LibraryBreakdownDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ContentControl>
                            </Grid>

                            <!-- Top series + recently read -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Style="{StaticResource ComicPanelStyle}" Padding="20">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="TOP SERIES" Style="{StaticResource ComicSectionTitleStyle}" />
                                                <TextBlock Text="The series and books you have read the most, ranked by pages read. Each row shows your reading time, how many of its books you opened and finished, and when you last read it." FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource ComicStickerStyle}" VerticalAlignment="Top" Padding="7,0" ToolTipService.ToolTip="Grouped the same way as the Series screen, including your manual series">
                                                <TextBlock Text="ALL TIME" Style="{StaticResource ComicStickerTextStyle}" FontSize="12" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Nothing read yet. Open a comic and your top series appear here." FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" Visibility="{x:Bind ViewModel.StatsSummary.HasNoReadingData, Mode=OneWay, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.StatsSummary.TopSeries, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeriesReadingStat">
                                                    <Grid Padding="12,10" Margin="0,0,0,10" CornerRadius="12" Background="{ThemeResource KomikPanelSunkenBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1,1,2.5,2.5" ColumnSpacing="14" ToolTipService.ToolTip="{x:Bind ToolTipText}" helpers:MotionHelper.HoverLift="True">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind RankDisplay}" Style="{StaticResource ComicDisplayTextStyle}" FontSize="30" VerticalAlignment="Center" Foreground="{ThemeResource KomikYellowBrush}" />
                                                        <Grid Grid.Column="1" Width="46" Height="66" CornerRadius="6" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="1.5">
                                                            <Border Background="{ThemeResource KomikPanelRaisedBrush}" />
                                                            <Image Source="{x:Bind CoverThumbnailPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border CornerRadius="4" Padding="5,0" Background="{ThemeResource KomikCyanBrush}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind KindLabel}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="11" CharacterSpacing="40" Foreground="#0B0B12" />
                                                                </Border>
                                                                <TextBlock Text="{x:Bind SeriesName}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind BooksDisplay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressBar Value="{x:Bind SeriesCompletion}" Maximum="1" Height="6" MinHeight="6" CornerRadius="3" VerticalAlignment="Center" Foreground="{ThemeResource KomikGreenBrush}" Background="{ThemeResource KomikChartTrackBrush}" ToolTipService.ToolTip="{x:Bind SeriesPagesDisplay}" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind SeriesCompletionDisplay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource KomikGreenBrush}" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" MinWidth="104">
                                                            <TextBlock Text="{x:Bind FormattedPagesRead}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource KomikCyanBrush}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{x:Bind FormattedDuration}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{x:Bind LastReadDisplay}" FontSize="10" Foreground="{ThemeResource KomikSubtleTextBrush}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Grid.Column="1" Style="{StaticResource ComicPanelStyle}" Padding="20" VerticalAlignment="Top">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="RECENTLY READ" Style="{StaticResource ComicSectionTitleStyle}" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.StatsSummary.RecentlyRead, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:RecentlyReadComic">
                                                    <Button
                                                        Click="RecentlyRead_Click"
                                                        Tag="{x:Bind ComicId}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="8"
                                                        Margin="0,0,0,6"
                                                        Background="{ThemeResource KomikPanelSunkenBrush}"
                                                        BorderThickness="0"
                                                        CornerRadius="10">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="38" Height="54" CornerRadius="4">
                                                                <Border Background="{ThemeResource KomikPanelRaisedBrush}" />
                                                                <Image Source="{x:Bind ThumbnailPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <ProgressBar Value="{x:Bind Progress}" Maximum="1" Height="4" Foreground="{ThemeResource KomikYellowBrush}" />
                                                                <Grid>
                                                                    <TextBlock Text="{x:Bind ProgressDisplay}" FontSize="10" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                                    <TextBlock Text="{x:Bind LastReadDisplay}" FontSize="10" Foreground="{ThemeResource KomikSubtleTextBrush}" HorizontalAlignment="Right" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ContentControl>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ==================== CREATE SERIES / CREATOR COLLECTION OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="130"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsCreateSeriesDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ContentControl Style="{StaticResource ComicModalPanelStyle}" MaxWidth="1320" Margin="18,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="12" Padding="22,16,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Style="{StaticResource ComicStickerStyle}" Background="#FF1F6D" BorderBrush="#0B0B12" Padding="7,0">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-5" />
                                </Border.RenderTransform>
                                <TextBlock Text="NEW!" Style="{StaticResource ComicStickerTextStyle}" Foreground="White" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.NewSeriesDialogTitle, Mode=OneWay}" Style="{StaticResource ComicSectionTitleStyle}" FontSize="26" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ComicIconButtonStyle}" Command="{x:Bind ViewModel.CloseCreateSeriesDialogCommand}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close dialog">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Kind, name, smart pick, auto-update: one compact row -->
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="14" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2,2,3,3" Background="{ThemeResource KomikPanelSunkenBrush}" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton x:Name="NewKindStoryToggle" IsChecked="{x:Bind ViewModel.NewSeriesIsStory, Mode=OneWay}" Click="NewKindStory_Click" CornerRadius="11" Height="38" Padding="12,0" AutomationProperties.Name="Continuation series" ToolTipService.ToolTip="One story across books: issues, volumes, parts, sequels">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="13" />
                                        <TextBlock Text="SERIES" FontFamily="{StaticResource KomikDisplayFont}" FontSize="16" CharacterSpacing="40" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="NewKindCreatorToggle" IsChecked="{x:Bind ViewModel.NewSeriesIsCreator, Mode=OneWay}" Click="NewKindCreator_Click" CornerRadius="11" Height="38" Padding="12,0" AutomationProperties.Name="Creator collection" ToolTipService.ToolTip="Everything by one author, artist or circle">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE77B;" FontSize="13" />
                                        <TextBlock Text="CREATOR" FontFamily="{StaticResource KomikDisplayFont}" FontSize="16" CharacterSpacing="40" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                        <TextBox
                            Grid.Column="1"
                            FontSize="15"
                            MinHeight="40"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Name"
                            PlaceholderText="{x:Bind ViewModel.NewSeriesNamePlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.NewSeriesName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Style="{StaticResource ComicAccentButtonStyle}" MinHeight="40" Command="{x:Bind ViewModel.SmartSelectCandidatesCommand}" ToolTipService.ToolTip="Select every comic whose title or credited creator matches the name" AutomationProperties.Name="{x:Bind ViewModel.NewSeriesSmartPickText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="14" />
                                <TextBlock x:Name="SmartPickLabel" Text="Smart pick" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="3" Style="{StaticResource ComicPillStyle}" CornerRadius="12" Padding="10,0,4,0" VerticalAlignment="Center" ToolTipService.ToolTip="Keep adding new comics that belong to it when your library changes. Removing a comic by hand keeps it out.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{ThemeResource KomikCyanBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Auto-update" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.NewSeriesAutoUpdate, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" Margin="6,-2,0,-2" AutomationProperties.Name="Auto-update" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Picker toolbar -->
                    <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource ComicStickerStyle}" Padding="8,1">
                            <TextBlock Text="{x:Bind ViewModel.SelectedCandidateCountDisplay, Mode=OneWay}" Style="{StaticResource ComicStickerTextStyle}" />
                        </Border>
                        <AutoSuggestBox Grid.Column="1" QueryIcon="Find" PlaceholderText="Search title, number, creator or folder..." Text="{x:Bind ViewModel.ManualSeriesSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2" MinWidth="150" ItemsSource="{x:Bind ViewModel.CandidateSortOptions}" SelectedIndex="{x:Bind ViewModel.CandidateSortIndex, Mode=TwoWay}" ToolTipService.ToolTip="Sort comics" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                            <Button Padding="10,5" Command="{x:Bind ViewModel.SelectAllCandidatesCommand}" ToolTipService.ToolTip="Pick every comic currently shown">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B3;" FontSize="12" />
                                    <TextBlock Text="Pick shown" />
                                </StackPanel>
                            </Button>
                            <Button Padding="10,5" Command="{x:Bind ViewModel.ClearCandidateSelectionCommand}" ToolTipService.ToolTip="Clear the selection">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE894;" FontSize="12" />
                                    <TextBlock Text="Clear" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListView Style="{StaticResource ComicChipBarStyle}" ItemsSource="{x:Bind ViewModel.CandidateStatusFilters}" SelectedItem="{x:Bind ViewModel.CandidateStatusFilter, Mode=TwoWay}" AutomationProperties.Name="Comic filter" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}">
                                <Run Text="{x:Bind ViewModel.CandidateShownDisplay, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" · " />
                                <Run Text="{x:Bind ViewModel.CandidateScopeNote, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- Comics -->
                    <Grid Grid.Row="3" CornerRadius="12" Background="{ThemeResource KomikPanelSunkenBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1">
                        <GridView
                            Padding="10,10,4,10"
                            ItemsSource="{x:Bind ViewModel.FilteredCandidates, Mode=OneWay}"
                            ItemTemplate="{StaticResource CandidateCardTemplate}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="CandidateGrid_ItemClick" />
                        <TextBlock Text="{x:Bind ViewModel.CandidatesEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNoCandidates, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" Margin="24" />
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ComicGhostButtonStyle}" Content="Cancel" Command="{x:Bind ViewModel.CloseCreateSeriesDialogCommand}" />
                        <TextBlock Grid.Column="1" Text="Comics are put in reading order automatically." FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Style="{StaticResource ComicPrimaryButtonStyle}" Command="{x:Bind ViewModel.SaveManualSeriesCommand}" MinWidth="150" AutomationProperties.Name="CREATE">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="CREATE" FontFamily="{StaticResource KomikDisplayFont}" FontSize="18" CharacterSpacing="60" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ==================== ADD COMICS TO EXISTING SERIES OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="135"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsAddComicsToSeriesDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ContentControl Style="{StaticResource ComicModalPanelStyle}" MaxWidth="1320" Margin="18,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="12" Padding="22,16,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="46" Height="66" CornerRadius="8" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2" Background="{ThemeResource KomikPanelSunkenBrush}">
                            <Image Source="{x:Bind ViewModel.SelectedSeriesGroup.CoverThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource ComicStickerStyle}" Background="#00C2FF" BorderBrush="#0B0B12" Padding="7,0">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-4" />
                                    </Border.RenderTransform>
                                    <TextBlock Text="ADD" Style="{StaticResource ComicStickerTextStyle}" Foreground="#0B0B12" />
                                </Border>
                                <TextBlock Text="ADD COMICS" Style="{StaticResource ComicSectionTitleStyle}" FontSize="26" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedSeriesGroup.SeriesName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ComicIconButtonStyle}" VerticalAlignment="Top" Command="{x:Bind ViewModel.CloseAddComicsToSeriesDialogCommand}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close dialog">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource ComicStickerStyle}" Padding="8,1">
                            <TextBlock Text="{x:Bind ViewModel.SelectedCandidateCountDisplay, Mode=OneWay}" Style="{StaticResource ComicStickerTextStyle}" />
                        </Border>
                        <AutoSuggestBox Grid.Column="1" QueryIcon="Find" PlaceholderText="Search title, number, creator or folder..." Text="{x:Bind ViewModel.ManualSeriesSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2" MinWidth="150" ItemsSource="{x:Bind ViewModel.CandidateSortOptions}" SelectedIndex="{x:Bind ViewModel.CandidateSortIndex, Mode=TwoWay}" ToolTipService.ToolTip="Sort comics" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                            <Button Padding="10,5" Command="{x:Bind ViewModel.SelectAllCandidatesCommand}" ToolTipService.ToolTip="Pick every comic currently shown">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B3;" FontSize="12" />
                                    <TextBlock Text="Pick shown" />
                                </StackPanel>
                            </Button>
                            <Button Padding="10,5" Command="{x:Bind ViewModel.ClearCandidateSelectionCommand}" ToolTipService.ToolTip="Clear the selection">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE894;" FontSize="12" />
                                    <TextBlock Text="Clear" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListView Style="{StaticResource ComicChipBarStyle}" ItemsSource="{x:Bind ViewModel.CandidateStatusFilters}" SelectedItem="{x:Bind ViewModel.CandidateStatusFilter, Mode=TwoWay}" AutomationProperties.Name="Comic filter" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}">
                                <Run Text="{x:Bind ViewModel.CandidateShownDisplay, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" · " />
                                <Run Text="{x:Bind ViewModel.CandidateScopeNote, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" CornerRadius="12" Background="{ThemeResource KomikPanelSunkenBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1">
                        <GridView
                            Padding="10,10,4,10"
                            ItemsSource="{x:Bind ViewModel.FilteredCandidates, Mode=OneWay}"
                            ItemTemplate="{StaticResource CandidateCardTemplate}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="CandidateGrid_ItemClick" />
                        <TextBlock Text="{x:Bind ViewModel.CandidatesEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNoCandidates, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" Margin="24" />
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ComicGhostButtonStyle}" Content="Cancel" Command="{x:Bind ViewModel.CloseAddComicsToSeriesDialogCommand}" />
                        <TextBlock Grid.Column="1" Text="New comics slot into reading order." FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <Button Grid.Column="2" Style="{StaticResource ComicPrimaryButtonStyle}" Command="{x:Bind ViewModel.SaveComicsToExistingSeriesCommand}" MinWidth="170" AutomationProperties.Name="Add to Series">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="ADD TO SERIES" FontFamily="{StaticResource KomikDisplayFont}" FontSize="18" CharacterSpacing="50" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ==================== EDIT SERIES OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="136"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsEditSeriesDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ContentControl Style="{StaticResource ComicModalPanelStyle}" MaxWidth="1040" Margin="18,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="12" Padding="22,16,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource ComicStickerStyle}" Background="#2EE59D" BorderBrush="#0B0B12" Padding="7,0">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-5" />
                                    </Border.RenderTransform>
                                    <TextBlock Text="EDIT" Style="{StaticResource ComicStickerTextStyle}" Foreground="#0B0B12" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.EditSeriesTitle, Mode=OneWay}" Style="{StaticResource ComicSectionTitleStyle}" FontSize="26" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.EditSeriesHint, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ComicIconButtonStyle}" VerticalAlignment="Top" Command="{x:Bind ViewModel.CloseEditSeriesCommand}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close dialog">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="104" Height="150" CornerRadius="10" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2.5,2.5,4,4" Background="{ThemeResource KomikPanelSunkenBrush}" ToolTipService.ToolTip="Cover: pick one with the star in the list">
                            <FontIcon Glyph="&#xE8B9;" FontSize="26" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                            <Image Source="{x:Bind ViewModel.EditSeriesCoverPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                            <Border Style="{StaticResource ComicStickerStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" Padding="5,0">
                                <TextBlock Text="COVER" Style="{StaticResource ComicStickerTextStyle}" FontSize="11" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <TextBox Header="Name" FontSize="15" AutomationProperties.Name="Series name" Text="{x:Bind ViewModel.EditSeriesName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <helpers:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                                <Border CornerRadius="14" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2,2,3,3" Background="{ThemeResource KomikPanelSunkenBrush}" Padding="3" ToolTipService.ToolTip="{x:Bind ViewModel.EditSeriesKindToolTip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <ToggleButton x:Name="EditKindStoryToggle" IsChecked="{x:Bind ViewModel.EditSeriesIsStory, Mode=OneWay}" Click="EditKindStory_Click" CornerRadius="11" Height="36" Padding="12,0" AutomationProperties.Name="Continuation series section">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="13" />
                                                <TextBlock Text="CONTINUATION SERIES" FontFamily="{StaticResource KomikDisplayFont}" FontSize="15" CharacterSpacing="40" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="EditKindCreatorToggle" IsChecked="{x:Bind ViewModel.EditSeriesIsCreator, Mode=OneWay}" Click="EditKindCreator_Click" IsEnabled="{x:Bind ViewModel.EditSeriesCanBeCreator, Mode=OneWay}" CornerRadius="11" Height="36" Padding="12,0" AutomationProperties.Name="By creator section">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="{x:Bind ViewModel.EditSeriesCreatorGlyph, Mode=OneWay}" FontSize="13" />
                                                <TextBlock Text="BY CREATOR" FontFamily="{StaticResource KomikDisplayFont}" FontSize="15" CharacterSpacing="40" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ComicPillStyle}" CornerRadius="12" Padding="10,2,4,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{ThemeResource KomikCyanBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Auto-update" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        <ToggleSwitch IsOn="{x:Bind ViewModel.EditSeriesAutoUpdate, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" Margin="6,-2,0,-2" AutomationProperties.Name="Auto-update" />
                                    </StackPanel>
                                </Border>
                            </helpers:WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasEditSeriesKindHint, Mode=OneWay}">
                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.EditSeriesKindHint, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="READING ORDER" Style="{StaticResource ComicSectionTitleStyle}" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind ViewModel.EditSeriesCountDisplay, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="  ·  drag to reorder, or use the arrows  " />
                            <Run Text="{x:Bind ViewModel.EditSeriesRemovedDisplay, Mode=OneWay}" Foreground="{ThemeResource KomikMagentaBrush}" />
                        </TextBlock>
                        <Button Grid.Column="2" Padding="10,5" Command="{x:Bind ViewModel.SortEditItemsAutomaticallyCommand}" ToolTipService.ToolTip="Put the comics in reading order automatically">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                                <TextBlock Text="Auto order" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="EditSeriesList"
                        Grid.Row="3"
                        ItemsSource="{x:Bind ViewModel.EditSeriesItems, Mode=OneWay}"
                        SelectionMode="None"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True"
                        DragItemsCompleted="EditSeriesList_DragItemsCompleted"
                        CornerRadius="12"
                        Padding="6"
                        Background="{ThemeResource KomikPanelSunkenBrush}"
                        BorderBrush="{ThemeResource KomikPanelStrokeBrush}"
                        BorderThickness="1">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EditSeriesComicItem">
                                <Grid ColumnSpacing="12" Padding="6" CornerRadius="10" Background="{ThemeResource KomikPanelBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1,1,2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE76F;" FontSize="14" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Drag to move" />
                                    <Border Grid.Column="1" Style="{StaticResource ComicStickerStyle}" MinWidth="44" Padding="6,0">
                                        <TextBlock Text="{x:Bind PositionDisplay, Mode=OneWay}" Style="{StaticResource ComicStickerTextStyle}" HorizontalAlignment="Center" />
                                    </Border>
                                    <Grid Grid.Column="2" Width="38" Height="54" CornerRadius="5" Background="{ThemeResource KomikPanelSunkenBrush}">
                                        <Image Source="{x:Bind Comic.ThumbnailPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Comic.Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Comic.Title}" />
                                        <TextBlock FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind Comic.FormatBadge}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Comic.PageCountFormatted}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Comic.ProgressText}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ComicIconButtonStyle}" Click="EditItemCover_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Use as the series cover" AutomationProperties.Name="Use as cover">
                                            <Grid>
                                                <FontIcon Glyph="&#xE734;" FontSize="14" Visibility="{x:Bind IsCover, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}" />
                                                <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource KomikOrangeBrush}" Visibility="{x:Bind IsCover, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ComicIconButtonStyle}" Click="EditItemUp_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Move up" AutomationProperties.Name="Move up">
                                            <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource ComicIconButtonStyle}" Click="EditItemDown_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Move down" AutomationProperties.Name="Move down">
                                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource ComicIconButtonStyle}" Click="EditItemRemove_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Remove from this series (the comic stays in your library)" AutomationProperties.Name="Remove from series">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource KomikMagentaBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ComicGhostButtonStyle}" Content="Cancel" Command="{x:Bind ViewModel.CloseEditSeriesCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ComicPrimaryButtonStyle}" Command="{x:Bind ViewModel.SaveEditSeriesCommand}" MinWidth="150" AutomationProperties.Name="Save series">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                <TextBlock Text="SAVE" FontFamily="{StaticResource KomikDisplayFont}" FontSize="18" CharacterSpacing="60" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ==================== MANAGE TAGS OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="140"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsManageTagsOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ContentControl Style="{StaticResource ComicModalPanelStyle}" MaxWidth="1100" Margin="18,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid CornerRadius="16,16,0,0">
                        <Border Background="{ThemeResource KomikHeroBrush}" />
                        <Border Background="{StaticResource KomikHalftoneBrush}" Opacity="0.12" />
                        <Grid Padding="24,16,18,16" ColumnSpacing="14" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource ComicStickerStyle}" Background="#FF1F6D" BorderBrush="#0B0B12" Padding="7,0">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-5" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="LABELS" Style="{StaticResource ComicStickerTextStyle}" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="MANAGE TAGS" Style="{StaticResource ComicDisplayTextStyle}" FontSize="32" LineHeight="34" Foreground="{ThemeResource KomikWordmarkBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TagSummaryDisplay, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource KomikHeroTaglineBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ComicIconButtonStyle}" VerticalAlignment="Top" Command="{x:Bind ViewModel.CloseManageTagsCommand}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close dialog">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewTagBox" FontSize="14" MinHeight="40" PlaceholderText="New tag name (e.g. Manga, Superhero, Favorites 2026)..." AutomationProperties.Name="New tag name" Text="{x:Bind ViewModel.NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewTagBox_KeyDown" />
                                <Button Grid.Column="1" Style="{StaticResource ComicPrimaryButtonStyle}" MinHeight="40" Command="{x:Bind ViewModel.CreateManagedTagCommand}" IsEnabled="{x:Bind ViewModel.CanCreateManagedTag, Mode=OneWay}" AutomationProperties.Name="Create tag">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                                        <TextBlock Text="CREATE TAG" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" CharacterSpacing="50" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Toolbar -->
                    <Grid Grid.Row="1" Padding="22,0,22,0" ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox QueryIcon="Find" PlaceholderText="Search tags..." Text="{x:Bind ViewModel.ManageTagSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search tags" />
                        <ComboBox Grid.Column="1" MinWidth="150" ItemsSource="{x:Bind ViewModel.TagSortOptions}" SelectedIndex="{x:Bind ViewModel.ManageTagSortIndex, Mode=TwoWay}" ToolTipService.ToolTip="Sort tags" />
                        <Button Grid.Column="2" Style="{StaticResource ComicDangerButtonStyle}" Visibility="{x:Bind ViewModel.HasUnusedTags, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Click="DeleteUnusedTags_Click" ToolTipService.ToolTip="Delete every tag that no comic uses">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.DeleteUnusedTagsText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListView Style="{StaticResource ComicChipBarStyle}" ItemsSource="{x:Bind ViewModel.TagUsageFilters}" SelectedItem="{x:Bind ViewModel.ManageTagUsageFilter, Mode=TwoWay}" AutomationProperties.Name="Tag usage filter" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ManageTagShownDisplay, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>

                    <!-- Tag cards -->
                    <Grid Grid.Row="2" Margin="22,0,22,20" CornerRadius="12" Background="{ThemeResource KomikPanelSunkenBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1">
                        <GridView
                            Padding="10,10,4,10"
                            ItemsSource="{x:Bind ViewModel.ManageTagItems, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="ManageTagItem_Click">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:TagChipItem">
                                    <Grid Width="286" Height="66" Padding="10,8" CornerRadius="12" Background="{ThemeResource KomikPanelBrush}" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="1.5,1.5,3,3" ColumnSpacing="10" ToolTipService.ToolTip="Click to show the comics with this tag">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                                            <Ellipse Fill="#FFD700" Stroke="#0B0B12" StrokeThickness="2" Visibility="{x:Bind IsUnused, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}" />
                                            <Ellipse Fill="{ThemeResource KomikPanelSunkenBrush}" Stroke="{ThemeResource KomikInkStrokeBrush}" StrokeThickness="2" StrokeDashArray="2,1.5" Visibility="{x:Bind IsUnused, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                            <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="#0B0B12" Visibility="{x:Bind IsUnused, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}" />
                                            <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="{ThemeResource KomikSubtleTextBrush}" Visibility="{x:Bind IsUnused, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind CountDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ComicIconButtonStyle}" Click="RenameTag_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Rename (use an existing name to merge)" AutomationProperties.Name="Rename tag">
                                                <FontIcon Glyph="&#xE8AC;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource ComicIconButtonStyle}" Click="DeleteTag_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Delete tag" AutomationProperties.Name="Delete tag">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource KomikMagentaBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.HasManageTagResults, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}">
                            <FontIcon Glyph="&#xE8EC;" FontSize="40" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ManageTagEmptyText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ==================== COMIC TAGS OVERLAY ==================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Canvas.ZIndex="145"
            Background="{ThemeResource ModalScrimBrush}"
            Visibility="{x:Bind ViewModel.IsComicTagsOpen, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ContentControl Style="{StaticResource ComicModalPanelStyle}" MaxWidth="940" MaxHeight="820" Margin="18,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header with the comic -->
                    <Grid CornerRadius="16,16,0,0">
                        <Border Background="{ThemeResource KomikHeroBrush}" />
                        <Border Background="{StaticResource KomikHalftoneBrush}" Opacity="0.12" />
                        <Grid Padding="22,14,18,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="58" Height="82" CornerRadius="8" BorderBrush="#0B0B12" BorderThickness="2" Background="{ThemeResource KomikPanelSunkenBrush}">
                                <Image Source="{x:Bind ViewModel.TagEditingComic.ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource ComicStickerStyle}" Background="#00C2FF" BorderBrush="#0B0B12" Padding="7,0">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-5" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="TAGS" Style="{StaticResource ComicStickerTextStyle}" Foreground="#0B0B12" />
                                    </Border>
                                    <TextBlock Text="TAG THIS COMIC" Style="{StaticResource ComicDisplayTextStyle}" FontSize="30" LineHeight="32" Foreground="{ThemeResource KomikWordmarkBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TagEditingComic.Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource KomikHeroTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource ComicIconButtonStyle}" VerticalAlignment="Top" Command="{x:Bind ViewModel.CloseComicTagsCommand}" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close dialog">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Tags already on the comic -->
                    <StackPanel Grid.Row="1" Padding="22,0" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.ComicTagCountDisplay, Mode=OneWay}" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="No tags yet. Click a tag below or type a new one." FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" Visibility="{x:Bind ViewModel.ComicHasNoTags, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ComicAssignedTags, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TagChipItem">
                                        <Button Click="ComicTagChip_Click" Tag="{x:Bind}" Padding="10,4,8,4" CornerRadius="14" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="2,2,3,3" ToolTipService.ToolTip="Remove this tag" AutomationProperties.Name="{x:Bind Name}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#0B0B12" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                                <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="#0B0B12" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Search, create, filter -->
                    <Grid Grid.Row="2" Padding="22,0" ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ComicTagSearchBox" FontSize="14" MinHeight="40" PlaceholderText="Search tags, or type a new one and press Enter..." AutomationProperties.Name="Search or create tag" Text="{x:Bind ViewModel.ComicTagSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="ComicTagSearchBox_KeyDown" />
                        <ComboBox Grid.Column="1" MinWidth="150" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.TagSortOptions}" SelectedIndex="{x:Bind ViewModel.ComicTagSortIndex, Mode=TwoWay}" ToolTipService.ToolTip="Sort tags" />
                        <Button Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Style="{StaticResource ComicAccentButtonStyle}" Visibility="{x:Bind ViewModel.CanCreateTagFromSearch, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Command="{x:Bind ViewModel.CreateTagFromSearchCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.CreateTagFromSearchText, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            </StackPanel>
                        </Button>
                        <ListView Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource ComicChipBarStyle}" ItemsSource="{x:Bind ViewModel.ComicTagScopes}" SelectedItem="{x:Bind ViewModel.ComicTagScope, Mode=TwoWay}" AutomationProperties.Name="Tag scope" />
                    </Grid>

                    <!-- All tags as chips -->
                    <Grid Grid.Row="3" Margin="22,0" CornerRadius="12" Background="{ThemeResource KomikPanelSunkenBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ComicTagItems, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TagChipItem">
                                        <Button Click="ComicTagChip_Click" Tag="{x:Bind}" Padding="0" CornerRadius="16" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{x:Bind Name}">
                                            <Grid>
                                                <Border CornerRadius="16" Padding="12,6" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2,2,3,3" Background="{ThemeResource KomikPanelBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Count, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border CornerRadius="16" Padding="12,6" BorderBrush="#0B0B12" BorderThickness="2,2,3,3" Background="#FFD700" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#0B0B12" />
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#0B0B12" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Count, Mode=OneWay}" FontSize="11" Foreground="#3A3A48" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{x:Bind ViewModel.ComicTagEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasComicTagResults, Mode=OneWay, Converter={StaticResource InvertedBoolToVisConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" Margin="24" />
                    </Grid>

                    <Grid Grid.Row="4" Padding="22,0,22,18" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Changes save instantly." FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ComicGhostButtonStyle}" Click="ManageTags_Click" ToolTipService.ToolTip="Rename or delete tags">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE713;" FontSize="12" />
                                <TextBlock Text="Manage Tags" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ComicPrimaryButtonStyle}" MinWidth="120" Command="{x:Bind ViewModel.CloseComicTagsCommand}" AutomationProperties.Name="Done">
                            <TextBlock Text="DONE" FontFamily="{StaticResource KomikDisplayFont}" FontSize="18" CharacterSpacing="60" />
                        </Button>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</Page>
