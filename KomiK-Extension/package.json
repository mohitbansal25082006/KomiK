{
  "name": "komik-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "KomiK Downloader: download comics from any website as CBZ with ComicInfo.xml metadata and tags for the Komik reader.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "package": "node scripts/build.mjs && node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "fflate": "^0.8.3",
    "framer-motion": "^13.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
