<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Komik.Controls.ComicToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Top"
    Visibility="Collapsed"
    IsTabStop="False"
    Canvas.ZIndex="2000">

    <!-- Floating comic caption box: overlays the page (never pushes content down) and hides itself after a few seconds -->
    <Grid
        x:Name="ToastRoot"
        MinWidth="300"
        MaxWidth="560"
        Margin="16,12,16,0"
        PointerEntered="ToastRoot_PointerEntered"
        PointerExited="ToastRoot_PointerExited">

        <!-- Hard ink shadow -->
        <Border Margin="6,6,0,0" CornerRadius="14" Background="{ThemeResource KomikShadowBrush}" />

        <Border
            x:Name="Face"
            Margin="0,0,6,6"
            CornerRadius="14"
            Background="{ThemeResource KomikPanelBrush}"
            BorderBrush="{ThemeResource KomikInkStrokeBrush}"
            BorderThickness="2.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource KomikHalftoneBrush}" Opacity="0.07" CornerRadius="12" Grid.RowSpan="2" />

                <Grid Padding="10,10,8,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Burst badge with the severity icon -->
                    <Grid Width="42" Height="42" VerticalAlignment="Center">
                        <Border x:Name="BadgeBurst" CornerRadius="21" BorderBrush="#0B0B12" BorderThickness="2.5" Background="#00C2FF" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="BadgeRotate" Angle="-8" />
                            </Border.RenderTransform>
                        </Border>
                        <FontIcon x:Name="BadgeIcon" Glyph="&#xE946;" FontSize="18" Foreground="#0B0B12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            x:Name="TitleText"
                            FontFamily="{StaticResource KomikDisplayFont}"
                            FontSize="19"
                            CharacterSpacing="40"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <TextBlock
                            x:Name="MessageText"
                            FontSize="12.5"
                            Foreground="{ThemeResource KomikSubtleTextBrush}"
                            TextWrapping="Wrap"
                            MaxLines="3"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        x:Name="CloseButton"
                        Click="CloseButton_Click"
                        VerticalAlignment="Top"
                        Width="28"
                        Height="28"
                        Padding="0"
                        CornerRadius="14"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="Dismiss notification"
                        ToolTipService.ToolTip="Dismiss">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>

                <!-- Countdown strip -->
                <Border Grid.Row="1" Height="4" Margin="12,0,12,8" CornerRadius="2" Background="{ThemeResource KomikChartTrackBrush}">
                    <Border x:Name="CountdownBar" HorizontalAlignment="Stretch" CornerRadius="2" Background="#00C2FF" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale" ScaleX="1" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
