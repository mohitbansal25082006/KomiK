<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Komik.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Komik.Models"
    xmlns:vm="using:Komik.ViewModels"
    xmlns:helpers="using:Komik.Helpers"
    xmlns:controls="using:Komik.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- One settings group: a comic panel with an inked edge and a hard shadow -->
        <Style x:Key="SettingsSectionPanel" TargetType="ContentControl" BasedOn="{StaticResource ComicPanelStyle}">
            <Setter Property="Padding" Value="20,16,20,18" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{ThemeResource KomikInkStrokeBrush}" />
            <Setter Property="helpers:MotionHelper.RevealOnShow" Value="True" />
        </Style>

        <!-- One setting: a soft tile holding the label and its control -->
        <Style x:Key="SettingTile" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource KomikPanelSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource KomikPanelStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource KomikSubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SettingsNavButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="2,2,3,3" />
            <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
        </Style>

        <Style x:Key="ReadingTileStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="250" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="2,2,4,4" />
            <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
        </Style>

        <Style x:Key="ThemeTileStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="2,2,4,4" />
            <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="28,10,28,16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavRail.Visibility" Value="Collapsed" />
                        <Setter Target="NavColumn.Width" Value="0" />
                        <Setter Target="PageRoot.Padding" Value="14,8,14,12" />
                        <Setter Target="HeaderTagline.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid MaxWidth="1180">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═════ Header banner ═════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MinHeight="76" helpers:MotionHelper.RevealOnShow="True">
                <Border Margin="5,5,0,0" CornerRadius="16" Background="{ThemeResource KomikShadowBrush}" />
                <Border Margin="0,0,5,5" CornerRadius="16" Background="{ThemeResource KomikHeroBrush}" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2.5" />
                <Border Margin="0,0,5,5" CornerRadius="16" Background="{StaticResource KomikHalftoneBrush}" Opacity="0.16" />
                <Border Margin="0,0,5,5" CornerRadius="16" Background="{StaticResource KomikSpeedLinesBrush}" Opacity="0.05" />

                <Grid Margin="0,0,5,5" Padding="16,10,20,10" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Click="BackButton_Click"
                        Style="{StaticResource ComicPrimaryButtonStyle}"
                        MinHeight="44"
                        Padding="12,6,16,6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Back to Library"
                        AutomationProperties.Name="Back to Library">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="LIBRARY" FontFamily="{StaticResource KomikDisplayFont}" FontSize="18" CharacterSpacing="50" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="SETTINGS" Style="{StaticResource ComicDisplayTextStyle}" FontSize="44" LineHeight="46" Foreground="{ThemeResource KomikWordmarkShadowBrush}" Margin="3,3,0,0" />
                            <TextBlock Text="SETTINGS" Style="{StaticResource ComicDisplayTextStyle}" FontSize="44" LineHeight="46" Foreground="{ThemeResource KomikWordmarkBrush}" />
                        </Grid>
                        <Border Style="{StaticResource ComicStickerStyle}" Background="#00C2FF" BorderBrush="#0B0B12" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-5" />
                            </Border.RenderTransform>
                            <TextBlock Text="MAKE IT YOURS" Style="{StaticResource ComicStickerTextStyle}" Foreground="#0B0B12" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        x:Name="HeaderTagline"
                        Grid.Column="2"
                        Text="Changes save automatically"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource KomikHeroTextBrush}"
                        Opacity="0.85"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═════ Section rail ═════ -->
                <StackPanel x:Name="NavRail" Spacing="8" helpers:MotionHelper.RevealOnShow="True">
                    <TextBlock Text="JUMP TO" Style="{StaticResource ComicCaptionTextStyle}" Margin="4,0,0,2" />
                    <Button Style="{StaticResource SettingsNavButton}" Click="NavAppearance_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="1.5"><FontIcon Glyph="&#xE790;" FontSize="13" Foreground="#0B0B12" /></Border>
                            <TextBlock Text="Appearance" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButton}" Click="NavReading_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#00C2FF" BorderBrush="#0B0B12" BorderThickness="1.5"><FontIcon Glyph="&#xE736;" FontSize="13" Foreground="#0B0B12" /></Border>
                            <TextBlock Text="Reading" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButton}" Click="NavFolders_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#2EE59D" BorderBrush="#0B0B12" BorderThickness="1.5"><FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="#0B0B12" /></Border>
                            <TextBlock Text="Library Folders" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButton}" Click="NavAddBack_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#B388FF" BorderBrush="#0B0B12" BorderThickness="1.5"><FontIcon Glyph="&#xE8F4;" FontSize="13" Foreground="#0B0B12" /></Border>
                            <TextBlock Text="Add Back Comics" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButton}" Click="NavCovers_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#FF9F1C" BorderBrush="#0B0B12" BorderThickness="1.5"><FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#0B0B12" /></Border>
                            <TextBlock Text="Covers &amp; Storage" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButton}" Click="NavBackup_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#FF1F6D" BorderBrush="#0B0B12" BorderThickness="1.5"><FontIcon Glyph="&#xEDE1;" FontSize="13" Foreground="White" /></Border>
                            <TextBlock Text="Backup" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButton}" Click="NavAbout_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource KomikPanelRaisedBrush}" BorderBrush="#0B0B12" BorderThickness="1.5"><FontIcon Glyph="&#xE946;" FontSize="13" /></Border>
                            <TextBlock Text="About Komik" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ═════ Sections ═════ -->
                <ScrollViewer x:Name="SettingsScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,8">

                        <!-- 1. APPEARANCE -->
                        <ContentControl x:Name="AppearanceSection" Style="{StaticResource SettingsSectionPanel}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="2"><FontIcon Glyph="&#xE790;" FontSize="17" Foreground="#0B0B12" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="APPEARANCE &amp; LIBRARY LAYOUT" Style="{StaticResource ComicSectionTitleStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="Theme, how the library looks, and its starting sort order." Style="{StaticResource SettingHint}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource SettingTile}">
                                    <StackPanel Spacing="10">
                                        <StackPanel>
                                            <TextBlock Text="Application Theme" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Every screen, button and popup is drawn for both light and dark." Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <helpers:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                                            <ToggleButton x:Name="ThemeSystemTile" Style="{StaticResource ThemeTileStyle}" Click="ThemeTile_Click" Tag="0" AutomationProperties.Name="Use system theme">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <Grid Width="56" Height="36" CornerRadius="6" BorderBrush="#0B0B12" BorderThickness="1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="#FFFDF6" />
                                                        <Border Grid.Column="1" Background="#17171F" />
                                                        <FontIcon Grid.ColumnSpan="2" Glyph="&#xE770;" FontSize="14" Foreground="#FFD700" />
                                                    </Grid>
                                                    <TextBlock Text="System" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="ThemeLightTile" Style="{StaticResource ThemeTileStyle}" Click="ThemeTile_Click" Tag="1" AutomationProperties.Name="Light theme">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <Border Width="56" Height="36" CornerRadius="6" Background="#FFFDF6" BorderBrush="#0B0B12" BorderThickness="1.5">
                                                        <FontIcon Glyph="&#xE706;" FontSize="16" Foreground="#E07B00" />
                                                    </Border>
                                                    <TextBlock Text="Light" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="ThemeDarkTile" Style="{StaticResource ThemeTileStyle}" Click="ThemeTile_Click" Tag="2" AutomationProperties.Name="Dark theme">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <Border Width="56" Height="36" CornerRadius="6" Background="#17171F" BorderBrush="#0B0B12" BorderThickness="1.5">
                                                        <FontIcon Glyph="&#xE708;" FontSize="15" Foreground="#FFD700" />
                                                    </Border>
                                                    <TextBlock Text="Dark" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </helpers:WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingTile}">
                                    <Grid ColumnSpacing="16" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Default Library View" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Cover cards or detailed list rows." Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.ViewModeIndex, Mode=TwoWay}" SelectionChanged="SettingChanged">
                                            <ComboBoxItem Content="Grid (Cover Cards)" />
                                            <ComboBoxItem Content="List (Details View)" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingTile}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Default Sort Order" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="How the library is sorted when it opens." Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.SortOptionIndex, Mode=TwoWay}" SelectionChanged="SettingChanged">
                                            <ComboBoxItem Content="Title (A to Z)" />
                                            <ComboBoxItem Content="Title (Z to A)" />
                                            <ComboBoxItem Content="Recently Read" />
                                            <ComboBoxItem Content="Date Added (Newest)" />
                                            <ComboBoxItem Content="Date Added (Oldest)" />
                                            <ComboBoxItem Content="Page Count (Most)" />
                                            <ComboBoxItem Content="File Size (Largest)" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 2. READING -->
                        <ContentControl x:Name="ReadingSection" Style="{StaticResource SettingsSectionPanel}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#00C2FF" BorderBrush="#0B0B12" BorderThickness="2"><FontIcon Glyph="&#xE736;" FontSize="17" Foreground="#0B0B12" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="READING DEFAULTS" Style="{StaticResource ComicSectionTitleStyle}" />
                                        <TextBlock Text="How every comic opens: sizing, direction and page colors." Style="{StaticResource SettingHint}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource SettingTile}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Default Fit Mode" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Fit to Height shows the whole page, Fit to Width fills the screen, Actual Size shows original pixels." Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.FitModeIndex, Mode=TwoWay}" SelectionChanged="SettingChanged">
                                            <ComboBoxItem Content="Fit to Width" />
                                            <ComboBoxItem Content="Fit to Height" />
                                            <ComboBoxItem Content="Actual Size (100%)" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingTile}">
                                    <StackPanel Spacing="12">
                                        <StackPanel>
                                            <TextBlock Text="How Comics Open" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Pick the layout and direction every comic starts in. Webtoon and manga can be combined, and you can still switch any comic from the reader toolbar." Style="{StaticResource SettingHint}" />
                                        </StackPanel>

                                        <TextBlock Text="LAYOUT" Style="{StaticResource ComicCaptionTextStyle}" />
                                        <helpers:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                                            <ToggleButton x:Name="ReaderSingleTile" Style="{StaticResource ReadingTileStyle}" Click="ReaderModeTile_Click" Tag="0" AutomationProperties.Name="Open page by page">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="54" CornerRadius="5" Background="#FFFDF6" BorderBrush="#0B0B12" BorderThickness="2" VerticalAlignment="Center">
                                                        <Grid Margin="5" RowSpacing="3">
                                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                            <Border Background="#00C2FF" CornerRadius="2" />
                                                            <Border Grid.Row="1" Background="#FF1F6D" CornerRadius="2" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="PAGE BY PAGE" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" CharacterSpacing="30" />
                                                        <TextBlock Text="One page at a time" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </ToggleButton>
                                            <ToggleButton x:Name="ReaderSpreadTile" Style="{StaticResource ReadingTileStyle}" Click="ReaderModeTile_Click" Tag="1" AutomationProperties.Name="Open as two-page spread">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                        <Border Width="28" Height="54" CornerRadius="5,1,1,5" Background="#FFFDF6" BorderBrush="#0B0B12" BorderThickness="2">
                                                            <Border Margin="4" Background="#FFD700" CornerRadius="2" />
                                                        </Border>
                                                        <Border Width="28" Height="54" CornerRadius="1,5,5,1" Background="#FFFDF6" BorderBrush="#0B0B12" BorderThickness="2">
                                                            <Border Margin="4" Background="#2EE59D" CornerRadius="2" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="TWO-PAGE SPREAD" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" CharacterSpacing="30" />
                                                        <TextBlock Text="Side by side, like print" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </ToggleButton>
                                            <ToggleButton x:Name="ReaderWebtoonTile" Style="{StaticResource ReadingTileStyle}" Click="ReaderModeTile_Click" Tag="2" AutomationProperties.Name="Open as webtoon">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="30" Height="58" CornerRadius="5" Background="#FFFDF6" BorderBrush="#0B0B12" BorderThickness="2" VerticalAlignment="Center">
                                                        <StackPanel Margin="4" Spacing="3">
                                                            <Border Height="14" Background="#B388FF" CornerRadius="2" />
                                                            <Border Height="14" Background="#00C2FF" CornerRadius="2" />
                                                            <Border Height="14" Background="#FF9F1C" CornerRadius="2" />
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="WEBTOON" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" CharacterSpacing="30" />
                                                        <TextBlock Text="One long vertical scroll" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </ToggleButton>
                                        </helpers:WrapPanel>

                                        <TextBlock Text="DIRECTION" Style="{StaticResource ComicCaptionTextStyle}" />
                                        <helpers:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                                            <ToggleButton x:Name="DirectionWesternTile" Style="{StaticResource ReadingTileStyle}" Click="DirectionTile_Click" Tag="0" AutomationProperties.Name="Western, left to right">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="44" Height="44" VerticalAlignment="Center">
                                                        <Ellipse Fill="#00C2FF" Stroke="#0B0B12" StrokeThickness="2" />
                                                        <FontIcon Glyph="&#xE72A;" FontSize="18" Foreground="#0B0B12" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="COMIC · LEFT TO RIGHT" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" CharacterSpacing="30" />
                                                        <TextBlock Text="Western comics and graphic novels" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </ToggleButton>
                                            <ToggleButton x:Name="DirectionMangaTile" Style="{StaticResource ReadingTileStyle}" Click="DirectionTile_Click" Tag="1" AutomationProperties.Name="Manga, right to left">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="44" Height="44" VerticalAlignment="Center">
                                                        <Ellipse Fill="#FF1F6D" Stroke="#0B0B12" StrokeThickness="2" />
                                                        <FontIcon Glyph="&#xE72B;" FontSize="18" Foreground="White" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="MANGA · RIGHT TO LEFT" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" CharacterSpacing="30" />
                                                        <TextBlock Text="Page turns, spreads and OCR go right to left" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </ToggleButton>
                                        </helpers:WrapPanel>

                                        <Border x:Name="ReadingModeSummary" CornerRadius="10" Padding="12,8" Background="{ThemeResource KomikPanelBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1" helpers:MotionHelper.RevealOnShow="True">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE736;" FontSize="14" Foreground="{ThemeResource KomikCyanBrush}" />
                                                <TextBlock x:Name="ReadingModeSummaryText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingTile}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Default Reading Theme" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Original, Night (amber), Sepia, High Contrast, Grayscale or Inverted." Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.ReadingPresetIndex, Mode=TwoWay}" SelectionChanged="SettingChanged">
                                            <ComboBoxItem Content="Original (No Filter)" />
                                            <ComboBoxItem Content="Night Mode (Amber)" />
                                            <ComboBoxItem Content="Warm Sepia" />
                                            <ComboBoxItem Content="High Contrast" />
                                            <ComboBoxItem Content="Grayscale (Manga)" />
                                            <ComboBoxItem Content="Inverted (Negatives)" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingTile}">
                                    <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1" Width="120" Height="172" VerticalAlignment="Top" CornerRadius="10" BorderBrush="{ThemeResource KomikInkStrokeBrush}" BorderThickness="2.5,2.5,4,4" Background="{ThemeResource KomikPanelBrush}" Visibility="{x:Bind ViewModel.HasColorPreview, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" ToolTipService.ToolTip="Preview: a cover from your library with these page colors">
                                        <Image Source="{x:Bind ViewModel.ColorPreviewImage, Mode=OneWay}" Stretch="UniformToFill" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="1.5" CornerRadius="5" Padding="5,0">
                                            <TextBlock Text="PREVIEW" FontFamily="{StaticResource KomikDisplayFont}" FontSize="12" CharacterSpacing="40" Foreground="#0B0B12" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Default Page Colors" Style="{StaticResource SettingLabel}" />
                                                <TextBlock Text="Brightness, contrast and paper warmth every comic opens with. Saved instantly; the reader's color menu can still adjust a single comic." Style="{StaticResource SettingHint}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Brightness" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Slider Grid.Column="1" Minimum="-100" Maximum="100" StepFrequency="1" Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}" ValueChanged="SettingChanged" VerticalAlignment="Center" AutomationProperties.Name="Brightness" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.BrightnessDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Contrast" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Slider Grid.Column="1" Minimum="50" Maximum="200" StepFrequency="1" Value="{x:Bind ViewModel.ContrastPercent, Mode=TwoWay}" ValueChanged="SettingChanged" VerticalAlignment="Center" AutomationProperties.Name="Contrast" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ContrastDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Warmth" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Slider Grid.Column="1" Minimum="-100" Maximum="100" StepFrequency="1" Value="{x:Bind ViewModel.Warmth, Mode=TwoWay}" ValueChanged="SettingChanged" VerticalAlignment="Center" AutomationProperties.Name="Warmth" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.WarmthDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{StaticResource KomikDisplayFont}" FontSize="17" />
                                        </Grid>
                                        <Button Command="{x:Bind ViewModel.ResetColorSettingsCommand}" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                                                <TextBlock Text="Reset Colors" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 3. WATCHED FOLDERS -->
                        <ContentControl x:Name="FoldersSection" Style="{StaticResource SettingsSectionPanel}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#2EE59D" BorderBrush="#0B0B12" BorderThickness="2"><FontIcon Glyph="&#xE8B7;" FontSize="17" Foreground="#0B0B12" /></Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="WATCHED LIBRARY FOLDERS" Style="{StaticResource ComicSectionTitleStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="Any CBZ, CBR, CB7, ZIP, RAR, 7Z, PDF or image folder inside is found automatically." Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ComicPrimaryButtonStyle}" Command="{x:Bind ViewModel.AddFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                                            <TextBlock Text="Add Folder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.WatchedFolders, Mode=OneWay}">
                                    <ItemsControl.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </ItemsControl.ItemContainerTransitions>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:WatchedFolder">
                                            <Border Style="{StaticResource SettingTile}" Margin="0,0,0,8" helpers:MotionHelper.HoverLift="True">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="8" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="1.5">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="#0B0B12" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Path}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                        <TextBlock FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}">
                                                            <Run Text="Added" />
                                                            <Run Text="{x:Bind DateAddedFormatted}" />
                                                            <Run Text="· Last scan" />
                                                            <Run Text="{x:Bind LastScannedFormatted}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="2"
                                                        Style="{StaticResource ComicDangerButtonStyle}"
                                                        MinHeight="34"
                                                        Padding="10,4"
                                                        Click="RemoveFolderButton_Click"
                                                        Tag="{x:Bind}"
                                                        AutomationProperties.Name="Remove folder"
                                                        ToolTipService.ToolTip="Stop watching this folder (files are not deleted)">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>

                        <!-- 3b. ADD BACK COMICS -->
                        <ContentControl x:Name="AddBackSection" Style="{StaticResource SettingsSectionPanel}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#B388FF" BorderBrush="#0B0B12" BorderThickness="2"><FontIcon Glyph="&#xE8F4;" FontSize="17" Foreground="#0B0B12" /></Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="COMICS NOT IN YOUR LIBRARY" Style="{StaticResource ComicSectionTitleStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="Comics in your watched folders that you removed from the library, or that were never added. Pick the ones to bring back." Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ComicAccentButtonStyle}" Command="{x:Bind ViewModel.FindUnindexedComicsCommand}" IsEnabled="{x:Bind ViewModel.IsNotFindingUnindexed, Mode=OneWay}" AutomationProperties.Name="Find comics">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                                            <TextBlock Text="Find Comics" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Style="{StaticResource SettingTile}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ProgressRing IsActive="{x:Bind ViewModel.IsFindingUnindexed, Mode=OneWay}" Width="18" Height="18" Visibility="{x:Bind ViewModel.IsFindingUnindexed, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                            <TextBlock Text="{x:Bind ViewModel.UnindexedStatusText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ProgressBar Value="{x:Bind ViewModel.UnindexedProgress, Mode=OneWay}" Maximum="{x:Bind ViewModel.UnindexedProgressTotal, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsFindingUnindexed, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSearchedUnindexed, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid ColumnSpacing="10" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="160" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <AutoSuggestBox QueryIcon="Find" PlaceholderText="Search file or folder name..." Text="{x:Bind ViewModel.UnindexedSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{x:Bind ViewModel.UnindexedScopes}" SelectedItem="{x:Bind ViewModel.UnindexedScope, Mode=TwoWay}" ToolTipService.ToolTip="Show removed or never-added comics" />
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                                    <Button Padding="10,5" Command="{x:Bind ViewModel.SelectAllUnindexedCommand}" CommandParameter="True">
                                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B3;" FontSize="12" /><TextBlock Text="Pick all shown" /></StackPanel>
                                                    </Button>
                                                    <Button Padding="10,5" Command="{x:Bind ViewModel.SelectAllUnindexedCommand}" CommandParameter="False">
                                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE894;" FontSize="12" /><TextBlock Text="Clear" /></StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <ListView ItemsSource="{x:Bind ViewModel.UnindexedComics, Mode=OneWay}" SelectionMode="None" MaxHeight="420" Visibility="{x:Bind ViewModel.HasUnindexedComics, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,0,0,6" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:UnindexedComicItem">
                                                        <Grid ColumnSpacing="12" Padding="8" CornerRadius="10" Background="{ThemeResource KomikPanelBrush}" BorderBrush="{ThemeResource KomikPanelStrokeBrush}" BorderThickness="1,1,2,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind FileName}" />
                                                            <Grid Grid.Column="1" Width="38" Height="54" CornerRadius="5" Background="{ThemeResource KomikPanelSunkenBrush}">
                                                                <FontIcon Glyph="&#xE82D;" FontSize="14" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                                <Image Source="{x:Bind ThumbnailPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{x:Bind FileName}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                                <TextBlock Text="{x:Bind FolderName}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border CornerRadius="5" Padding="6,0" Background="#FF9F1C" BorderBrush="#0B0B12" BorderThickness="1.5" Visibility="{x:Bind WasRemoved, Converter={StaticResource BoolToVisConverter}}">
                                                                    <TextBlock Text="REMOVED" FontFamily="{StaticResource KomikDisplayFont}" FontSize="12" CharacterSpacing="40" Foreground="#0B0B12" />
                                                                </Border>
                                                                <Border CornerRadius="5" Padding="6,0" Background="#2EE59D" BorderBrush="#0B0B12" BorderThickness="1.5" Visibility="{x:Bind IsNew, Converter={StaticResource BoolToVisConverter}}">
                                                                    <TextBlock Text="NEW" FontFamily="{StaticResource KomikDisplayFont}" FontSize="12" CharacterSpacing="40" Foreground="#0B0B12" />
                                                                </Border>
                                                                <Border Style="{StaticResource ComicPillStyle}" Padding="7,1">
                                                                    <TextBlock Text="{x:Bind FormatBadge}" FontSize="10" FontWeight="Bold" />
                                                                </Border>
                                                                <TextBlock Text="{x:Bind SizeDisplay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <TextBlock Text="{x:Bind ViewModel.UnindexedEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowUnindexedEmpty, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" TextWrapping="Wrap" />

                                            <Button HorizontalAlignment="Right" Style="{StaticResource ComicPrimaryButtonStyle}" Command="{x:Bind ViewModel.AddSelectedUnindexedCommand}" IsEnabled="{x:Bind ViewModel.IsNotFindingUnindexed, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasUnindexedComics, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                                    <TextBlock Text="{x:Bind ViewModel.AddUnindexedText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 4. COVERS & STORAGE -->
                        <ContentControl x:Name="CoversSection" Style="{StaticResource SettingsSectionPanel}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FF9F1C" BorderBrush="#0B0B12" BorderThickness="2"><FontIcon Glyph="&#xEB9F;" FontSize="17" Foreground="#0B0B12" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="COVER CACHE &amp; STORAGE" Style="{StaticResource ComicSectionTitleStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="Pre-rendered covers make browsing instant. Clearing them never touches your comics or progress." Style="{StaticResource SettingHint}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource SettingTile}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource ComicStickerStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.ThumbnailCacheSizeText, Mode=OneWay}" Style="{StaticResource ComicStickerTextStyle}" FontSize="16" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ThumbnailCacheDirectory, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                        <helpers:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button Command="{x:Bind ViewModel.OpenCacheFolderCommand}" IsEnabled="{x:Bind ViewModel.IsNotCaching, Mode=OneWay}" ToolTipService.ToolTip="Open the cover cache folder in File Explorer">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xED25;" FontSize="13" />
                                                    <TextBlock Text="Open Cache Folder" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ComicAccentButtonStyle}" Click="CacheAllCoversButton_Click" IsEnabled="{x:Bind ViewModel.IsNotCaching, Mode=OneWay}" ToolTipService.ToolTip="Pre-render covers for every comic">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEB9F;" FontSize="13" />
                                                    <TextBlock Text="Cache All Covers" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ComicDangerButtonStyle}" Click="ClearCacheButton_Click" IsEnabled="{x:Bind ViewModel.IsNotCaching, Mode=OneWay}" ToolTipService.ToolTip="Remove cached cover images from disk">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                    <TextBlock Text="Clear Cache" />
                                                </StackPanel>
                                            </Button>
                                        </helpers:WrapPanel>
                                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsCaching, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                            <ProgressBar
                                                Value="{x:Bind ViewModel.CachingProgress, Mode=OneWay}"
                                                Maximum="{x:Bind ViewModel.CachingTotal, Mode=OneWay}"
                                                IsIndeterminate="{x:Bind ViewModel.IsCachingIndeterminate, Mode=OneWay}"
                                                Foreground="{ThemeResource KomikCyanBrush}"
                                                MinHeight="6" />
                                            <TextBlock Text="{x:Bind ViewModel.CachingStatusText, Mode=OneWay}" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 5. BACKUP -->
                        <ContentControl x:Name="BackupSection" Style="{StaticResource SettingsSectionPanel}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FF1F6D" BorderBrush="#0B0B12" BorderThickness="2"><FontIcon Glyph="&#xEDE1;" FontSize="17" Foreground="White" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="LIBRARY DATA &amp; BACKUP" Style="{StaticResource ComicSectionTitleStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="Move your progress, bookmarks, favorites, tags and reading stats between PCs with a portable .komikbackup file." Style="{StaticResource SettingHint}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingTile}" helpers:MotionHelper.HoverLift="True">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Export Backup" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Save everything about your reading to a file." Style="{StaticResource SettingHint}" />
                                            <Button Style="{StaticResource ComicPrimaryButtonStyle}" Command="{x:Bind ViewModel.ExportBackupCommand}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                                                    <TextBlock Text="Export..." />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource SettingTile}" helpers:MotionHelper.HoverLift="True">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Restore Backup" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Bring back saved progress, bookmarks and stats." Style="{StaticResource SettingHint}" />
                                            <Button Style="{StaticResource ComicAccentButtonStyle}" Command="{x:Bind ViewModel.ImportBackupCommand}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xED43;" FontSize="13" />
                                                    <TextBlock Text="Import..." />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ContentControl>

                        <!-- 6. ABOUT -->
                        <ContentControl x:Name="AboutSection" Style="{StaticResource SettingsSectionPanel}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="72" CornerRadius="16" Background="{ThemeResource KomikHeroBrush}" BorderBrush="#0B0B12" BorderThickness="2.5,2.5,4,4" VerticalAlignment="Top">
                                    <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="48" Height="48" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Grid>
                                            <TextBlock Text="KOMIK" Style="{StaticResource ComicDisplayTextStyle}" FontSize="36" LineHeight="38" Foreground="{ThemeResource KomikWordmarkShadowBrush}" Margin="2,2,0,0" />
                                            <TextBlock Text="KOMIK" Style="{StaticResource ComicDisplayTextStyle}" FontSize="36" LineHeight="38" Foreground="{ThemeResource KomikWordmarkBrush}" />
                                        </Grid>
                                        <Border Style="{StaticResource ComicStickerStyle}" Background="#FF1F6D" BorderBrush="#0B0B12" Padding="7,0">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-6" />
                                            </Border.RenderTransform>
                                            <TextBlock Text="v1.2.0" Style="{StaticResource ComicStickerTextStyle}" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="A modern, private, local-only comic reader for Windows, built with WinUI 3, the Windows App SDK, C# (.NET 8) and SQLite." Style="{StaticResource SettingHint}" FontSize="13" />
                                    <helpers:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                        <Border Style="{StaticResource ComicPillStyle}"><TextBlock Text="CBZ" FontSize="11" FontWeight="Bold" /></Border>
                                        <Border Style="{StaticResource ComicPillStyle}"><TextBlock Text="CBR (RAR4/5)" FontSize="11" FontWeight="Bold" /></Border>
                                        <Border Style="{StaticResource ComicPillStyle}"><TextBlock Text="CB7" FontSize="11" FontWeight="Bold" /></Border>
                                        <Border Style="{StaticResource ComicPillStyle}"><TextBlock Text="ZIP" FontSize="11" FontWeight="Bold" /></Border>
                                        <Border Style="{StaticResource ComicPillStyle}"><TextBlock Text="PDF" FontSize="11" FontWeight="Bold" /></Border>
                                        <Border Style="{StaticResource ComicPillStyle}"><TextBlock Text="Image folders" FontSize="11" FontWeight="Bold" /></Border>
                                        <Border Style="{StaticResource ComicPillStyle}"><TextBlock Text="No cloud" FontSize="11" FontWeight="Bold" /></Border>
                                    </helpers:WrapPanel>
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Floating notification (overlays, auto-hides) -->
        <controls:ComicToast
            x:Name="SettingsToast"
            IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}" />
    </Grid>
</Page>
