<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Komik.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Komik.Models"
    xmlns:vm="using:Komik.ViewModels"
    xmlns:controls="using:Komik.Controls"
    xmlns:helpers="using:Komik.Helpers"
    mc:Ignorable="d"
    RequestedTheme="{x:Bind ViewModel.RequestedTheme, Mode=OneWay}"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown"
    PointerMoved="Page_PointerMoved"
    SizeChanged="MainPage_SizeChanged"
    IsTabStop="True">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FloatingPillBackgroundBrush" Color="#F4F2F3F5" />
                    <SolidColorBrush x:Key="FloatingPillBorderBrush" Color="#B3202428" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FloatingPillBackgroundBrush" Color="#F21C1D21" />
                    <SolidColorBrush x:Key="FloatingPillBorderBrush" Color="#66FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="FloatingPillBackgroundBrush" Color="#F21C1D21" />
                    <SolidColorBrush x:Key="FloatingPillBorderBrush" Color="#66FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="FloatingPillCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource FloatingPillBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource FloatingPillBorderBrush}" />
                <Setter Property="BorderThickness" Value="2,2,4,4" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="EdgeNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="54" />
                <Setter Property="Height" Value="84" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{ThemeResource KomikReaderChromeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KomikReaderChromeStrokeBrush}" />
                <Setter Property="BorderThickness" Value="2.5,2.5,4,4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
            </Style>

            <!-- Reader chrome controls: chunky, inked and bouncy -->
            <Style x:Key="ReaderGroupStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource KomikPanelSunkenBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KomikInkStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ReaderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
            </Style>
            <Style x:Key="ReaderTextButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
            </Style>
            <Style x:Key="ReaderIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
            </Style>
            <Style x:Key="ReaderTextToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
            </Style>
            <Style x:Key="ReaderDropDownStyle" TargetType="DropDownButton">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="helpers:MotionHelper.PressPop" Value="True" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- ==================== MAIN READING CANVAS ==================== -->
        <ScrollViewer
            x:Name="ReaderScrollViewer"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Enabled"
            MinZoomFactor="0.2"
            MaxZoomFactor="5.0"
            PointerWheelChanged="ReaderScrollViewer_PointerWheelChanged"
            PointerPressed="ReaderScrollViewer_PointerPressed"
            PointerMoved="ReaderScrollViewer_PointerMoved"
            PointerReleased="ReaderScrollViewer_PointerReleased"
            ViewChanged="ReaderScrollViewer_ViewChanged"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Grid
                x:Name="PageDisplayContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Single Page View -->
                <Image
                    x:Name="PrimaryPageImage"
                    Source="{x:Bind ViewModel.CurrentPageImage, Mode=OneWay}"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsSinglePageMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                <!-- Double Page Spread View -->
                <StackPanel
                    x:Name="DoublePageContainer"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsDoublePageMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

                    <Image
                        x:Name="DoublePageLeftImage"
                        Source="{x:Bind ViewModel.CurrentPageImage, Mode=OneWay}"
                        Stretch="Uniform" />

                    <Image
                        x:Name="DoublePageRightImage"
                        Source="{x:Bind ViewModel.SecondPageImage, Mode=OneWay}"
                        Stretch="Uniform" />
                </StackPanel>

                <!-- Webtoon Continuous Mode View -->
                <ItemsControl
                    x:Name="WebtoonContainer"
                    ItemsSource="{x:Bind ViewModel.WebtoonPages, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsWebtoonMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WebtoonPageItem">
                            <Grid Margin="0,0,0,3" HorizontalAlignment="Center" MinHeight="120">
                                <Image
                                    Source="{x:Bind Image, Mode=OneWay}"
                                    Stretch="Uniform"
                                    MaxWidth="1000"
                                    HorizontalAlignment="Center" />
                                <ProgressRing
                                    IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                    Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="36" Height="36" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- OCR Selectable Text Overlay Card -->
                <Border
                    x:Name="OcrTextOverlayCard"
                    Visibility="{x:Bind ViewModel.IsOcrLayerVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                    MaxWidth="420"
                    MaxHeight="360"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="16,76,20,16"
                    Padding="16"
                    Background="{ThemeResource KomikReaderChromeBrush}"
                    BorderBrush="{ThemeResource KomikReaderChromeStrokeBrush}"
                    BorderThickness="2.5,2.5,4,4"
                    CornerRadius="14"
                    Canvas.ZIndex="50">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C1;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Recognized Page Dialogue" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Width="26" Height="26" Padding="0"
                                Command="{x:Bind ViewModel.ToggleOcrLayerCommand}"
                                ToolTipService.ToolTip="Close OCR Overlay">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <TextBox
                                Text="{x:Bind ViewModel.CurrentPageOcrResult.FullText, Mode=OneWay}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="12" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button
                                Command="{x:Bind ViewModel.CopyCurrentPageTextCommand}"
                                ToolTipService.ToolTip="Copy detected dialogue to clipboard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                    <TextBlock Text="Copy Text" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ==================== EMPTY STATE VIEW ==================== -->
        <Grid
            x:Name="EmptyStateContainer"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasNoComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Border
                Width="540"
                Padding="36,40"
                CornerRadius="18"
                Background="{ThemeResource KomikPanelBrush}"
                BorderBrush="{ThemeResource KomikInkStrokeBrush}"
                BorderThickness="2.5,2.5,6,6">

                <StackPanel Spacing="24" HorizontalAlignment="Center">
                    <!-- App Logo Crest -->
                    <Image
                        Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                        Width="84"
                        Height="84"
                        HorizontalAlignment="Center" />

                    <!-- App Title and Tagline -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center">
                            <TextBlock Text="KOMIK" Style="{StaticResource ComicDisplayTextStyle}" FontSize="64" LineHeight="64" Foreground="{ThemeResource KomikShadowBrush}" Margin="4,4,0,0" />
                            <TextBlock Text="KOMIK" Style="{StaticResource ComicDisplayTextStyle}" FontSize="64" LineHeight="64" Foreground="{ThemeResource KomikYellowBrush}" />
                        </Grid>
                        <TextBlock
                            Text="A modern, distraction-free comic reader for Windows"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </StackPanel>

                    <!-- Open Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.OpenFileCommand}"
                            Style="{StaticResource ComicPrimaryButtonStyle}"
                            Height="44"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                <TextBlock Text="Open Comic..." FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{x:Bind ViewModel.OpenFolderCommand}"
                            Height="40"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xED25;" FontSize="16" />
                                <TextBlock Text="Open Folder..." />
                            </StackPanel>
                        </Button>

                        <Button
                            Click="BackToLibrary_Click"
                            Height="40"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                                <TextBlock Text="Library" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Drag & Drop Dropzone Box -->
                    <Border
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        Padding="20,16">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE898;"
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="Or drag &amp; drop a CBZ, ZIP, PDF, or folder here"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Supported Format Badges -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text=".CBZ" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text=".ZIP" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text=".PDF" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text="JPEG / PNG / WEBP" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text="FOLDERS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== ON-SCREEN HOVER NAV BUTTONS ==================== -->
        <!-- Left Edge Previous Button -->
        <Grid
            x:Name="LeftNavZone"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Width="90"
            Background="Transparent"
            PointerEntered="NavZone_PointerEntered"
            PointerExited="NavZone_PointerExited"
            Tapped="LeftNavZone_Tapped"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Button
                x:Name="PreviousPageButton"
                Style="{StaticResource EdgeNavButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                Opacity="0"
                Click="PreviousPageButton_Click"
                IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                ToolTipService.ToolTip="Turn Page Left (Left Arrow / Click Left 25%)">
                <FontIcon Glyph="&#xE76B;" FontSize="18" />
            </Button>
        </Grid>

        <!-- Right Edge Next Button -->
        <Grid
            x:Name="RightNavZone"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="90"
            Background="Transparent"
            PointerEntered="NavZone_PointerEntered"
            PointerExited="NavZone_PointerExited"
            Tapped="RightNavZone_Tapped"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Button
                x:Name="NextPageButton"
                Style="{StaticResource EdgeNavButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,16,0"
                Opacity="0"
                Click="NextPageButton_Click"
                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                ToolTipService.ToolTip="Turn Page Right (Right Arrow / Click Right 25%)">
                <FontIcon Glyph="&#xE76C;" FontSize="18" />
            </Button>
        </Grid>

        <!-- ==================== FLOATING TOP TOOLBAR (comic panel) ==================== -->
        <Grid
            x:Name="TopToolbar"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="12,12,12,0"
            MaxWidth="1500"
            PointerEntered="Toolbar_PointerEntered"
            PointerExited="Toolbar_PointerExited"
            Canvas.ZIndex="60"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.22" />
            </Grid.OpacityTransition>
            <Grid.TranslationTransition>
                <Vector3Transition Duration="0:0:0.28" />
            </Grid.TranslationTransition>

            <Border Margin="5,5,0,0" CornerRadius="18" Background="{ThemeResource KomikShadowBrush}" />
            <Border Margin="0,0,5,5" CornerRadius="18" Background="{ThemeResource KomikReaderChromeBrush}" BorderBrush="{ThemeResource KomikReaderChromeStrokeBrush}" BorderThickness="2.5">
                <Grid>
                    <Border CornerRadius="16" Background="{StaticResource KomikHalftoneBrush}" Opacity="0.06" IsHitTestVisible="False" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Auto"
                        VerticalScrollMode="Disabled"
                        Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                            <!-- Back to wherever the comic was opened from -->
                            <Button
                                x:Name="ReaderBackButton"
                                Style="{StaticResource ComicPrimaryButtonStyle}"
                                MinHeight="36"
                                Padding="10,4,12,4"
                                Click="ReaderBack_Click"
                                AutomationProperties.Name="Back"
                                ToolTipService.ToolTip="Go back to where you opened this comic (Backspace / Alt+Left)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                    <TextBlock x:Name="ReaderBackLabel" Text="{x:Bind BackButtonText}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="16" CharacterSpacing="40" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>

                            <Button
                                Style="{StaticResource ReaderIconButtonStyle}"
                                Click="BackToLibrary_Click"
                                AutomationProperties.Name="Library"
                                ToolTipService.ToolTip="Library home (all comics)">
                                <FontIcon Glyph="&#xE80F;" FontSize="14" />
                            </Button>

                            <DropDownButton Style="{StaticResource ReaderDropDownStyle}" ToolTipService.ToolTip="Open Comic or Folder" AutomationProperties.Name="Open">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="Open Comic File... (Ctrl+O)" Command="{x:Bind ViewModel.OpenFileCommand}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8E5;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open Image Folder... (Ctrl+Shift+O)" Command="{x:Bind ViewModel.OpenFolderCommand}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED25;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <!-- Title caption box -->
                            <Border x:Name="ReaderTitleBox" CornerRadius="8" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="2,2,3,3" Padding="10,2,12,1" VerticalAlignment="Center" MaxWidth="260">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-1.5" />
                                </Border.RenderTransform>
                                <TextBlock
                                    Text="{x:Bind ViewModel.ComicTitle, Mode=OneWay}"
                                    FontFamily="{StaticResource KomikDisplayFont}"
                                    FontSize="17"
                                    MaxLines="1"
                                    CharacterSpacing="30"
                                    Foreground="#0B0B12"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.ComicTitle, Mode=OneWay}" />
                            </Border>

                            <!-- VIEW group -->
                            <Border Style="{StaticResource ReaderGroupStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <ToggleButton x:Name="FitHeightToggle" Style="{StaticResource ReaderIconToggleStyle}" IsChecked="{x:Bind ViewModel.IsFitHeight, Mode=OneWay}" Click="FitHeight_Click" AutomationProperties.Name="Fit to height" ToolTipService.ToolTip="Fit to Height: whole page on screen">
                                        <FontIcon Glyph="&#xE740;" FontSize="13" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="FitWidthToggle" Style="{StaticResource ReaderIconToggleStyle}" IsChecked="{x:Bind ViewModel.IsFitWidth, Mode=OneWay}" Click="FitWidth_Click" AutomationProperties.Name="Fit to width" ToolTipService.ToolTip="Fit to Width: page fills the screen width (great for webtoons)">
                                        <FontIcon Glyph="&#xE784;" FontSize="13" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="FitActualToggle" Style="{StaticResource ReaderIconToggleStyle}" IsChecked="{x:Bind ViewModel.IsFitActual, Mode=OneWay}" Click="FitActual_Click" AutomationProperties.Name="Actual size" ToolTipService.ToolTip="Actual Size: 1:1 original pixels">
                                        <FontIcon Glyph="&#xE799;" FontSize="13" />
                                    </ToggleButton>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ReaderGroupStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <ToggleButton
                                        x:Name="SpreadToggle"
                                        Style="{StaticResource ReaderTextToggleStyle}"
                                        IsChecked="{x:Bind ViewModel.IsDoublePageMode, Mode=OneWay}"
                                        Click="SpreadToggle_Click"
                                        ToolTipService.ToolTip="Two-Page Spread: adjacent pages side by side like a printed comic (D)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE898;" FontSize="13" />
                                            <TextBlock x:Name="SpreadLabel" Text="{x:Bind ViewModel.IsDoublePageMode, Mode=OneWay, Converter={StaticResource ViewModeTextConverter}}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="WebtoonToggle"
                                        Style="{StaticResource ReaderTextToggleStyle}"
                                        IsChecked="{x:Bind ViewModel.IsWebtoonMode, Mode=OneWay}"
                                        Click="WebtoonToggle_Click"
                                        ToolTipService.ToolTip="Webtoon Mode: continuous vertical scroll without page turns (V)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                                            <TextBlock x:Name="WebtoonLabel" Text="Webtoon" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button
                                        Style="{StaticResource ReaderTextButtonStyle}"
                                        Command="{x:Bind ViewModel.ToggleReadingDirectionCommand}"
                                        ToolTipService.ToolTip="Reading Direction: Western left-to-right or manga right-to-left (Ctrl+R)">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE8AB;" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.ReadingDirectionDisplay, Mode=OneWay}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="15" CharacterSpacing="40" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- TOOLS group -->
                            <Border Style="{StaticResource ReaderGroupStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <DropDownButton x:Name="OcrDropDownButton" Style="{StaticResource ReaderDropDownStyle}" ToolTipService.ToolTip="Offline OCR &amp; Dialogue Search" AutomationProperties.Name="OCR">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C1;" FontSize="13" />
                                            <TextBlock Text="OCR" FontFamily="{StaticResource KomikDisplayFont}" FontSize="15" CharacterSpacing="40" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="310" Spacing="10" Padding="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="COMIC OCR" Style="{StaticResource ComicSectionTitleStyle}" FontSize="20" />
                                                        <Border Style="{StaticResource ComicStickerStyle}" Padding="6,0">
                                                            <TextBlock Text="OFFLINE" Style="{StaticResource ComicStickerTextStyle}" FontSize="12" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Private, on-device text detection using Windows OCR. Copy dialogue or search every page." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" />

                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        Style="{StaticResource ComicAccentButtonStyle}"
                                                        Command="{x:Bind ViewModel.ToggleOcrLayerCommand}"
                                                        IsEnabled="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                                                        ToolTipService.ToolTip="Recognize dialogue and text on current page">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE8C1;" FontSize="13" />
                                                            <TextBlock Text="{x:Bind ViewModel.IsOcrLayerVisible, Mode=OneWay, Converter={StaticResource OcrButtonTextConverter}}" />
                                                        </StackPanel>
                                                    </Button>

                                                    <ProgressBar
                                                        IsIndeterminate="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                                                    <Rectangle Height="2" Fill="{ThemeResource KomikInkStrokeBrush}" Margin="0,2" RadiusX="1" RadiusY="1" />

                                                    <TextBlock Text="Search Dialogue in Comic" FontWeight="SemiBold" FontSize="12" />
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            x:Name="OcrSearchBox"
                                                            Grid.Column="0"
                                                            PlaceholderText="Search dialogue or text..."
                                                            Text="{x:Bind ViewModel.OcrSearchQuery, Mode=TwoWay}"
                                                            KeyDown="OcrSearchBox_KeyDown" />
                                                        <Button Grid.Column="1" Click="OcrSearch_Click" AutomationProperties.Name="Search dialogue">
                                                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                                                        </Button>
                                                    </Grid>

                                                    <ProgressBar
                                                        IsIndeterminate="{x:Bind ViewModel.IsSearchingOcr, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.IsSearchingOcr, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                                                    <ListView
                                                        ItemsSource="{x:Bind ViewModel.OcrSearchResults, Mode=OneWay}"
                                                        MaxHeight="160"
                                                        SelectionMode="None">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:OcrSearchResultItem">
                                                                <Button
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="4,3"
                                                                    Click="OcrSearchResult_Click"
                                                                    Tag="{x:Bind}">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Text="{x:Bind PageDisplay}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource KomikCyanBrush}" />
                                                                        <TextBlock Text="{x:Bind Snippet}" FontSize="10" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>

                                    <Button
                                        Style="{StaticResource ReaderIconButtonStyle}"
                                        Command="{x:Bind ViewModel.ToggleBookmarkCurrentPageCommand}"
                                        AutomationProperties.Name="Bookmark page"
                                        ToolTipService.ToolTip="Bookmark Page (Ctrl+D / Ctrl+B)">
                                        <FontIcon Glyph="{x:Bind ViewModel.BookmarkGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource KomikOrangeBrush}" />
                                    </Button>

                                    <DropDownButton Style="{StaticResource ReaderDropDownStyle}" ToolTipService.ToolTip="View Bookmarks" AutomationProperties.Name="Bookmarks">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                        <DropDownButton.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="280" Spacing="8">
                                                    <Grid>
                                                        <TextBlock Text="BOOKMARKS" Style="{StaticResource ComicSectionTitleStyle}" FontSize="20" ToolTipService.ToolTip="Save favorite panels and scenes with notes to jump back to them at any time." />
                                                        <Button
                                                            HorizontalAlignment="Right"
                                                            Padding="8,3"
                                                            Click="AddBookmarkNote_Click"
                                                            ToolTipService.ToolTip="Add Bookmark with Note">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE710;" FontSize="10" />
                                                                <TextBlock Text="Note" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <ListView
                                                        ItemsSource="{x:Bind ViewModel.Bookmarks}"
                                                        SelectionMode="None"
                                                        MaxHeight="260">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:BookmarkEntity">
                                                                <Grid Padding="4,2" Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button
                                                                        Grid.Column="0"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="4,2"
                                                                        Click="JumpToBookmark_Click"
                                                                        Tag="{x:Bind}">
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="12" />
                                                                            <TextBlock Text="{x:Bind DisplaySubtitle}" FontSize="10" Foreground="{ThemeResource KomikSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        Width="26"
                                                                        Height="26"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="DeleteBookmark_Click"
                                                                        Tag="{x:Bind}"
                                                                        ToolTipService.ToolTip="Remove Bookmark">
                                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource KomikMagentaBrush}" />
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>

                                    <DropDownButton Style="{StaticResource ReaderDropDownStyle}" ToolTipService.ToolTip="Color Correction &amp; Night Mode" AutomationProperties.Name="Colors">
                                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                                        <DropDownButton.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="270" Spacing="12" Padding="4">
                                                    <Grid>
                                                        <TextBlock Text="DISPLAY &amp; COLORS" Style="{StaticResource ComicSectionTitleStyle}" FontSize="20" ToolTipService.ToolTip="Non-destructive display filters. Your comic files are never changed." />
                                                        <Button HorizontalAlignment="Right" Padding="8,3" Click="ResetColorSettings_Click" ToolTipService.ToolTip="Reset all adjustments">
                                                            <TextBlock Text="Reset" FontSize="11" />
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="Reading Theme Presets" FontWeight="SemiBold" FontSize="12" />
                                                    <Grid ColumnSpacing="6" RowSpacing="6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Row="0" Grid.Column="0" Content="Original" HorizontalAlignment="Stretch" Padding="2,5" FontSize="11" Click="PresetOriginal_Click" />
                                                        <Button Grid.Row="0" Grid.Column="1" Content="Night" HorizontalAlignment="Stretch" Padding="2,5" FontSize="11" Click="PresetNight_Click" />
                                                        <Button Grid.Row="0" Grid.Column="2" Content="Sepia" HorizontalAlignment="Stretch" Padding="2,5" FontSize="11" Click="PresetSepia_Click" />
                                                        <Button Grid.Row="1" Grid.Column="0" Content="Contrast" HorizontalAlignment="Stretch" Padding="2,5" FontSize="11" Click="PresetHighContrast_Click" />
                                                        <Button Grid.Row="1" Grid.Column="1" Content="Grayscale" HorizontalAlignment="Stretch" Padding="2,5" FontSize="11" Click="PresetGrayscale_Click" />
                                                        <Button Grid.Row="1" Grid.Column="2" Content="Invert" HorizontalAlignment="Stretch" Padding="2,5" FontSize="11" Click="PresetInverted_Click" />
                                                    </Grid>

                                                    <Rectangle Height="2" Fill="{ThemeResource KomikInkStrokeBrush}" Margin="0,2" RadiusX="1" RadiusY="1" />

                                                    <StackPanel Spacing="2">
                                                        <Grid>
                                                            <TextBlock Text="Brightness" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.ColorSettings.Brightness, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" FontWeight="Bold" />
                                                        </Grid>
                                                        <Slider Minimum="-80" Maximum="80" StepFrequency="1" Value="{x:Bind ViewModel.ColorSettings.Brightness, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="2">
                                                        <Grid>
                                                            <TextBlock Text="Contrast" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.ColorSettings.Contrast, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" FontWeight="Bold" />
                                                        </Grid>
                                                        <Slider Minimum="0.6" Maximum="1.8" StepFrequency="0.05" Value="{x:Bind ViewModel.ColorSettings.Contrast, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="2">
                                                        <Grid>
                                                            <TextBlock Text="Warmth (De-yellowing)" FontSize="12" Foreground="{ThemeResource KomikSubtleTextBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.ColorSettings.Warmth, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" FontWeight="Bold" />
                                                        </Grid>
                                                        <Slider Minimum="-80" Maximum="80" StepFrequency="1" Value="{x:Bind ViewModel.ColorSettings.Warmth, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </Border>

                            <!-- ZOOM group -->
                            <Border Style="{StaticResource ReaderGroupStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Button Style="{StaticResource ReaderIconButtonStyle}" Command="{x:Bind ViewModel.ZoomOutCommand}" AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom Out (Ctrl -)">
                                        <FontIcon Glyph="&#xE71F;" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource ReaderTextButtonStyle}" MinWidth="58" Command="{x:Bind ViewModel.ResetZoomCommand}" ToolTipService.ToolTip="Reset Zoom (Ctrl 0)">
                                        <TextBlock Text="{x:Bind ViewModel.ZoomDisplayString, Mode=OneWay}" FontFamily="{StaticResource KomikDisplayFont}" FontSize="16" CharacterSpacing="30" />
                                    </Button>
                                    <Button Style="{StaticResource ReaderIconButtonStyle}" Command="{x:Bind ViewModel.ZoomInCommand}" AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom In (Ctrl +)">
                                        <FontIcon Glyph="&#xE8A3;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ReaderGroupStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Button Style="{StaticResource ReaderIconButtonStyle}" Command="{x:Bind ViewModel.ToggleThemeCommand}" AutomationProperties.Name="Toggle theme" ToolTipService.ToolTip="Toggle Dark / Light Reader Theme">
                                        <FontIcon Glyph="&#xE708;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource ReaderIconButtonStyle}" Command="{x:Bind ViewModel.ToggleFullscreenCommand}" AutomationProperties.Name="Toggle full screen" ToolTipService.ToolTip="Toggle Full Screen (F11)">
                                        <FontIcon Glyph="&#xE740;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FLOATING BOTTOM PAGE BAR ==================== -->
        <Grid
            x:Name="BottomOverlay"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            MaxWidth="860"
            Margin="24,0,24,18"
            PointerEntered="Toolbar_PointerEntered"
            PointerExited="Toolbar_PointerExited"
            Canvas.ZIndex="60"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.22" />
            </Grid.OpacityTransition>
            <Grid.TranslationTransition>
                <Vector3Transition Duration="0:0:0.28" />
            </Grid.TranslationTransition>

            <Border Margin="5,5,0,0" CornerRadius="20" Background="{ThemeResource KomikShadowBrush}" />
            <Border Margin="0,0,5,5" CornerRadius="20" Background="{ThemeResource KomikReaderChromeBrush}" BorderBrush="{ThemeResource KomikReaderChromeStrokeBrush}" BorderThickness="2.5">
                <Grid Padding="10,8,10,6" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Style="{StaticResource ReaderIconButtonStyle}" Command="{x:Bind ViewModel.FirstPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" AutomationProperties.Name="First page" ToolTipService.ToolTip="First Page (Home)">
                                <FontIcon Glyph="&#xEB9D;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource ComicAccentButtonStyle}" MinHeight="36" MinWidth="44" Padding="8,4" Command="{x:Bind ViewModel.PreviousPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" AutomationProperties.Name="Previous page" ToolTipService.ToolTip="Previous Page (Left Arrow)">
                                <FontIcon Glyph="&#xE76B;" FontSize="13" />
                            </Button>
                        </StackPanel>

                        <!-- Scrubber with the page bubble -->
                        <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="PageScrubber"
                                Minimum="1"
                                Maximum="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
                                Value="{x:Bind ViewModel.CurrentPageNumber, Mode=OneWay}"
                                ValueChanged="PageScrubber_ValueChanged"
                                VerticalAlignment="Center"
                                MinWidth="120"
                                Margin="6,0"
                                AutomationProperties.Name="Page scrubber"
                                ToolTipService.ToolTip="Drag to jump to any page" />
                            <Border Grid.Column="1" CornerRadius="10" Background="#FFD700" BorderBrush="#0B0B12" BorderThickness="2,2,3,3" Padding="10,1,12,0" VerticalAlignment="Center" MinWidth="86">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-2" />
                                </Border.RenderTransform>
                                <TextBlock
                                    Text="{x:Bind ViewModel.PageDisplayString, Mode=OneWay}"
                                    FontFamily="{StaticResource KomikDisplayFont}"
                                    FontSize="19"
                                    CharacterSpacing="40"
                                    Foreground="#0B0B12"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Style="{StaticResource ComicAccentButtonStyle}" MinHeight="36" MinWidth="44" Padding="8,4" Command="{x:Bind ViewModel.NextPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" AutomationProperties.Name="Next page" ToolTipService.ToolTip="Next Page (Right Arrow / Space)">
                                <FontIcon Glyph="&#xE76C;" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource ReaderIconButtonStyle}" Command="{x:Bind ViewModel.LastPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" AutomationProperties.Name="Last page" ToolTipService.ToolTip="Last Page (End)">
                                <FontIcon Glyph="&#xEB9E;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Reading progress strip -->
                    <ProgressBar
                        Grid.Row="1"
                        Margin="6,0"
                        MinHeight="5"
                        Height="5"
                        CornerRadius="3"
                        Minimum="0"
                        Maximum="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
                        Value="{x:Bind ViewModel.CurrentPageNumber, Mode=OneWay}"
                        Background="{ThemeResource KomikChartTrackBrush}"
                        Foreground="{ThemeResource KomikCyanBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FLOATING NOTIFICATIONS ==================== -->
        <controls:ComicToast
            x:Name="ReaderToast"
            Margin="0,72,0,0"
            DurationSeconds="3"
            IsOpen="{x:Bind ViewModel.IsToastVisible, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ToastMessage, Mode=OneWay}"
            Severity="Informational" />

        <controls:ComicToast
            x:Name="ErrorToast"
            Margin="0,72,0,0"
            DurationSeconds="8"
            IsOpen="{x:Bind ViewModel.IsError, Mode=TwoWay}"
            Title="Couldn't open this comic"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!-- ==================== LOADING PROGRESS RING ==================== -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
