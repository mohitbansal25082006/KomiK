<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Komik.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Komik.Models"
    xmlns:vm="using:Komik.ViewModels"
    mc:Ignorable="d"
    RequestedTheme="{x:Bind ViewModel.RequestedTheme, Mode=OneWay}"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown"
    PointerMoved="Page_PointerMoved"
    IsTabStop="True">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FloatingPillBackgroundBrush" Color="#F4F2F3F5" />
                    <SolidColorBrush x:Key="FloatingPillBorderBrush" Color="#B3202428" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FloatingPillBackgroundBrush" Color="#F21C1D21" />
                    <SolidColorBrush x:Key="FloatingPillBorderBrush" Color="#66FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="FloatingPillBackgroundBrush" Color="#F21C1D21" />
                    <SolidColorBrush x:Key="FloatingPillBorderBrush" Color="#66FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="FloatingPillCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource FloatingPillBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource FloatingPillBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="EdgeNavButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="80" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Background" Value="{ThemeResource FloatingPillBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource FloatingPillBorderBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- ==================== MAIN READING CANVAS ==================== -->
        <ScrollViewer
            x:Name="ReaderScrollViewer"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Enabled"
            MinZoomFactor="0.2"
            MaxZoomFactor="5.0"
            PointerWheelChanged="ReaderScrollViewer_PointerWheelChanged"
            PointerPressed="ReaderScrollViewer_PointerPressed"
            PointerMoved="ReaderScrollViewer_PointerMoved"
            PointerReleased="ReaderScrollViewer_PointerReleased"
            ViewChanged="ReaderScrollViewer_ViewChanged"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Grid
                x:Name="PageDisplayContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Single Page View -->
                <Image
                    x:Name="PrimaryPageImage"
                    Source="{x:Bind ViewModel.CurrentPageImage, Mode=OneWay}"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsSinglePageMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                <!-- Double Page Spread View -->
                <StackPanel
                    x:Name="DoublePageContainer"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsDoublePageMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

                    <Image
                        x:Name="DoublePageLeftImage"
                        Source="{x:Bind ViewModel.CurrentPageImage, Mode=OneWay}"
                        Stretch="Uniform" />

                    <Image
                        x:Name="DoublePageRightImage"
                        Source="{x:Bind ViewModel.SecondPageImage, Mode=OneWay}"
                        Stretch="Uniform" />
                </StackPanel>

                <!-- Webtoon Continuous Mode View -->
                <ItemsControl
                    x:Name="WebtoonContainer"
                    ItemsSource="{x:Bind ViewModel.WebtoonPages, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsWebtoonMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WebtoonPageItem">
                            <Grid Margin="0,0,0,3" HorizontalAlignment="Center" MinHeight="120">
                                <Image
                                    Source="{x:Bind Image, Mode=OneWay}"
                                    Stretch="Uniform"
                                    MaxWidth="1000"
                                    HorizontalAlignment="Center" />
                                <ProgressRing
                                    IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                    Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="36" Height="36" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- OCR Selectable Text Overlay Card -->
                <Border
                    x:Name="OcrTextOverlayCard"
                    Visibility="{x:Bind ViewModel.IsOcrLayerVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                    MaxWidth="420"
                    MaxHeight="360"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="16,76,20,16"
                    Padding="16"
                    Background="{ThemeResource FloatingPillBackgroundBrush}"
                    BorderBrush="{ThemeResource FloatingPillBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Canvas.ZIndex="50">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C1;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Recognized Page Dialogue" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Width="26" Height="26" Padding="0"
                                Command="{x:Bind ViewModel.ToggleOcrLayerCommand}"
                                ToolTipService.ToolTip="Close OCR Overlay">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <TextBox
                                Text="{x:Bind ViewModel.CurrentPageOcrResult.FullText, Mode=OneWay}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="12" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button
                                Command="{x:Bind ViewModel.CopyCurrentPageTextCommand}"
                                ToolTipService.ToolTip="Copy detected dialogue to clipboard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                    <TextBlock Text="Copy Text" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ==================== EMPTY STATE VIEW ==================== -->
        <Grid
            x:Name="EmptyStateContainer"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasNoComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Border
                Width="540"
                Padding="36,40"
                CornerRadius="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="24" HorizontalAlignment="Center">
                    <!-- App Logo Crest -->
                    <Image
                        Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                        Width="84"
                        Height="84"
                        HorizontalAlignment="Center" />

                    <!-- App Title and Tagline -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock
                            Text="Komik"
                            FontSize="32"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock
                            Text="A modern, distraction-free comic reader for Windows"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </StackPanel>

                    <!-- Open Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.OpenFileCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="40"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                <TextBlock Text="Open Comic..." FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{x:Bind ViewModel.OpenFolderCommand}"
                            Height="40"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xED25;" FontSize="16" />
                                <TextBlock Text="Open Folder..." />
                            </StackPanel>
                        </Button>

                        <Button
                            Click="BackToLibrary_Click"
                            Height="40"
                            Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                                <TextBlock Text="Library" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Drag & Drop Dropzone Box -->
                    <Border
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        Padding="20,16">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE898;"
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="Or drag &amp; drop a CBZ, ZIP, PDF, or folder here"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Supported Format Badges -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text=".CBZ" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text=".ZIP" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text=".PDF" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text="JPEG / PNG / WEBP" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="4" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,3">
                            <TextBlock Text="FOLDERS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== ON-SCREEN HOVER NAV BUTTONS ==================== -->
        <!-- Left Edge Previous Button -->
        <Grid
            x:Name="LeftNavZone"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Width="90"
            Background="Transparent"
            PointerEntered="NavZone_PointerEntered"
            PointerExited="NavZone_PointerExited"
            Tapped="LeftNavZone_Tapped"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Button
                x:Name="PreviousPageButton"
                Style="{StaticResource EdgeNavButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                Opacity="0"
                Click="PreviousPageButton_Click"
                IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                ToolTipService.ToolTip="Turn Page Left (Left Arrow / Click Left 25%)">
                <FontIcon Glyph="&#xE76B;" FontSize="18" />
            </Button>
        </Grid>

        <!-- Right Edge Next Button -->
        <Grid
            x:Name="RightNavZone"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="90"
            Background="Transparent"
            PointerEntered="NavZone_PointerEntered"
            PointerExited="NavZone_PointerExited"
            Tapped="RightNavZone_Tapped"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <Button
                x:Name="NextPageButton"
                Style="{StaticResource EdgeNavButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,16,0"
                Opacity="0"
                Click="NextPageButton_Click"
                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                ToolTipService.ToolTip="Turn Page Right (Right Arrow / Click Right 25%)">
                <FontIcon Glyph="&#xE76C;" FontSize="18" />
            </Button>
        </Grid>

        <!-- ==================== FLOATING TOP TOOLBAR ==================== -->
        <Border
            x:Name="TopToolbar"
            Style="{StaticResource FloatingPillCardStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="12,16,12,0"
            PointerEntered="Toolbar_PointerEntered"
            PointerExited="Toolbar_PointerExited"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <ScrollViewer
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Auto"
                VerticalScrollMode="Disabled">

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Back to Library Button -->
                    <Button
                        Height="32"
                        Padding="8,0"
                        Click="BackToLibrary_Click"
                        ToolTipService.ToolTip="Back to Library (Backspace / Alt+Left)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                            <TextBlock Text="Library" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                    <!-- Open Button with Menu -->
                    <DropDownButton Height="32" Padding="10,0" ToolTipService.ToolTip="Open Comic or Folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                            <TextBlock Text="Open" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Open Comic File... (Ctrl+O)" Command="{x:Bind ViewModel.OpenFileCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open Image Folder... (Ctrl+Shift+O)" Command="{x:Bind ViewModel.OpenFolderCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED25;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Comic Title -->
                    <TextBlock
                        Text="{x:Bind ViewModel.ComicTitle, Mode=OneWay}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        MaxWidth="150"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ComicTitle, Mode=OneWay}" />

                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                <!-- Fit Mode Buttons -->
                <Button
                    Height="32"
                    Width="34"
                    Padding="0"
                    Click="FitHeight_Click"
                    ToolTipService.ToolTip="Fit to Height: Scales comic page vertically to fit screen height (ideal for reading)">
                    <FontIcon Glyph="&#xE740;" FontSize="13" />
                </Button>

                <Button
                    Height="32"
                    Width="34"
                    Padding="0"
                    Click="FitWidth_Click"
                    ToolTipService.ToolTip="Fit to Width: Scales comic page to screen width (great for webtoons and wide screens)">
                    <FontIcon Glyph="&#xE784;" FontSize="13" />
                </Button>

                <Button
                    Height="32"
                    Width="34"
                    Padding="0"
                    Click="FitActual_Click"
                    ToolTipService.ToolTip="Actual Size: Displays 1:1 original scanned image resolution">
                    <FontIcon Glyph="&#xE799;" FontSize="13" />
                </Button>

                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                <!-- Single / Double Page Mode Toggle -->
                <Button
                    Height="32"
                    Padding="10,0"
                    Command="{x:Bind ViewModel.ToggleViewModeCommand}"
                    ToolTipService.ToolTip="Two-Page Spread: Displays adjacent comic pages side-by-side like a physical comic book (D)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontSize="13" />
                        <TextBlock
                            Text="{x:Bind ViewModel.IsDoublePageMode, Mode=OneWay, Converter={StaticResource ViewModeTextConverter}}"
                            FontSize="12" />
                    </StackPanel>
                </Button>

                <!-- Webtoon Continuous Mode Toggle with Info -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button
                        Height="32"
                        Padding="10,0"
                        Command="{x:Bind ViewModel.ToggleWebtoonModeCommand}"
                        ToolTipService.ToolTip="Webtoon Mode: Continuous vertical scroll (V)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="Webtoon" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Webtoon Continuous Scroll Info">
                        <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="270" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Webtoon Continuous Mode" FontWeight="Bold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Text="Reads comics as a continuous vertical strip without page turning. Scroll smoothly using the mouse wheel or Up/Down arrow keys." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Reading Direction Toggle (LTR/RTL) -->
                <Button
                    Height="32"
                    Padding="8,0"
                    Command="{x:Bind ViewModel.ToggleReadingDirectionCommand}"
                    ToolTipService.ToolTip="Reading Direction: Switch between Western (Left-to-Right) and Japanese Manga (Right-to-Left, inverting page turns) (Ctrl+R)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8AB;" FontSize="11" />
                        <TextBlock Text="{x:Bind ViewModel.ReadingDirectionDisplay, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                <!-- Offline Local OCR & Search Dropdown Button -->
                <DropDownButton
                    x:Name="OcrDropDownButton"
                    Height="32"
                    Padding="8,0"
                    ToolTipService.ToolTip="Offline OCR &amp; Dialogue Search (Windows Native)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C1;" FontSize="13" />
                        <TextBlock Text="OCR" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="310" Spacing="10" Padding="4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Comic OCR (Local Offline)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                        <Button
                                            Style="{StaticResource InfoButtonStyle}"
                                            ToolTipService.ToolTip="OCR Info">
                                            <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Width="260" Spacing="8">
                                                        <TextBlock Text="Offline On-Device OCR" FontWeight="Bold" FontSize="13" />
                                                        <TextBlock Text="100% private, offline speech bubble detection using Windows OCR. Copy detected dialogue or search keywords across all comic pages." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Detect Current Page Text -->
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ToggleOcrLayerCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                                    ToolTipService.ToolTip="Recognize dialogue and text on current page">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8C1;" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.IsOcrLayerVisible, Mode=OneWay, Converter={StaticResource OcrButtonTextConverter}}" />
                                    </StackPanel>
                                </Button>

                                <ProgressBar
                                    IsIndeterminate="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsOcrLoading, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                                <!-- Search Dialogue in Comic -->
                                <TextBlock Text="Search Dialogue in Comic" FontWeight="SemiBold" FontSize="12" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="OcrSearchBox"
                                        Grid.Column="0"
                                        PlaceholderText="Search dialogue or text..."
                                        Text="{x:Bind ViewModel.OcrSearchQuery, Mode=TwoWay}"
                                        KeyDown="OcrSearchBox_KeyDown" />
                                    <Button
                                        Grid.Column="1"
                                        Content="Search"
                                        Click="OcrSearch_Click" />
                                </Grid>

                                <ProgressBar
                                    IsIndeterminate="{x:Bind ViewModel.IsSearchingOcr, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsSearchingOcr, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Search Results -->
                                <ListView
                                    ItemsSource="{x:Bind ViewModel.OcrSearchResults, Mode=OneWay}"
                                    MaxHeight="160"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:OcrSearchResultItem">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,3"
                                                Click="OcrSearchResult_Click"
                                                Tag="{x:Bind}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind PageDisplay}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="{x:Bind Snippet}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                <!-- Bookmark Current Page Button -->
                <Button
                    Height="32"
                    Width="34"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleBookmarkCurrentPageCommand}"
                    ToolTipService.ToolTip="Bookmark Page (Ctrl+D / Ctrl+B)">
                    <FontIcon Glyph="{x:Bind ViewModel.BookmarkGlyph, Mode=OneWay}" FontSize="13" Foreground="#F59E0B" />
                </Button>

                <!-- Bookmarks List Dropdown Flyout -->
                <DropDownButton Height="32" Width="34" Padding="0" ToolTipService.ToolTip="View Bookmarks">
                    <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="280" Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Bookmarks" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                        <Button
                                            Style="{StaticResource InfoButtonStyle}"
                                            ToolTipService.ToolTip="Save favorite panels and scenes with notes to quickly jump back to them at any time.">
                                            <FontIcon
                                                Glyph="&#xE946;"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <Button
                                        HorizontalAlignment="Right"
                                        Height="28"
                                        Padding="8,0"
                                        Click="AddBookmarkNote_Click"
                                        ToolTipService.ToolTip="Add Bookmark with Note">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                            <TextBlock Text="Note" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ListView
                                    ItemsSource="{x:Bind ViewModel.Bookmarks}"
                                    SelectionMode="None"
                                    MaxHeight="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookmarkEntity">
                                            <Grid Padding="4,2" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="4,2"
                                                    Click="JumpToBookmark_Click"
                                                    Tag="{x:Bind}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="{x:Bind DisplaySubtitle}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Grid.Column="1"
                                                    Width="26"
                                                    Height="26"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="DeleteBookmark_Click"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Remove Bookmark">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Color Correction & Night Mode Flyout -->
                <DropDownButton Height="32" Width="34" Padding="0" ToolTipService.ToolTip="Color Correction &amp; Night Mode">
                    <FontIcon Glyph="&#xE790;" FontSize="13" />
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="260" Spacing="12" Padding="4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Display &amp; Colors" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                        <Button
                                            Style="{StaticResource InfoButtonStyle}"
                                            ToolTipService.ToolTip="Non-destructive GPU display shaders. Adjust brightness, contrast, and paper warmth without modifying original comic files.">
                                            <FontIcon
                                                Glyph="&#xE946;"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <Button
                                        HorizontalAlignment="Right"
                                        Height="26"
                                        Padding="6,0"
                                        Click="ResetColorSettings_Click"
                                        ToolTipService.ToolTip="Reset all adjustments">
                                        <TextBlock Text="Reset" FontSize="11" />
                                    </Button>
                                </Grid>

                                <!-- Reading Theme Presets -->
                                <TextBlock Text="Reading Theme Presets" FontWeight="SemiBold" FontSize="12" />
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Content="Original" HorizontalAlignment="Stretch" Padding="2,4" FontSize="11" Click="PresetOriginal_Click" />
                                    <Button Grid.Row="0" Grid.Column="1" Content="Night" HorizontalAlignment="Stretch" Padding="2,4" FontSize="11" Click="PresetNight_Click" />
                                    <Button Grid.Row="0" Grid.Column="2" Content="Sepia" HorizontalAlignment="Stretch" Padding="2,4" FontSize="11" Click="PresetSepia_Click" />
                                    <Button Grid.Row="1" Grid.Column="0" Content="Contrast" HorizontalAlignment="Stretch" Padding="2,4" FontSize="11" Click="PresetHighContrast_Click" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="Grayscale" HorizontalAlignment="Stretch" Padding="2,4" FontSize="11" Click="PresetGrayscale_Click" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="Invert" HorizontalAlignment="Stretch" Padding="2,4" FontSize="11" Click="PresetInverted_Click" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                                <!-- Brightness Slider -->
                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock Text="Brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ColorSettings.Brightness, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" Opacity="0.8" />
                                    </Grid>
                                    <Slider
                                        Minimum="-80"
                                        Maximum="80"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.ColorSettings.Brightness, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Contrast Slider -->
                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock Text="Contrast" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ColorSettings.Contrast, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" Opacity="0.8" />
                                    </Grid>
                                    <Slider
                                        Minimum="0.6"
                                        Maximum="1.8"
                                        StepFrequency="0.05"
                                        Value="{x:Bind ViewModel.ColorSettings.Contrast, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Warmth / De-yellowing Slider -->
                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock Text="Warmth (De-yellowing)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ColorSettings.Warmth, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" Opacity="0.8" />
                                    </Grid>
                                    <Slider
                                        Minimum="-80"
                                        Maximum="80"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.ColorSettings.Warmth, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                <!-- Zoom Controls -->
                <Button
                    Height="32"
                    Width="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.ZoomOutCommand}"
                    ToolTipService.ToolTip="Zoom Out (Ctrl -)">
                    <FontIcon Glyph="&#xE738;" FontSize="12" />
                </Button>

                <Button
                    Height="32"
                    Padding="8,0"
                    Command="{x:Bind ViewModel.ResetZoomCommand}"
                    ToolTipService.ToolTip="Reset Zoom (Ctrl 0)">
                    <TextBlock Text="{x:Bind ViewModel.ZoomDisplayString, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                </Button>

                <Button
                    Height="32"
                    Width="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.ZoomInCommand}"
                    ToolTipService.ToolTip="Zoom In (Ctrl +)">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                </Button>

                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                <!-- Theme Toggle -->
                <Button
                    Height="32"
                    Width="34"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleThemeCommand}"
                    ToolTipService.ToolTip="Toggle Dark / Light Theme">
                    <FontIcon Glyph="&#xE708;" FontSize="13" />
                </Button>

                <!-- Fullscreen Toggle -->
                <Button
                    Height="32"
                    Width="34"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleFullscreenCommand}"
                    ToolTipService.ToolTip="Toggle Fullscreen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="13" />
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Border>

        <!-- ==================== FLOATING BOTTOM PAGE OVERLAY & SCRUBBER ==================== -->
        <Border
            x:Name="BottomOverlay"
            Style="{StaticResource FloatingPillCardStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24"
            PointerEntered="Toolbar_PointerEntered"
            PointerExited="Toolbar_PointerExited"
            Visibility="{x:Bind ViewModel.HasComic, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Jump First -->
                <Button
                    Height="28"
                    Width="28"
                    Padding="0"
                    Command="{x:Bind ViewModel.FirstPageCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                    ToolTipService.ToolTip="First Page (Home)">
                    <FontIcon Glyph="&#xEB9D;" FontSize="11" />
                </Button>

                <!-- Previous Page -->
                <Button
                    Height="28"
                    Width="28"
                    Padding="0"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                    ToolTipService.ToolTip="Previous Page (Left Arrow)">
                    <FontIcon Glyph="&#xE76B;" FontSize="11" />
                </Button>

                <!-- Page Scrubber Slider -->
                <Slider
                    x:Name="PageScrubber"
                    Width="240"
                    Minimum="1"
                    Maximum="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
                    Value="{x:Bind ViewModel.CurrentPageNumber, Mode=OneWay}"
                    ValueChanged="PageScrubber_ValueChanged"
                    VerticalAlignment="Center"
                    Margin="4,0"
                    ToolTipService.ToolTip="Scrub Pages" />

                <!-- Page Counter Label (e.g. 12 / 87) -->
                <TextBlock
                    Text="{x:Bind ViewModel.PageDisplayString, Mode=OneWay}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    MinWidth="60"
                    TextAlignment="Center" />

                <!-- Next Page -->
                <Button
                    Height="28"
                    Width="28"
                    Padding="0"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    ToolTipService.ToolTip="Next Page (Right Arrow / Space)">
                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                </Button>

                <!-- Jump Last -->
                <Button
                    Height="28"
                    Width="28"
                    Padding="0"
                    Command="{x:Bind ViewModel.LastPageCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    ToolTipService.ToolTip="Last Page (End)">
                    <FontIcon Glyph="&#xEB9E;" FontSize="11" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== NOTIFICATION / RESUME TOAST ==================== -->
        <Border
            x:Name="NotificationToastCard"
            Visibility="{x:Bind ViewModel.IsToastVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,68,0,0"
            CornerRadius="20"
            Background="#E61A1C20"
            BorderBrush="#99FFFFFF"
            BorderThickness="1.5"
            Padding="18,8"
            Canvas.ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    Text="{x:Bind ViewModel.ToastMessage, Mode=OneWay}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="12" />
            </StackPanel>
        </Border>

        <!-- ==================== ERROR INFO BAR ==================== -->
        <InfoBar
            x:Name="ErrorInfoBar"
            IsOpen="{x:Bind ViewModel.IsError, Mode=TwoWay}"
            Severity="Error"
            Title="Error Opening Comic"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsClosable="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,70,0,0"
            MaxWidth="600"
            CloseButtonClick="ErrorInfoBar_CloseButtonClick" />

        <!-- ==================== LOADING PROGRESS RING ==================== -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
